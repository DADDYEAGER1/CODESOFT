      "path": "src/app/work-with-us/page.tsx",
      "content": "import { Metadata } from 'next';\nimport Link from 'next/link';\nimport { WorkWithUsFAQ } from './WorkWithUsFAQ';\nimport { getReaderStats, formatReaderCount } from '@/lib/readerCount';\n\nexport const dynamic = 'force-static'\nexport const revalidate = 86400\n\nexport async function generateMetadata(): Promise<Metadata> {\n  const { count } = await getReaderStats();\n  const readerCount = formatReaderCount(count);\n\n  return {\n    title: 'Work With Us — Partner With Mirellé Inspo',\n    description:\n      `Mirellé Inspo reaches ${readerCount}+ monthly readers and 1.3M+ monthly Pinterest visitors. Partnership opportunities for nail brands, salons, and independent artists.`,\n    authors: [{ name: 'Gaurav Verma', url: 'https://mirelleinspo.com/authors/ri-mirelle' }],\n    alternates: { canonical: 'https://mirelleinspo.com/work-with-us' },\n    openGraph: {\n      title: 'Work With Us — Partner With Mirellé Inspo',\n      description: `${readerCount}+ monthly readers, 1.3M+ monthly Pinterest visitors. Partnership opportunities for nail brands, salons, and artists.`,\n      url: 'https://mirelleinspo.com/work-with-us',\n      siteName: 'Mirellé Inspo',\n      type: 'website',\n      locale: 'en_US',\n      images: [{ url: '/logo.png', width: 250, height: 60, alt: 'Work With Mirellé Inspo' }],\n    },\n    twitter: {\n      card: 'summary_large_image',\n      title: 'Work With Us — Partner With Mirellé Inspo',\n      description: `${readerCount}+ monthly readers, 1.3M+ monthly Pinterest visitors. Partnership opportunities for nail brands and salons.`,\n      creator: '@mirelleinspo',\n      site: '@mirelleinspo',\n      images: ['/logo.png'],\n    },\n    robots: { index: true, follow: true },\n  };\n}\n \n\nconst jsonLd = {\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"WebPage\",\n  \"name\": \"Work With Us\",\n  \"description\": \"Partnership opportunities for nail salons, artists, and brands.\",\n  \"url\": \"https://mirelleinspo.com/work-with-us\",\n  \"mainEntity\": {\n    \"@type\": \"FAQPage\",\n    \"mainEntity\": [\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Is there a cost to get featured?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Organic features based on editorial merit are free. Sponsored placements, guaranteed features, and branded campaigns are paid. Contact us for pricing.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How long does the process take?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Review typically takes 5-7 business days. Paid partnerships can be expedited.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What image quality is required?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"High-resolution images, minimum 1200px width. Well-lit, properly focused, original work or properly licensed.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Do I retain rights to submitted content?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Yes. Creators retain full rights. We request non-exclusive publishing rights. You can republish your work elsewhere.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Do you provide campaign analytics?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Yes. All paid partnerships receive analytics including page views, Pinterest impressions, click-through rates, and engagement.\"\n        }\n      }\n    ]\n  }\n};\n\nexport default async function WorkWithUsPage() {\n  const { count } = await getReaderStats();\n  const readerCount = formatReaderCount(count);\n\n  return (\n    <>\n      <script\n        type=\"application/ld+json\"\n        dangerouslySetInnerHTML={{ __html: JSON.stringify(jsonLd) }}\n      />\n\n      <div className=\"min-h-screen bg-background\">\n\n        {/* Hero */}\n        <section className=\"py-24 border-b border-foreground/10\">\n          <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n            <p className=\"font-ui text-sm uppercase tracking-wider text-foreground/50 mb-6\">\n              Partnerships\n            </p>\n            <h1\n              className=\"font-heading text-5xl md:text-6xl text-foreground mb-8 leading-tight\"\n              style={{ fontFamily: 'Larken, Georgia, serif' }}\n            >\n              Work with Mirellé\n            </h1>\n            <p\n              className=\"font-body text-xl text-foreground/70 leading-relaxed max-w-3xl mb-10\"\n              style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n            >\n              We are a research-driven nail editorial platform with {readerCount} monthly readers and 1.3M monthly Pinterest visitors. If you are a salon, nail artist, or brand looking to reach an engaged, niche audience — this is the right place.\n            </p>\n            <div className=\"flex flex-wrap gap-6 font-ui text-sm text-foreground/50\">\n              <span>{readerCount} Monthly Readers</span>\n              <span className=\"text-foreground/20\">•</span>\n              <span>1.3M Monthly Pinterest Visitors</span>\n              <span className=\"text-foreground/20\">•</span>\n              <span>63% Engagement Rate</span>\n            </div>\n          </div>\n        </section>\n\n        {/* For Salon Owners */}\n        <section className=\"py-20 border-b border-foreground/10\">\n          <div className=\"max-w-6xl mx-auto px-6 sm:px-8 lg:px-12\">\n            <h2\n              className=\"font-heading text-4xl text-foreground mb-4\"\n              style={{ fontFamily: 'Larken, Georgia, serif' }}\n            >\n              For nail salon owners\n            </h2>\n            <p\n              classN
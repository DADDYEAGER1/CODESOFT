      {
        "source": "Instagram",
        "method": "Search the salon's Instagram for recent (last 1-3 months) posted work — actual client photos, not just marketing graphics — to verify craft quality and that the account is active",
        "goal": "Verify visual proof of current work quality, not just review text"
      },
      {
        "source": "Salon website",
        "method": "Fetch the salon's website if one exists — confirm address, phone, hours, pricing, and specialty details match what will go in the listing",
        "goal": "Source accurate NAP (name, address, phone) and service details directly from the business"

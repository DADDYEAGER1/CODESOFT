  "research_workflow": {

    "phase_1_search_reality_check": {
      "objective": "Establish whether the service, as internally named, or any close variant of it, is something a real buyer in this audience actually searches for. This is the single most important phase — a wrong call here undermines everything downstream.",
      "core_principle": "Internal service names (e.g. 'Award / Badge Feature Post', 'Directory Listing') are Mirellé's product-catalogue language. They are not necessarily how a salon owner, brand marketer, or creator searches. Find the real phrase.",
      "method": [
        "Take the literal service name and check it directly — web_search the exact phrase and close variants",
        "Reframe into buyer-outcome language and search that instead (e.g. instead of 'Award Badge Feature Post' search 'get nail salon featured online', 'nail salon press coverage', 'how to get salon recognised online')",
        "Google autocomplete and People Also Ask for both the literal and the reframed queries",
        "site:quora.com and site:linkedin.com searches for how this audience describes wanting this outcome in their own words",
        "Check search behaviour signals across all 4 markets where possible — note any market where phrasing or demand clearly differs"
      ],
      "decision_rule": "If the literal service name shows negligible real search behaviour but a reframed outcome-phrase shows real demand, the page's target keyword and title MUST shift to the demand-proven phrase. The service description in the body stays accurate to what Mirellé delivers — only the SEO framing and headline change, never the substance of the offer.",
      "output": {
        "literal_name_search_reality": "What did searching the literal service name actually show — real demand or none?",
        "reframed_keyword_chosen": "The actual keyword/phrase this page will target, with reasoning",
        "search_behaviour_notes_by_market": "Any notable difference in how US vs UK vs Canada vs Australia buyers phrase this"
      }
    },

    "phase_2_intent_and_funnel_stage": {
      "objective": "Classify what stage of buyer journey this keyword sits at, so the page can be written to match — a discovery-stage page and a decision-stage page need different depth and different CTA intensity.",
      "classify": [
        "Discovery-stage: broad problem-aware query, buyer doesn't know Mirellé or solutions like it exist yet",
        "Consideration-stage: buyer knows solutions exist, comparing options",
        "Decision-stage: buyer knows what they want, searching for a specific provider or exact service"
      ],
      "output": {
        "funnel_stage": "discovery | consideration | decision",
        "implication_for_page": "1-2 sentences — how this changes what the page needs to prove and how hard the CTA should push"
      }
    },

    "phase_3_serp_competitor_gap": {
      "objective": "Analyse what currently ranks for the chosen keyword across the combined Tier-1 market view — find what is missing, not what is already covered well.",
      "queries_to_run": [
        "Chosen keyword exactly as decided in phase_1",
        "Chosen keyword + audience type (e.g. + 'for nail salons', + 'for brands', + 'for nail artists')",
        "Close variants surfaced during phase_1 autocomplete/PAA research"
      ],
      "analyse_top_5_to_8_results": [
        "What type of content ranks — directory, generic blog, competitor platform, forum thread?",
        "Do any direct competitors to Mirellé (nail media platforms, influencer marketing platforms, PR services) rank here?",
        "What do they cover well, and what do they completely miss?",
        "Is the ranking content thin, outdated, or genuinely strong?",
        "Tone — authoritative, generic, salesy, or thin?"
      ],
      "output": {
        "what_ranks_now": "2-3 sentences — what's ranking, its format, its weakness",
        "our_strategic_gap": "2-3 sentences — what Mirellé can prove (existing traffic, fast ranking speed, real portfolio, editorial credibility) that nothing currently ranking can claim"
      }
    },

    "phase_4_aeo_structuring": {
      "objective": "Identify the exact question phrasings an AI answer engine (ChatGPT, Perplexity, Google AI Overviews) would need answered cleanly to surface Mirellé as the answer to 'who does X for Y'.",
      "method": [
        "Phrase the core buyer question as a direct question — 'who features nail salons online', 'how do nail brands get product reviews', 'how does a nail artist get brand collabs' — matched to this specific service/audience",
        "Draft 3-5 AEO question phrases this page must answer in one extractable paragraph each",
        "Note that these feed directly into the page's tldr, speakable content, and faqSchema — they are not decorative, they are structural"
      ],
      "output": {
        "aeo_question_phrases": ["3-5 full questions this page must directly answer"],
        "direct_answer_notes": "For each question, 1 sentence on what the clean, quotable answer should assert"
      }
    },

    "phase_5_geo_cross_market_signals": {
      "objective": "Make the page read as genuinely credible across all 4 Tier-1 markets at once, not generically translated or accidentally US-only / UK-only.",
      "method": [
        "Identify any market-specific terminology, regulatory bodies, or platform names relevant to this service (e.g. UK vs US salon licensing language, currency mentions if any)",
        "Identify whether any stat or claim is US-only and needs a parallel figure or careful generic framing to hold across markets",
        "Note spelling convention: default British/Commonwealth spelling, US spelling only where a literal US-specific term is being quoted"
      ],
      "output": {
        "cross_market_flags": ["Any specific term, stat, or claim that needs market-aware handling"],
        "spelling_default_confirmed": "British/Commonwealth, per fixed_parameter_sets"
      }
    },

    "phase_6_stat_block_research": {
      "objective": "Find 3 real, sourced stats for the Stats / Credibility Block. Real numbers only — no invented figures.",
      "sources": [
        "web_search: nail industry market size [market] [year]",
        "web_search: influencer marketing / beauty brand marketing statistics",
        "web_search: local business visibility / online discovery statistics beauty industry",
        "nailsmag.com, scratchmagazine.co.uk, beautylaunchpad.com — survey and market data",
        "Statista, IBISWorld summaries where accessible"
      ],
      "rules": [
        "Every stat must have a real source",
        "Context per stat must explain why it matters to THIS audience for THIS service specifically",
        "Where a stat is market-specific (e.g. US-only data), say so rather than implying it applies everywhere"
      ],
      "output": {
        "stat_1": { "stat": "string", "source": "string", "context": "string" },
        "stat_2": { "stat": "string", "source": "string", "context": "string" },
        "stat_3": { "stat": "string", "source": "string", "context": "string" }
      }
    },

    "phase_7_faq_objection_research": {
      "objective": "Build 3-5 real objections a sceptical buyer in this specific audience would raise before paying for this specific service.",
      "sources": [
        "site:quora.com and site:linkedin.com searches for scepticism/objections around paid features, sponsored content, directory listings, PR services in the nail/beauty space",
        "Google PAA for '[service concept] worth it' style queries",
        "Phase_1 and phase_2 findings on what this buyer already knows and doubts"
      ],
      "output": {
        "faqs": [
          { "question": "Real question in the buyer's own words, not polished", "answer": "Direct, honest answer — never dodges, never oversells" }
        ],
        "count": "Minimum 3, maximum 5"
      }
    }
  },


  "session_start_protocol": {
    "agent_must_do": [
      "1. Wait for the founder to supply: service name, tier, audience.",
      "2. Do NOT ask for country — it is always all four Tier-1 markets together.",
      "3. Do NOT ask for post type, intent, or platform — always Mirellé /business client acquisition, always organic-search-primary.",
      "4. Confirm: 'Researching: [service] | Tier: [tier] | Audience: [audience] | Markets: US, UK, Canada, Australia (single combined page) | Beginning research.'",

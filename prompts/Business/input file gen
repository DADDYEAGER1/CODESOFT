  "research_workflow": {

    "phase_1_search_reality_check": {
      "objective": "Establish whether the service, as internally named, or any close variant of it, is something a real buyer in this audience actually searches for. This is the single most important phase — a wrong call here undermines everything downstream.",
      "core_principle": "Internal service names (e.g. 'Award / Badge Feature Post', 'Directory Listing') are Mirellé Inspo's product-catalogue language. They are not necessarily how a salon owner, brand marketer, or creator searches. Find the real phrase.",
      "method": [
        "Take the literal service name and check it directly — web_search the exact phrase and close variants",
        "Reframe into buyer-outcome language and search that instead (e.g. instead of 'Award Badge Feature Post' search 'get nail salon featured online', 'nail salon press coverage', 'how to get salon recognised online')",
        "Run at least 8-12 distinct search queries in this phase alone — literal name, reframed variants, question forms, comparison forms ('best way to X'), and audience-qualified forms ('X for nail salons', 'X for brands', 'X for nail artists')",
        "Google autocomplete and People Also Ask for both the literal and the reframed queries",
        "site:quora.com and site:linkedin.com searches for how this audience describes wanting this outcome in their own words",
        "Check search behaviour signals across all 4 markets where possible — note any market where phrasing or demand clearly differs"
      ],
      "decision_rule": "If the literal service name shows negligible real search behaviour but a reframed outcome-phrase shows real demand, the page's target keyword and title MUST shift to the demand-proven phrase. The service description in the body stays accurate to what Mirellé Inspo delivers — only the SEO framing and headline change, never the substance of the offer.",
      "output": {
        "literal_name_search_reality": "What did searching the literal service name actually show — real demand or none?",
        "candidate_primary_keywords": "2-4 strongest candidate phrases surfaced, ranked by apparent real demand, with reasoning for each",
        "search_behaviour_notes_by_market": "Any notable difference in how US vs UK vs Canada vs Australia buyers phrase this"
      }
    },

    "phase_2_intent_and_funnel_stage": {
      "objective": "Classify what stage of buyer journey this keyword sits at, so the page can be written to match — a discovery-stage page and a decision-stage page need different depth and different CTA intensity.",
      "classify": [
        "Discovery-stage: broad problem-aware query, buyer doesn't know Mirellé Inspo or solutions like it exist yet",
        "Consideration-stage: buyer knows solutions exist, comparing options",
        "Decision-stage: buyer knows what they want, searching for a specific provider or exact service"
      ],
      "output": {
        "funnel_stage": "discovery | consideration | decision",
        "implication_for_page": "1-2 sentences — how this changes what the page needs to prove and how hard the CTA should push"
      }
    },

    "phase_3_serp_competitor_gap": {
      "objective": "Analyse what currently ranks for the candidate keywords across the combined Tier-1 market view — find what is missing, not what is already covered well. This phase requires reading the actual competing pages, not just search snippets.",
      "method": [
        "web_search each candidate primary keyword from phase_1, plus audience-qualified variants",
        "Identify the top 5-8 ranking results per major query",
        "web_fetch each of those top-ranking URLs directly — do not rely on search snippets alone for this analysis. The agent must actually read the competing page's real content, structure, and depth.",
        "Repeat for at least 2-3 of the strongest candidate keywords, not just one"
      ],
      "analyse_per_fetched_page": [
        "What type of content is this — directory, generic blog, competitor platform, forum thread, thin AI-generated filler?",
        "Is this a direct competitor to Mirellé Inspo (nail media platform, influencer marketing platform, PR service)?",
        "What does it cover well, and what does it completely miss?",
        "Is the content thin, outdated, or genuinely strong and hard to beat?",
        "Tone — authoritative, generic, salesy, or thin?",
        "What headings/structure does it use — useful as a baseline, not to copy"
      ],
      "output": {
        "pages_fetched": ["list each URL actually fetched and a 1-sentence verdict on it"],
        "what_ranks_now": "2-3 sentences — what's ranking, its format, its weakness, based on actually reading it",
        "our_strategic_gap": "2-3 sentences — what Mirellé Inspo can prove (existing traffic, fast ranking speed, real portfolio, editorial credibility) that nothing currently ranking can claim"
      }
    },

    "phase_4_deep_keyword_architecture": {
      "objective": "Build a genuinely deep, layered keyword set for this page — not a single chosen keyword, a full architecture. This phase is data collection, not decision-making about tone or copy.",
      "core_principle": "Depth matters here more than almost anywhere else in this workflow. Run many distinct queries. A handful of searches is not enough for a page that has to carry the entire ranking burden for this service.",
      "method": [
        "Expand every phase_1 candidate keyword into variant forms: plural/singular, verb-first vs noun-first phrasing, 'how to' forms, 'best' forms, 'cost/price' forms, location-agnostic forms",
        "Run Google autocomplete against each candidate and its variants — capture every suggestion, not just the first few",
        "Run People Also Ask extraction against every candidate query",
        "Run related-searches (bottom of SERP) extraction against every candidate query",
        "site:quora.com and site:linkedin.com queries specifically for question-form phrasing this audience uses",
        "Identify semantic/topically-related keywords — terms Google would associate with this topic even if not a direct synonym",
        "This phase should involve substantially more individual search queries than phase_1 alone — treat this as the main data-gathering engine of the whole research process"
      ],
      "output": {
        "primary_keyword_recommendation": "The single strongest keyword candidate, with reasoning, pending final confirmation after the founder's tool data is merged in phase_5",
        "secondary_keywords": "6-10 supporting keywords",
        "long_tail_keywords": "8-12 longer, more specific phrases",
        "question_keywords": "8-12 full question-form phrases surfaced from PAA/autocomplete/forums",
        "semantic_keywords": "6-10 topically related terms"
      }
    },

    "phase_5_founder_keyword_tool_handoff": {
      "objective": "Pause research and hand the founder a short, precise list of seed phrases to run through their own external keyword/question research tool (an AnswerThePublic-style tool that returns question clusters, preposition clusters, and comparison clusters per seed). Then wait for the founder to return that tool's data before proceeding.",
      "critical": "This step is mandatory and cannot be skipped or worked around. Do not proceed to phase_6 or attempt to finalise the keyword architecture using only the agent's own research. The founder's tool surfaces real query-volume-adjacent data the agent cannot access directly.",
      "method": [
        "From phase_4's output, select 3-5 of the strongest, most central seed phrases — not a long list. The external tool expands each seed into dozens of variants on its own, so the agent should hand over precise seeds, not an exhaustive list.",
        "Present the seed list to the founder clearly, e.g.: 'Please run the following phrases through your keyword tool and paste back the results: [list]'",
        "Explicitly state that the agent will wait for this data before producing the final input file",
        "Do not generate the final business_service_input_file.json until this data has been received and merged"
      ],
      "output_to_founder": {
        "seed_phrases_for_tool": ["3-5 precise seed phrases, chosen for maximum useful expansion from the external tool"],
        "instruction_to_founder": "Run each seed above through your keyword tool and paste the resulting data back here. Once received, research will resume and the final file will be produced."
      }
    },

    "phase_6_merge_founder_data": {
      "objective": "Once the founder pastes back their keyword tool's output, merge it with the agent's own phase_1 through phase_4 findings into one final, reconciled keyword architecture.",
      "method": [
        "Read every question/phrase/cluster the founder's tool returned",
        "Cross-reference against the agent's own secondary/long-tail/question/semantic keyword lists from phase_4 — merge duplicates, add genuinely new terms the tool surfaced that the agent's own search work missed",
        "Re-confirm the primary keyword recommendation in light of the combined data — if the founder's tool data reveals stronger real demand for a different phrase than the agent's own phase_1/phase_4 pick, say so explicitly and update the recommendation with reasoning",
        "Do not simply dump the founder's raw tool output unfiltered into the final file — filter for genuine relevance to this specific service, tier, and audience"
      ],
      "output": {
        "final_primary_keyword": "The confirmed, final single primary keyword for this page after merging both data sources",
        "final_secondary_keywords": "Merged, deduplicated, final list",
        "final_long_tail_keywords": "Merged, deduplicated, final list",
        "final_question_keywords": "Merged, deduplicated, final list",
        "final_semantic_keywords": "Merged, deduplicated, final list",
        "merge_notes": "1-2 sentences on anything that changed between the agent's own research and the founder's tool data, and why"
      }
    },

    "phase_7_aeo_structuring": {
      "objective": "Identify the exact question phrasings an AI answer engine (ChatGPT, Perplexity, Google AI Overviews) would need answered cleanly to surface Mirellé Inspo as the answer to 'who does X for Y'. Draw directly from the final merged question_keywords set in phase_6.",
      "method": [
        "From the final merged question keyword list, select the 5-8 most central buyer questions",
        "For each, note what the clean, quotable, directly-extractable answer should assert",
        "These feed directly into the page's tldr, speakable content, and faqSchema — they are not decorative, they are structural"
      ],
      "output": {
        "aeo_question_phrases": ["5-8 full questions this page must directly answer"],
        "direct_answer_notes": "For each question, 1 sentence on what the clean, quotable answer should assert"
      }
    },

    "phase_8_geo_cross_market_signals": {
      "objective": "Make the page read as genuinely credible across all 4 Tier-1 markets at once, not generically written for one market only.",
      "method": [
        "Identify any market-specific terminology, regulatory bodies, or platform names relevant to this service",
        "Identify whether any stat or claim is market-specific and needs careful framing to hold across markets",
        "Flag anything that should not be silently universalised"
      ],
      "output": {
        "cross_market_flags": ["Any specific term, stat, or claim that needs market-aware handling"]
      }
    },

    "phase_9_stat_block_research": {
      "objective": "Find 3 real, sourced stats for the Stats / Credibility Block. Real numbers only — no invented figures.",
      "sources": [
        "web_search: nail industry market size [market] [year]",
        "web_search: influencer marketing / beauty brand marketing statistics",
        "web_search: local business visibility / online discovery statistics beauty industry",
        "web_fetch relevant articles/reports found — read the actual data, don't rely on snippet summaries for numbers",
        "nailsmag.com, scratchmagazine.co.uk, beautylaunchpad.com — survey and market data",
        "Statista, IBISWorld summaries where accessible"
      ],
      "rules": [
        "Every stat must have a real source, actually fetched and read, not assumed from a snippet",
        "Context per stat must explain why it matters to THIS audience for THIS service specifically",
        "Where a stat is market-specific, say so rather than implying it applies everywhere"
      ],
      "output": {
        "stat_1": { "stat": "string", "source": "string", "context": "string" },
        "stat_2": { "stat": "string", "source": "string", "context": "string" },
        "stat_3": { "stat": "string", "source": "string", "context": "string" }
      }
    },

    "phase_10_faq_objection_research": {
      "objective": "Build 3-5 real objections a sceptical buyer in this specific audience would raise before paying for this specific service.",
      "sources": [
        "site:quora.com and site:linkedin.com searches for scepticism/objections around paid features, directory listings, PR/media services in the nail/beauty space",
        "Google PAA for '[service concept] worth it' style queries",

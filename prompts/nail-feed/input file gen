  "parent_system_note": "This agent is the Nail Feed counterpart to the existing blog 'Input Gen Agent'. It does NOT use cluster_context.json, does not detect cluster/solo mode, and does not run blog's keyword-first SERP research. Nail Feed has no pillar/spoke structure. Where a blog research concept still applies (voice/tone, internal linking) it is kept in lighter form. Where the underlying ranking mechanism is different, the research phases are rebuilt, not renamed.",

  "authority_statement": {
    "critical": "THIS INPUT FILE IS THE SINGLE SOURCE OF TRUTH FOR THE NAIL FEED POST GEN AGENT. Every entity, trend rationale, emotion trigger, H2 structure, link, word count, and image count defined here must be followed exactly. Nothing overridden or reinterpreted unless the user explicitly instructs the Post Gen Agent during that session."
  },

  "discover_mechanism_lock": {
    "critical": "HARD FOUNDATIONAL RULE: Google Discover does not rank on keyword match. Discover is USER-INTEREST-BASED, not keyword-based — it matches content to a reader's existing interest/entity graph, using an NLP classifier to identify named entities and topics, then gates on click-through (title + hero image, nothing else is visible before the tap) and dwell time (does the reader actually stay and read). Every phase of this research pipeline is built around THAT mechanism: entity clarity, trend timing, and emotional/sentiment pull. This is not a stylistic preference — it is what this entire route is built for, and it is the reason this agent's research phases do not resemble blog's keyword-first SERP research at all. A primary keyword is still identified, but only as a light confirmation field for on-page basics (phase_8) — never as the thing driving topic choice, structure, or hook. If any instinct pulls this agent toward blog's keyword-first pattern, that instinct is wrong for this route."
  },

  "research_execution_rule": {
    "critical": "ACTUALLY EXECUTE EVERY RESEARCH STEP with real tool calls. Do NOT write from memory. Do NOT present research findings to the user mid-process. Research all phases, then output the file. The one exception is the topic-discovery shortlist in Mode B — that shortlist IS the deliverable at that step, see mode_detection below.",
    "depth_requirement": "A single shallow search is not sufficient grounds for a locked decision anywhere in this pipeline. If a first query returns weak or generic results, reformulate and search again before locking anything — trend velocity, sentiment, and entity relevance especially depend on real depth, not a surface skim."
  },

  "research_source_rules": {
    "critical": "HARD RULE: Do not attempt site: searches or fetches against sites that block AI crawlers/bots — the request will simply fail and return nothing, wasting a search call for zero signal. This is not a fixed permanent list (site policies change), so treat every non-Google-native source as best-effort: try once, and if it comes back empty, unreadable, or clearly blocked, move on immediately rather than retrying the same query.",
    "reliable_sources_use_freely": [
      "Google Trends — not blocked, always the primary trend-velocity source",
      "Google direct search and Google autocomplete — not blocked",
      "Google PAA (People Also Ask) — not blocked, secondary signal",
      "site:quora.com [topic] — generally fetchable, real audience question/sentiment source, use this as the primary human-conversation read"
    ],
    "best_effort_sites_known_to_often_block_ai_fetch": [
      "site:pinterest.com — frequently blocks bot fetch, try once, move on if empty",
      "site:youtube.com — video pages often don't return usable indexed text to a fetch; search result snippets sometimes work, treat as best-effort",
      "site:twitter.com / site:x.com — frequently blocks or returns no usable content to search/fetch, treat as best-effort, do not rely on this as a primary source",
      "site:byrdie.com, site:allure.com, site:nailpro.com, site:reddit.com — commonly block AI crawlers entirely, best-effort only, expect empty results often"
    ],
    "never": "Never repeat the same blocked-site query hoping for a different result. Never cite a source that returned nothing. Never treat a failed fetch as evidence of anything (not evidence of low interest, not evidence of anything) — it is just an inaccessible source, move to the next one."
  },

  "mode_detection": {
    "objective": "Determine which of two entry points this session is using, before doing anything else.",
    "mode_a_topic_given": {
      "trigger": "User provides a specific topic or post idea directly.",
      "behavior": "Skip topic discovery. Proceed straight to phase_1 research on the given topic. Phase_1's entire focus is sentiment- and emotion-based: what does this topic make people feel, what triggers a click, what angle (negative/tension, FOMO, curiosity gap) actually fits the real conversation around it. This is the core research mission for Mode A, not a side effect."
    },
    "mode_b_agent_proposes": {
      "trigger": "User asks the agent to find topics, or gives no specific topic and asks what's worth writing about.",
      "behavior": "Run phase_0_trend_scan below — scan what's currently trending/warming right now, using reliable sources. Present a shortlist of 5-8 candidate topics with a one-line why-now rationale each. This is a deliberate exception to the no-intermediate-presentation rule. User picks one or more. For each chosen topic, run the full research pipeline (phase_1 onward, same sentiment-first focus as Mode A) and output one input file per topic, confirming slug before moving to the next if multiple were chosen."
    },
    "confirm_mode": "State at the start: 'MODE A — topic given' OR 'MODE B — scanning for trending topics'."
  },


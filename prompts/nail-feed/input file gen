  "phase_4_emotion_trigger_and_hook_research": {
    "objective": "Select ONE emotion trigger based on phase_1's real sentiment_read, and lock the title/excerpt/intro hook. This is the single most consequential output in the file — title + hero image are the entire click decision, nothing else is visible to the reader before they tap.",
    "trigger_framework": {
      "rule": "Select EXACTLY ONE, matched to phase_1's actual sentiment_read — never defaulted or assumed. A genuinely exciting, positive trend gets FOMO framing; a genuine, common frustration gets negative-angle framing. The trigger must fit what phase_1 actually found, not a reflexive preference for negativity.",
      "trigger_1_curiosity_gap": {
        "when": "Reader suspects they're missing something or doing it wrong — phase_1 shows confusion or a knowledge gap.",
        "signal_words": ["The Real Reason", "What Nobody Tells You", "Why Your ___ Keeps ___"]
      },
      "trigger_2_negative_angle_plus_solution": {
        "when": "phase_1 sentiment_read is genuinely negative/frustrated — a real, specific, common problem exists in the actual conversation. State the problem sharply before the fix. This is a confirmed high-CTR pattern for Discover specifically — negative emotion reliably outperforms neutral framing for stopping the scroll, but only when the frustration is real, not manufactured.",
        "signal_words": ["___ Keeps ___ — Here's Why", "The Mistake That's ___", "Stop Doing ___"]
      },
      "trigger_3_fomo_trend_urgency": {
        "when": "phase_1 confirms genuine rising trend velocity and positive/excited sentiment. Reader is trend-aware, fears missing out.",
        "signal_words": ["Everyone's Wearing", "Right Now", "Trending This Week", "2026"]
      },
      "trigger_4_identity_mirroring": {
        "when": "Topic is an aesthetic/identity label (quiet luxury, old money, mob wife, etc.).",
        "signal_words": ["For Women Who", "The ___ Girl's Guide To"]
      }
    },
    "title_rules": {
      "target_length": "40-60 characters — confirmed Discover CTR sweet spot.",
      "hard_cap": "60 characters.",
      "case": "Sentence case — reads natural on mobile Discover cards. Never Title Case or ALL CAPS.",
      "front_load": "The core claim or entity in the first few words — a scrolling thumb decides in under a second.",
      "specificity_over_sensationalism": "A specific, verifiable claim beats a vague sensational one. Discover's classifier actively suppresses headline-promise-vs-content mismatches — the title must be something this post genuinely delivers on.",
      "one_trigger_one_hook": "One emotional trigger, one clear hook. Never stack multiple trigger types."
    },
    "excerpt_rules": {
      "length": "120-155 characters.",
      "structure": "The desire/problem the reader has + what's specifically inside + a soft differentiator. Never repeats the title."
    },
    "output": {
      "selected_trigger": "Trigger name and number, one only",
      "trigger_rationale": "One sentence — why this trigger fits phase_1's actual sentiment_read",
      "title": "Hardcoded final title, 40-60 chars",
      "title_char_count": "Exact count",
      "excerpt": "Hardcoded final excerpt, 120-155 chars",
      "excerpt_char_count": "Exact count",
      "intro_hook_brief": "1-2 sentences — the emotional angle and opening move, matching the selected trigger"
    }
  },

  "phase_5_hero_image_brief": {
    "objective": "SCOPE IS DELIBERATELY LIMITED: this phase produces ONLY the alt text and filename brief for the hero image — nothing else. It does NOT write a visual concept, mood, styling, or lighting description. Image-generation creative direction is handled by a separate, dedicated prompt downstream; this agent's output becomes an input to that prompt, tagged as being for Discover.",
    "why_scope_is_limited": "The founder is building hero images to function like YouTube thumbnails — high color contrast, instantly scroll-stopping, engineered to guarantee the click. That creative direction lives in a separate image-prompt system. This agent's job is only to hand off what the post is actually about, in a form that system can use: a precise alt text and a descriptive filename.",
    "research_input": "Draw directly from phase_1's named_entities and sentiment_read — what is this specific look/technique/trend, and what's the emotional angle the image needs to support (matches phase_4's selected trigger).",
    "output": {
      "imageAlt": "120-125 characters. Leads with the specific visual detail a scrolling thumb would register first — the exact finish, colour, or contrast point, not a generic 'nail image' description. Primary keyword (if any) in the first 8 words where it fits naturally.",
      "image_filename_brief": "A descriptive, keyword-rich, lowercase-hyphenated filename suggestion (80-90 characters including extension) describing exactly what should be in the shot — e.g. 'chrome-french-tips-black-background-studio-light-2026.webp'. This is a naming brief, not the actual generated image.",
      "tag_for_downstream_prompt": "One line confirming this brief is for a Google Discover hero image — high contrast, thumbnail-style, click-optimised — so the separate image-generation prompt has that context when the user feeds it this brief.",
      "spec_reminder": "1200x675, 16:9 — hard Discover technical gate, non-negotiable, for whoever generates the actual image."
    }
  },

  "phase_6_content_structure": {
    "objective": "Build H2 structure serving the sentiment/emotion angle locked in phase_4 — not a generic listicle template.",
    "h2_count_guidance": "4-7 H2s for a 1500-word post — enough to clear the mandatory minimum of 3 and structure real depth, not so many each section runs thin.",
    "mandatory_minimum": "At least 3 H2 headings — HARD technical requirement. The route explicitly documents: fewer than 3 H2s means some mid-content widget slots (newsletter, poll/quiz, and especially the social CTA, which needs a genuine 3rd break point) silently do not render. 2 H2s still gets newsletter + poll/quiz but skips social entirely. 0-1 H2s skips everything mid-content.",
    "structure_source": "Build from phase_1's sentiment findings and specific frustration/desire, not a generic template. Each H2 should do real work toward the emotional promise set in phase_4.",
    "output": {
      "h1": "Working headline reference for structural planning — the actual title is locked in phase_4.",
      "h2_structure": "Exact ordered list of headings",
      "word_budget_per_section": "Distribute 1500 words: intro 120-160, conclusion 80-120, remainder split across H2s weighted by what each section genuinely needs"
    }
  },

  "phase_7_linking": {
    "objective": "Compile the complete link list. Light relational structure, no cluster machinery — and every link resolves to the URL of where that page ACTUALLY exists, never assumed from a route pattern.",
    "total_cap": "2-3 internal + 2-3 external maximum. Hard ceiling, natural placement.",
    "link_location_hard_rule": {
      "critical": "HARD RULE, THE MOST IMPORTANT RULE IN THIS PHASE: an internal link's URL is determined ENTIRELY by which route the linked page actually lives on, discovered live via search — never assumed or constructed from a pattern. If site:mirelleinspo.com/nail-feed [topic] finds the sibling post, the link is /nail-feed/{slug}. If site:mirelleinspo.com/blog [topic] finds a relevant pillar or spoke, the link is /blog/{topic}/{slug} exactly as that URL actually exists. NEVER take a slug found on one route and build a URL for a different route. NEVER assume a post exists on /nail-feed just because this post is on /nail-feed — confirm the actual route via the search result itself, every time. This is how broken internal links happen: constructing a plausible-looking URL instead of copying the one the search actually returned.",
      "verbatim_rule": "Whatever URL the search result actually shows is the URL used, copied exactly, character for character. The agent does not shorten it, does not standardise its shape, does not 'clean it up' to match an expected pattern."
    },
    "internal_links": {
      "method": "Live search only: site:mirelleinspo.com/nail-feed [topic/entity] for sibling Nail Feed posts, and site:mirelleinspo.com/blog [topic/entity] for a relevant blog pillar or spoke page. No cluster_context.json exists for this route — discovery is done live every time, never asked of the user, never assumed from a previous post's structure.",
      "relevance_filter": "Strict — only include if genuinely relevant to this specific post's topic and adds real value at a specific point in the content. If in doubt, exclude.",
      "anchor_text_rule": "Descriptive and authority-passing — the reader should understand exactly where they're going from the anchor alone. Never just the bare keyword.",
      "parent_pillar_link": "If a genuinely relevant /blog page exists for this topic, include it as one of the internal links — this is the Layer 2→Layer 1 link that concentrates entity/cluster authority signal per the site's content funnel model. If none exists, omit — do not force one."
    },
    "external_links": {
      "method": "Per research_source_rules — reliable sources first. Quora is fetchable and can support a link if a specific answer/thread is genuinely worth citing. For authority/E-E-A-T sources (industry sites, brand sites), attempt a search, but treat every non-Quora external source as best-effort: if the site blocks the fetch, drop it and find an alternative rather than forcing a broken or unverifiable link.",
      "count": "2-3 maximum.",
      "never": "Never include an external link whose target page was not actually confirmed accessible during research. A guessed URL to a likely-blocked site is worse than one fewer external link."
    },
    "output": {
      "all_links": [
        {
          "url": "full URL, copied exactly as the search result returned it — never reconstructed",
          "anchor_text": "descriptive, authority-passing",
          "placement_section": "which H2 or intro/conclusion this belongs in, and why",
          "link_type": "nailfeed-sibling / blog-page / external"
        }
      ]
    }
  },


  },

  "phase_9_voice_tone": {
    "objective": "Recommend the voice register for THIS specific post, derived directly from phase_1's research — not a floating stylistic guess.",
    "derivation_rule": "HARD RULE: recommended_voice and tone_characteristics must trace directly back to two things already researched — phase_1's sentiment_read (positive/negative/mixed, and the specific texture of that sentiment) and phase_4's selected_trigger (which emotional lever the post is pulling). A negative-angle post built on a genuinely frustrated sentiment_read calls for a different register (sharper, more direct, validating the frustration) than a FOMO post built on genuine excitement (warmer, faster-paced, more breathless-but-controlled). This field is not decided independently of the research above it — it is a direct downstream read of it.",
    "constraint": "Never contradicts British English, banned vocabulary, or rhythm principles already locked in the Post Gen Agent prompt — this is voice register within that fixed frame, not a departure from it.",
    "output": {
      "recommended_voice": "e.g. Warm expert / Sharp and direct / Confident and fast — derived per derivation_rule above",
      "tone_characteristics": "2-4 traits, explicitly tied back to the sentiment_read and trigger that produced them",
      "audience_match": "One sentence on why this voice fits this reader's actual emotional state right now, per phase_1"
    }
  },


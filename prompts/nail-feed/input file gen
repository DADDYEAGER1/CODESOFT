  "phase_1_sentiment_and_emotion_research": {
    "objective": "PRIMARY research phase — the core of this entire pipeline. Not entity research with sentiment as a side note: this phase exists specifically to find the real emotional/sentiment territory around this topic, so the post can be built to trigger a click. Discover is user-interest and emotion driven, and this is where that gets researched, not assumed.",
    "mandatory_research_steps": [
      "site:quora.com [topic] — the primary human-sentiment source: what are people actually frustrated by, curious about, excited about regarding this specific topic. Read actual question phrasing and tone, not just topic match.",
      "Google search — [topic] — read what's currently being said/covered, note the dominant emotional register of existing coverage (is it flat and generic, or does something in the space already carry real feeling)",
      "Google PAA for [topic] — extract questions, read them for the underlying frustration or curiosity behind each one, not just as a topic list",
      "Google Trends — the specific topic, 90-day and 12-month view — confirm rising, sustained, or seasonal-cyclical, and roughly how warm right now",
      "Best-effort per research_source_rules: site:pinterest.com [topic], YouTube search [topic] for comment/description tone — use if usable"
    ],
    "what_to_extract": [
      "sentiment_read: is the dominant real conversation around this topic positive (excitement/FOMO-worthy), negative (frustration/a real recurring problem), or mixed — this is the single most important output of this phase, it drives phase_4's entire trigger selection",
      "the_specific_frustration_or_desire: not a generic paraphrase — the actual, specific thing people say when they're annoyed or excited about this, in something close to their own words",
      "named_entities: the exact technique name, product category, aesthetic label, colour, or trend name this post is built around — specific and citable, this is what Google's classifier matches on",
      "trend_velocity: rising, sustained, or seasonal-cyclical, and roughly how warm right now",
      "why_now_rationale: one or two sentences on the concrete reason this is relevant today",
      "saturation_check: is this genuinely under-covered, or already saturated — if saturated, note the differentiation angle"
    ],
    "cannibalization_light_check": "Quick site:mirelleinspo.com/nail-feed and site:mirelleinspo.com/blog search on the topic and its core entity — if a near-identical post already exists, either differentiate the angle sharply or flag it to the user rather than silently duplicating."
  },

  "phase_2_engagement_widget_research": {
    "objective": "Decide Reaction Bar wording, and whether Poll or Quiz genuinely fits this post — or neither. This is a judgment call grounded in phase_1's actual research findings, never a default, never forced, never invented content.",
    "reaction_bar": {
      "default_behavior": "Renders on every post automatically even with no frontmatter written — hardcoded fallback is Obsessed / Meh / Hard pass. No action needed by default.",
      "when_to_customize": "Only write a custom reaction block when phase_1's specific entity/sentiment genuinely earns sharper wording than the generic default — e.g. a specific technique-reaction framing that the generic options would flatten. This is the exception, not the rule. Do not customize reflexively on every post.",
      "custom_output_if_used": "2-4 {id, label} options, label format 'emoji + short text' (component splits on the first space, emoji becomes the glyph, rest becomes caption)."
    },
    "poll_or_quiz_decision": {
      "hard_rule": "JUDGMENT CALL, NOT MANDATORY: research phase_1's findings for a genuine angle. Include a Poll if there is a real binary/either-or debate or split opinion actually present in the research (Quora threads, comment sentiment, a genuine either/or the audience is divided on). Include a Quiz if the topic genuinely supports branching outcomes (multiple distinct looks, types, or results a reader could land on). If NEITHER is genuinely present in the research, skip both entirely — do not force one in to fill the slot. A forced, generic poll or quiz is worse than none at all.",
      "mutual_exclusivity": "Never select both. If somehow both angles seem present, pick whichever is the stronger, more specific fit and skip the other.",
      "poll_research_requirement": "If Poll is selected: the question and both/all options must come from the actual research (phase_1's specific_frustration_or_desire and sentiment findings) — a real split the audience actually has, phrased in their terms, not an invented generic either/or.",
      "quiz_research_requirement": "If Quiz is selected: this is a genuine research output, not a templated fill-in. The quiz STYLE (diagnostic 'is this right for you' vs. recommendation 'which look are you') is determined by what phase_1 actually found — diagnostic fits when the research shows readers uncertain whether something suits them; recommendation fits when the research shows readers wanting to be sorted into one of several genuine, distinct options. The questions, answer options, and final results must all be built from real audience findings from phase_1 — actual variations in taste/situation/preference that showed up in research, not invented placeholder branches.",
      "skip_is_a_valid_outcome": "Explicitly note in the output when neither was included and why — this is not a gap to apologise for, it is the correct call when the topic doesn't support either genuinely."
    }
  },

  "phase_3_word_count_and_image_count": {
    "objective": "Fixed by editorial decision, not researched per-post.",
    "word_count": {
      "fixed_target": "1500 words. Hard target, ±50 tolerance. Not derived from competitor averages. Never padded to reach — 1500 words of genuine per-section depth, or the topic needs deeper research in phase_1, not filler."
    },
    "image_count": {
      "fixed": "4 total: 1 hero + 3 body images. Fixed, no scaling logic, no per-post decision needed.",

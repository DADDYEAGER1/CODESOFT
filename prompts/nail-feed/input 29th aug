  "phase_4_emotion_trigger_and_hook_research": {
    "objective": "Select ONE emotion trigger based on phase_1's real sentiment_read, and lock the title/excerpt/intro hook AND the hero image's emotional angle together as one paired decision. Title and hero image are the entire click decision in a Discover feed card — they are drafted as a matched pair, not as two independently-optimized fields.",
    "discover_vs_serp_correction": {
      "critical": "HARD CORRECTION: earlier versions of this rule borrowed a Search/SERP title-tag length convention (40-60 characters, 60-char hard cap) that exists to solve pixel-width truncation in a text-only ranked search result. Google Discover is a visual feed product where the title sits directly beside the hero image as one combined card — it is not subject to the same truncation mechanics, and Discover has also been observed pulling headline text from social-style metadata (Open Graph og:title) rather than the plain title tag, reinforcing that this is a feed-headline problem, not a SERP-snippet problem. Do not apply SERP truncation logic here.",
      "corrected_length_guidance": "Target 45-70 characters. This is a readability-on-a-mobile-feed-card range, not a hard technical ceiling — prioritise the title reading clean and complete on a phone-sized card over hitting an exact count. If a genuinely stronger, more specific hook needs a few characters beyond 70, that is preferable to a weaker hook artificially shortened to fit a borrowed SERP number.",
      "what_does_not_change": "Sentence case (not Title Case or ALL CAPS), front-loading the core claim/entity, specificity over sensationalism, and the delivery-promise rule are unaffected by this correction — those are genuine Discover suppression/ranking mechanics, not SERP artifacts, and remain exactly as strict as before."
    },
    "trigger_framework": {
      "rule": "Select EXACTLY ONE, matched to phase_1's actual sentiment_read — never defaulted or assumed. A genuinely exciting, positive trend gets FOMO framing; a genuine, common frustration gets negative-angle framing. The trigger must fit what phase_1 actually found, not a reflexive preference for negativity.",
      "trigger_1_curiosity_gap": {
        "when": "Reader suspects they're missing something or doing it wrong — phase_1 shows confusion or a knowledge gap.",
        "signal_words": ["The Real Reason", "What Nobody Tells You", "Why Your ___ Keeps ___"]
      },
      "trigger_2_negative_angle_plus_solution": {
        "when": "phase_1 sentiment_read is genuinely negative/frustrated — a real, specific, common problem exists in the actual conversation. State the problem sharply before the fix. This is a confirmed high-CTR pattern for Discover specifically — negative emotion reliably outperforms neutral framing for stopping the scroll, but only when the frustration is real, not manufactured.",
        "signal_words": ["___ Keeps ___ — Here's Why", "The Mistake That's ___", "Stop Doing ___"]
      },
      "trigger_3_fomo_trend_urgency": {
        "when": "phase_1 confirms genuine rising trend velocity and positive/excited sentiment. Reader is trend-aware, fears missing out.",
        "signal_words": ["Everyone's Wearing", "Right Now", "Trending This Week", "2026"]
      },
      "trigger_4_identity_mirroring": {
        "when": "Topic is an aesthetic/identity label (quiet luxury, old money, mob wife, etc.).",
        "signal_words": ["For Women Who", "The ___ Girl's Guide To"]
      }
    },
    "title_rules": {
      "target_length": "45-70 characters — see discover_vs_serp_correction above. This replaces the old 40-60/60-cap SERP-derived range.",
      "case": "Sentence case — reads natural on mobile Discover cards. Never Title Case or ALL CAPS.",
      "front_load": "The core claim or entity in the first few words — a scrolling thumb decides in under a second.",
      "specificity_over_sensationalism": "A specific, verifiable claim beats a vague sensational one. Discover's classifier actively suppresses headline-promise-vs-content mismatches — the title must be something this post genuinely delivers on.",
      "one_trigger_one_hook": "One emotional trigger, one clear hook. Never stack multiple trigger types.",
      "paired_with_hero_image": "The title is not written in isolation — phase_5's hero image brief must support the exact same emotional beat this title opens. Draft the title first, then carry its specific visual implication (the exact colour/finish/moment it names) directly into phase_5's imageAlt, so the two function as one card, not two disconnected fields."
    },
    "excerpt_rules": {
      "length": "120-155 characters.",
      "structure": "The desire/problem the reader has + what's specifically inside + a soft differentiator. Never repeats the title."
    },
    "output": {
      "selected_trigger": "Trigger name and number, one only",
      "trigger_rationale": "One sentence — why this trigger fits phase_1's actual sentiment_read",
      "title": "Hardcoded final title, 45-70 chars",
      "title_char_count": "Exact count",
      "excerpt": "Hardcoded final excerpt, 120-155 chars",
      "excerpt_char_count": "Exact count",
      "intro_hook_brief": "1-2 sentences — the emotional angle and opening move, matching the selected trigger",
      "hero_image_emotional_beat": "1 sentence — the specific visual moment the title implies, which phase_5 must carry through into imageAlt so title and image read as one hook"
    }
  },
 
  "phase_5_hero_image_brief": {
    "objective": "SCOPE IS DELIBERATELY LIMITED: this phase produces ONLY the alt text and filename brief for the hero image — nothing else. It does NOT write a visual concept, mood, styling, or lighting description. Image-generation creative direction is handled by a separate, dedicated prompt downstream; this agent's output becomes an input to that prompt, tagged as being for Discover. What this phase DOES do is make sure imageAlt is not researched or written in isolation from phase_4's title — they are one paired hook.",
    "why_scope_is_limited": "The founder is building hero images to function like YouTube thumbnails — high color contrast, instantly scroll-stopping, engineered to guarantee the click. That creative direction lives in a separate image-prompt system. This agent's job is only to hand off what the post is actually about, in a form that system can use: a precise alt text and a descriptive filename, carrying the same emotional beat as the title.",
    "research_input": "Draw directly from phase_1's named_entities and sentiment_read, AND from phase_4's hero_image_emotional_beat — what is this specific look/technique/trend, and what's the emotional angle the image needs to support, matching the exact moment the title names, not just the general trigger category.",
    "output": {
      "imageAlt": "120-125 characters. Leads with the specific visual detail a scrolling thumb would register first — the exact finish, colour, or contrast point the title itself names, not a generic 'nail image' description and not a different visual angle than the title implies. Primary keyword (if any) in the first 8 words where it fits naturally.",
      "image_filename_brief": "A descriptive, keyword-rich, lowercase-hyphenated filename suggestion (80-90 characters including extension) describing exactly what should be in the shot — e.g. 'chrome-french-tips-black-background-studio-light-2026.webp'. This is a naming brief, not the actual generated image. Note for downstream use: the actual hero image file will be saved under the nested path /images/nail-feed/[slug]/[filename].webp — this brief supplies only the filename portion.",
      "tag_for_downstream_prompt": "One line confirming this brief is for a Google Discover hero image — high contrast, thumbnail-style, click-optimised, paired with the exact title above — so the separate image-generation prompt has that context when the user feeds it this brief.",
      "spec_reminder": "1200x675, 16:9 — hard Discover technical gate, non-negotiable, for whoever generates the actual image."
    }
  },
 

'use client';

import { useState, useEffect, useRef } from 'react';

/**
 * Floating "Add as a preferred source on Google" button.
 *
 * Matches the 48px circular footprint of ShareButton and DownloadButton so
 * the three-button stack reads as one aligned column:
 *   - ShareButton:      bottom: 84px
 *   - DownloadButton:   bottom: 144px
 *   - This button:      bottom: 204px
 * All three share right: 16px.
 *
 * Default state is a plain circle with Google's "G" mark, same size/shape
 * as the other two buttons. It expands into the full "Add as a preferred
 * source on Google" pill (Google's official wording) ONCE per session,
 * after the reader has been actively engaged (scrolled or interacted) for
 * a continuous 10 seconds  not on a blind page-load timer, so it doesn't
 * fire on a bounce/quick tab-close. Hovering (desktop) re-expands it any
 * time after that; tapping always navigates regardless of state.
 */

const GOOGLE_SOURCE_URL = 'https://google.com/preferences/source?q=mirelleinspo.com';
const ENGAGEMENT_THRESHOLD_MS = 10000; // 10s of active engagement before first auto-expand
const AUTO_EXPAND_DURATION_MS = 3500; // how long the full pill stays open once triggered

const GoogleGIcon = () => (
  <svg viewBox="0 0 24 24" width="20" height="20">
    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.85A10.99 10.99 0 0 0 12 23z" />
    <path fill="#FBBC05" d="M5.84 14.09A6.6 6.6 0 0 1 5.5 12c0-.73.12-1.43.34-2.09V7.06H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.94l3.66-2.85z" />
    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.85c.87-2.6 3.3-4.53 6.16-4.53z" />
  </svg>
);

export default function GooglePreferredSourceButton() {
  const [expanded, setExpanded] = useState(false);
  const hasAutoExpandedRef = useRef(false);
  const engagementTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  useEffect(() => {
    function startEngagementTimer() {
      if (hasAutoExpandedRef.current || engagementTimerRef.current) return;
      engagementTimerRef.current = setTimeout(() => {
        hasAutoExpandedRef.current = true;
        setExpanded(true);
        removeListeners();
      }, ENGAGEMENT_THRESHOLD_MS);
    }

    function handleEngagement() {
      startEngagementTimer();
    }

    function removeListeners() {
      window.removeEventListener('scroll', handleEngagement);
      window.removeEventListener('pointerdown', handleEngagement);
      window.removeEventListener('keydown', handleEngagement);
    }

    // Any of these counts as "the reader is actually engaging with the page"
    window.addEventListener('scroll', handleEngagement, { passive: true });
    window.addEventListener('pointerdown', handleEngagement, { passive: true });
    window.addEventListener('keydown', handleEngagement);

    return () => {
      removeListeners();
      if (engagementTimerRef.current) clearTimeout(engagementTimerRef.current);
    };
  }, []);

  useEffect(() => {
    if (!expanded) return;
    const closeTimer = setTimeout(() => setExpanded(false), AUTO_EXPAND_DURATION_MS);
    return () => clearTimeout(closeTimer);
  }, [expanded]);

  return (
    <div className="fixed z-40" style={{ bottom: '204px', right: '16px' }}>
      <a
        href={GOOGLE_SOURCE_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Add Mirellé Inspo as a preferred source on Google"
        title="Add as a preferred source on Google"
        onMouseEnter={() => setExpanded(true)}
        onMouseLeave={() => setExpanded(false)}
        className="flex items-center h-12 rounded-full shadow-lg transition-all duration-300 ease-out overflow-hidden hover:scale-105 active:scale-95"
        style={{
          width: expanded ? '236px' : '48px',
          backgroundColor: '#fff',
          color: '#3c4043',
        }}
      >
        <span className="flex items-center justify-center flex-shrink-0" style={{ width: '48px', height: '48px' }}>
          <GoogleGIcon />
        </span>
        <span
          className="text-sm font-ui font-medium whitespace-nowrap pr-4 transition-opacity duration-200"
          style={{ opacity: expanded ? 1 : 0 }}
        >
          Add as a preferred source
        </span>
      </a>
    </div>
  );
}


/**
 * Share button.
 *
 * Sits lowest in the fixed bottom-right stack (bottom: 84px), so its expand
 * menu opens DOWNWARD into the empty margin below it, rather than upward
 * where it would collide with DownloadButton (144px) and
 * GooglePreferredSourceButton (204px) sitting above it in the same column.
 *
 * Styled to match GooglePreferredSourceButton and the restyled
 * DownloadButton: white circle, black icon, 48px, consistent shadow.
 */
export default function ShareButton({ url, title }: ShareButtonProps) {
  const [open, setOpen] = useState(false);
  const [copied, setCopied] = useState(false);
  const wrapRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    function handleClickOutside(e: MouseEvent) {
      if (wrapRef.current && !wrapRef.current.contains(e.target as Node)) {
        setOpen(false);
      }
    }
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const encodedUrl = encodeURIComponent(url);
  const encodedTitle = encodeURIComponent(title);

  function isMobile() {
    if (typeof navigator === 'undefined') return false;
    return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  }

  function openShare(href: string) {
    if (isMobile()) {
      window.open(href, '_blank');
    } else {
      window.open(href, '_blank', 'noopener,noreferrer,width=600,height=600');
    }
  }

  async function handleCopy() {
    try {
      await navigator.clipboard.writeText(url);
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    } catch {
      // clipboard unavailable, silently ignore
    }
  }

  const actions = [
    {
      key: 'copy',
      label: copied ? 'Copied' : 'Copy link',
      icon: copied ? <Check size={18} /> : <Link2 size={18} />,
      onClick: handleCopy,
    },
    {
      key: 'x',
      label: 'X',
      icon: <XIcon />,
      onClick: () => openShare(`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`),
    },
    {
      key: 'facebook',
      label: 'Facebook',
      icon: <FacebookIcon />,
      onClick: () => openShare(`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`),
    },
    {
      key: 'pinterest',
      label: 'Pinterest',
      icon: <PinterestIcon />,
      onClick: () => openShare(`https://pinterest.com/pin/create/button/?url=${encodedUrl}&description=${encodedTitle}`),
    },
    {
      key: 'linkedin',
      label: 'LinkedIn',
      icon: <LinkedInIcon />,
      onClick: () => openShare(`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`),
    },
    {
      key: 'reddit',
      label: 'Reddit',
      icon: <RedditIcon />,
      onClick: () => openShare(`https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`),
    },
  ];

  return (
    <div
      ref={wrapRef}
      className="fixed z-40"
      style={{ bottom: '84px', right: '16px' }}
    >
      {/* Main trigger */}
      <button
        onClick={() => setOpen(o => !o)}
        aria-label={open ? 'Close share menu' : 'Share this post'}
        aria-expanded={open}
        className="w-12 h-12 rounded-full flex items-center justify-center shadow-lg transition-transform hover:scale-105 active:scale-95"
        style={{ backgroundColor: '#fff', color: '#3c4043' }}
      >
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          strokeWidth="2"
          strokeLinecap="round"
          strokeLinejoin="round"
          style={{ transform: open ? 'rotate(45deg)' : 'none', transition: 'transform 0.2s ease' }}
        >
          <circle cx="18" cy="5" r="3" />
          <circle cx="6" cy="12" r="3" />
          <circle cx="18" cy="19" r="3" />
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
        </svg>
      </button>

      {/* Expanded action stack  opens UPWARD, but offset far enough to
          clear DownloadButton (bottom:144px) and GooglePreferredSourceButton
          (bottom:204px) sitting above this trigger, so none of the 6 share
          icons ever land on top of those buttons. */}
      {open && (
        <div
          className="flex flex-col items-center gap-2 absolute"
          style={{ bottom: '176px', right: 0 }}
          role="menu"
          aria-label="Share this post"
        >
          {actions.map((action, i) => (
            <button
              key={action.key}
              onClick={action.onClick}
              role="menuitem"
              aria-label={action.label}
              title={action.label}
              className="w-11 h-11 rounded-full flex items-center justify-center shadow-md border transition-transform hover:scale-105 active:scale-95"
              style={{
                backgroundColor: '#fff',
                color: '#3c4043',
                borderColor: 'rgba(37,34,32,0.1)',
                animation: `shareFadeIn 0.18s ease-out ${i * 0.03}s both`,
              }}
            >
              {action.icon}
            </button>
          ))}
        </div>
      )}

      <style jsx>{`
        @keyframes shareFadeIn {
          from {
            opacity: 0;
            transform: translateY(-6px) scale(0.9);
          }
          to {
            opacity: 1;
            transform: translateY(0) scale(1);
          }
        }
      `}</style>
    </div>
  );
}



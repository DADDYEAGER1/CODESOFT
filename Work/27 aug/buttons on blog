'use client';

import { useState } from 'react';
import { Image as ImageIcon, Check } from 'lucide-react';

interface DownloadButtonProps {
  slug: string;
  title: string;
  bodyImages: string[]; // body image URLs only, NOT the hero image
}

/**
 * "Download inspo images" button.
 *
 * Single-purpose now: downloads the post's body images only. The old PDF
 * export option has been removed, so there's no submenu anymore - one tap
 * downloads directly, matching ShareButton's plain-circle footprint.
 *
 * Styled to match GooglePreferredSourceButton: white circle, colored/black
 * icon, same 48px size, so the fixed bottom-right stack reads as one
 * consistent set of buttons instead of mismatched styles.
 */
export default function DownloadButton({ slug, bodyImages }: DownloadButtonProps) {
  const [downloading, setDownloading] = useState(false);
  const [done, setDone] = useState(false);
  const hasBodyImages = bodyImages && bodyImages.length > 0;

  if (!hasBodyImages) return null;

  function slugifyName(base: string, index: number, url: string) {
    const ext = url.split('.').pop()?.split('?')[0] || 'jpg';
    return `${base}-${index + 1}.${ext}`;
  }

  async function handleDownload() {
    if (downloading) return;
    setDownloading(true);
    try {
      for (let i = 0; i < bodyImages.length; i++) {
        const url = bodyImages[i];
        try {
          const res = await fetch(url);
          const blob = await res.blob();
          const objectUrl = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = objectUrl;
          a.download = slugifyName(slug, i, url);
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(objectUrl);
          // small delay so mobile browsers don't drop/block rapid-fire downloads
          await new Promise((r) => setTimeout(r, 400));
        } catch {
          // skip failed image, continue with the rest
        }
      }
      setDone(true);
      setTimeout(() => setDone(false), 2000);
    } finally {
      setDownloading(false);
    }
  }

  return (
    <div className="fixed z-40" style={{ bottom: '144px', right: '16px' }}>
      <button
        onClick={handleDownload}
        disabled={downloading}
        aria-label="Download inspo images"
        title="Download inspo images"
        className="w-12 h-12 rounded-full flex items-center justify-center shadow-lg transition-transform hover:scale-105 active:scale-95 disabled:opacity-60 disabled:hover:scale-100"
        style={{ backgroundColor: '#fff', color: '#3c4043' }}
      >
        {done ? <Check size={20} /> : <ImageIcon size={20} />}
      </button>
    </div>
  );
}

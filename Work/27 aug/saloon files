      "content": "// src/components/Salons/SalonsCityGrid.tsx\nimport Link from 'next/link';\nimport Image from 'next/image';\nimport { CityListicleMetadata } from '@/types/salons';\n\ninterface SalonsCityGridProps {\n  cities: CityListicleMetadata[];\n}\n\nexport default function SalonsCityGrid({ cities }: SalonsCityGridProps) {\n  return (\n    <section className=\"max-w-[1200px] mx-auto px-6 py-12\">\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {cities.map((city) => (\n          <Link key={city.slug} href={`/salons/${city.slug}`} className=\"block group h-full\">\n            <div className=\"border border-foreground/10 h-full flex flex-col hover:border-foreground/40 transition-colors duration-200\">\n              <div className=\"relative w-full aspect-[1200/675] overflow-hidden bg-foreground/5\">\n                <Image\n                  src={city.image}\n                  alt={city.imageAlt || city.cityName}\n                  fill\n                  className=\"object-cover group-hover:scale-105 transition-transform duration-300\"\n                  sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\"\n                />\n              </div>\n              <div className=\"p-6 flex flex-col gap-3 flex-1\">\n                <p className=\"font-ui uppercase text-xs text-foreground/50 tracking-wider\">\n                  {city.cityName}\n                </p>\n                <h2 className=\"font-heading text-xl text-foreground leading-snug line-clamp-2\">\n                  {city.title}\n                </h2>\n                {city.excerpt && (\n                  <p className=\"font-body text-sm text-foreground/70 leading-relaxed line-clamp-3\">\n                    {city.excerpt}\n                  </p>\n                )}\n                <div className=\"mt-auto pt-4 border-t border-foreground/10 flex items-center justify-between\">\n                  {city.readTime && (\n                    <span className=\"font-ui text-xs text-foreground/50 uppercase tracking-wider\">\n                      {city.readTime} read\n                    </span>\n                  )}\n                  <span className=\"font-ui text-xs text-foreground/70 uppercase tracking-wider ml-auto\">\n                    View List →\n                  </span>\n                </div>\n              </div>\n            </div>\n          </Link>\n        ))}\n      </div>\n    </section>\n  );\n}"

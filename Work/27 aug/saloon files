ground text-background px-2 py-0.5\">\n                Editor&rsquo;s Pick\n              </span>\n            )}\n          </div>\n\n          <p className=\"font-body text-base text-foreground/80 leading-relaxed mb-4\">\n            {listing.whyPicked}\n          </p>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 font-ui text-sm text-foreground/60 mb-4\">\n            <div className=\"flex items-center gap-2\">\n              <PinIcon />\n              <span>{listing.address}</span>\n            </div>\n            {listing.phone && (\n              <div className=\"flex items-center gap-2\">\n                <PhoneIcon />\n                <span>{listing.phone}</span>\n              </div>\n            )}\n            {listing.hours && <div>{listing.hours}</div>}\n            {listing.priceRange && <div>Price: {listing.priceRange}</div>}\n            {listing.specialty && <div>Specialty: {listing.specialty}</div>}\n            {listing.ratingNote && <div>{listing.ratingNote}</div>}\n          </div>\n\n          <div className=\"flex flex-wrap gap-4\">\n            {listing.website && (\n              <a\n                href={listing.website}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"font-ui text-xs uppercase tracking-wide underline hover:no-underline text-foreground\"\n              >\n                Visit Website →\n              </a>\n            )}\n            {listing.instagram && (\n              <a\n                href={listing.instagram}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"font-ui text-xs uppercase tracking-wide underline hover:no-underline text-foreground\"\n              >\n                Instagram →\n              </a>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}"

      "path": "src/lib/salons.ts",
      "content": "// src/lib/salons.ts\nimport fs from 'fs';\nimport path from 'path';\nimport matter from 'gray-matter';\nimport { CityListicle, CityListicleMetadata, SalonListing } from '@/types/salons';\n\nconst salonsDirectory = path.join(process.cwd(), 'src/content/salons');\n\nexport async function getAllCitySlugs(): Promise<string[]> {\n  if (!fs.existsSync(salonsDirectory)) return [];\n  return fs\n    .readdirSync(salonsDirectory)\n    .filter((f) => f.endsWith('.md'))\n    .map((f) => f.replace(/\\.md$/, ''));\n}\n\nexport async function getCityListicle(slug: string): Promise<CityListicle | null> {\n  try {\n    const fullPath = path.join(salonsDirectory, `${slug}.md`);\n    if (!fs.existsSync(fullPath)) return null;\n\n    const fileContents = fs.readFileSync(fullPath, 'utf8');\n    const { data, content } = matter(fileContents);\n\n    // Content body is split into intro / closing by a \"---LISTINGS---\" marker.\n    // Listings themselves come from frontmatter, not the body, since they're\n    // structured data (name, address, phone, etc.) rather than prose.\n    const [intro, closing] = content.split(/\\n---LISTINGS---\\n/);\n\n    const listings: SalonListing[] = (data.listings || []).sort(\n      (a: SalonListing, b: SalonListing) => a.rank - b.rank\n    );\n\n    return {\n      slug: data.slug || slug,\n      cityName: data.cityName || '',\n      title: data.title || '',\n      excerpt: data.excerpt || '',\n      date: data.date || new Date().toISOString(),\n      dateModified: data.dateModified,\n      author: data.author || 'Mirellé Team',\n      category: data.category || 'Nail Salons',\n      image: data.image || '/images/default-city.jpg',\n      imageAlt: data.imageAlt,\n      readTime: data.readTime,\n      wordCount: data.wordCount,\n      canonical: data.canonical || `https://mirelleinspo.com/salons/${slug}`,\n      tags: data.tags,\n      criteriaNote: data.criteriaNote,\n      intro: intro?.trim() || '',\n      listings,\n      closing: closing?.trim() || '',\n    };\n  } catch (error) {\n    console.error(`Error loading city listicle ${slug}:`, error);\n    return null;\n  }\n}\n\nexport async function getAllCityListicles(): Promise<CityListicleMetadata[]> {\n  const slugs = await getAllCitySlugs();\n  const cities = await Promise.all(\n    slugs.map(async (slug) => {\n      const city = await getCityListicle(slug);\n      if (!city) return null;\n      const { intro, listings, closing, ...metadata } = city;\n      return metadata;\n    })\n  );\n  return cities\n    .filter((c): c is CityListicleMetadata => c !== null)\n    .sort((a, b) => a.cityName.localeCompare(b.cityName));\n}"

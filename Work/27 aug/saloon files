      "content": "// src/app/salons/[city]/page.tsx\nimport { Metadata } from 'next';\nimport { notFound } from 'next/navigation';\nimport { getCityListicle, getAllCitySlugs } from '@/lib/salons';\nimport { getAuthor } from '@/lib/authors';\nimport Breadcrumbs from '@/components/Breadcrumbs';\nimport AuthorCard from '@/components/Blog/AuthorCard';\nimport SalonListingCard from '@/components/Salons/SalonListingCard';\nimport SalonFeatureCTA from '@/components/Salons/SalonFeatureCTA';\nimport { remark } from 'remark';\nimport remarkGfm from 'remark-gfm';\nimport remarkHtml from 'remark-html';\n\nexport const dynamic = 'force-static';\nexport const revalidate = false;\n\ninterface PageProps {\n  params: Promise<{ city: string }>;\n}\n\nexport async function generateStaticParams() {\n  const slugs = await getAllCitySlugs();\n  return slugs.map((city) => ({ city }));\n}\n\nexport async function generateMetadata({ params }: PageProps): Promise<Metadata> {\n  const { city } = await params;\n  const listicle = await getCityListicle(city);\n  if (!listicle) return {};\n\n  return {\n    title: listicle.title,\n    description: listicle.excerpt,\n    alternates: { canonical: listicle.canonical || `https://mirelleinspo.com/salons/${city}` },\n    openGraph: {\n      title: listicle.title,\n      description: listicle.excerpt,\n      url: `https://mirelleinspo.com/salons/${city}`,\n      siteName: 'Mirellé Inspo',\n      type: 'article',\n      publishedTime: listicle.date,\n      modifiedTime: listicle.dateModified || listicle.date,\n      authors: [listicle.author],\n      images: [{ url: listicle.image, width: 1200, height: 675, alt: listicle.title }],\n    },\n    twitter: {\n      card: 'summary_large_image',\n      title: listicle.title,\n      description: listicle.excerpt,\n      images: [listicle.image],\n    },\n    robots: {\n      index: true,\n      follow: true,\n      googleBot: { index: true, follow: true, 'max-video-preview': -1, 'max-image-preview': 'large', 'max-snippet': -1 },\n    },\n  };\n}\n\nexport default async function CityListiclePage({ params }: PageProps) {\n  const { city } = await params;\n  const listicle = await getCityListicle(city);\n  if (!listicle) notFound();\n\n  const author = getAuthor(listicle.author);\n\n  const formattedDate = new Date(listicle.date).toLocaleDateString('en-US', {\n    year: 'numeric',\n    month: 'long',\n    day: 'numeric',\n  });\n\n  const introHtml = (await remark().use(remarkGfm).use(remarkHtml).process(listicle.intro)).toString();\n  const closingHtml = listicle.closing\n    ? (await remark().use(remarkGfm).use(remarkHtml).process(listicle.closing)).toString()\n    : '';\n\n  const midpoint = Math.ceil(listicle.listings.length / 2);\n  const firstHalf = listicle.listings.slice(0, midpoint);\n  const secondHalf = listicle.listings.slice(midpoint);\n\n  // JSON-LD ItemList - helps establish this as a genuine structured \"best of\"\n  // list rather than a thin/undifferentiated page, per E-E-A-T guidance.\n  const itemListSchema = {\n    '@context': 'https://schema.org',\n    '@type': 'ItemList',\n    itemListElement: listicle.listings.map((l) => ({\n      '@type': 'ListItem',\n      position: l.rank,\n      item: {\n        '@type': 'LocalBusiness',\n        name: l.name,\n        address: l.address,\n        telephone: l.phone,\n        url: l.website,\n      },\n    })),\n  };\n\n  return (\n    <article className=\"min-h-screen bg-background\">\n      <script\n        type=\"application/ld+json\"\n        dangerouslySetInnerHTML={{ __html: JSON.stringify(itemListSchema) }}\n      />\n\n      <div className=\"max-w-[1200px] mx-auto\">\n        <div className=\"max-w-[800px] px-6 pt-8\">\n          <Breadcrumbs\n            items={[{ label: 'Salons', href: '/salons' }]}\n            currentPage={listicle.cityName}\n          />\n\n          {listicle.category && (\n            <p className=\"font-ui uppercase text-xs text-foreground/50 tracking-wider mt-6\">\n              {listicle.category}\n            </p>\n          )}\n\n          <h1 className=\"font-heading text-4xl md:text-5xl leading-tight mt-3 mb-4\">\n            {listicle.title}\n          </h1>\n\n          <div className=\"flex items-center gap-2 font-ui text-sm text-foreground/60 mb-8\">\n            <span>BY {listicle.author.toUpperCase()}</span>\n            <span>·</span>\n            <time dateTime={listicle.date}>{formattedDate}</time>\n          </div>\n        </div>\n\n        {/* Hero - 16:9, 1200x675 minimum per Discover hero image spec */}\n        <div className=\"px-6 mb-8\">\n          <div className=\"w-full max-w-[1000px] aspect-[16/9] overflow-hidden bg-foreground/5\">\n            <img\n              src={listicle.image}\n              alt={listicle.imageAlt || listicle.title}\n              className=\"w-full h-full object-cover\"\n            />\n          </div>\n        </div>\n\n        <div className=\"max-w-[800px] px-6\">\n          <div\n            className=\"prose prose-lg max-w-none font-body prose-headings:font-heading prose-a:text-foreground prose-a:underline mb-6\"\n            dangerouslySetInnerHTML={{ __html: introHtml }}\n          />\n\n          {listicle.criteriaNote && (\n            <div className=\"bg-foreground/[0.03] border-l-2 border-foreground/30 px-5 py-4 mb-10\">\n              <p className=\"font-ui text-xs uppercase tracking-widest text-foreground/40 mb-1\">\n                How We Picked\n              </p>\n              <p className=\"font-body text-sm text-foreground/70 leading-relaxed\">\n                {listicle.criteriaNote}\n              </p>\n            </div>\n          )}\n        </div>\n\n        <div className=\"max-w-[900px] px-6 space-y-4\">\n          {firstHalf.map((listing) => (\n            <SalonListingCard key={listing.rank} listing={listing} />\n          ))}\n        </div>\n\n        <div className=\"max-w-[800px] px-6\">\n          <SalonFeatureCTA variant=\"mid\" cityName={listicle.cityName} />\n        </div>\n\n        <div className=\"max-w-[900px] px-6 space-y-4\">\n          {secondHalf.map((listing) => (\n            <SalonListingCard key={listing.rank} listing={listing} />\n          ))}\n        </div>\n\n        {closingHtml && (\n          <div className=\"max-w-[800px] px-6 mt-10\">\n            <div\n              className=\"prose prose-lg max-w-none font-body prose-headings:font-heading prose-a:text-foreground prose-a:underline\"\n              dangerouslySetInnerHTML={{ __html: closingHtml }}\n            />\n          </div>\n        )}\n\n        <div className=\"max-w-[800px] px-6\">\n          <SalonFeatureCTA variant=\"end\" cityName={listicle.cityName} />\n        </div>\n\n        {author && (\n          <div className=\"max-w-[800px] px-6 mt-16\">\n            <AuthorCard author={author} />\n          </div>\n        )}\n      </div>\n    </article>\n  );\n}"

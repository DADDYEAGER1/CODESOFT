      "content": "// src/app/pinterest/page.tsx\nimport { Metadata } from 'next';\nimport Link from 'next/link';\nimport { getAllPinterestReports, getPaginatedPinterestReports } from '@/lib/pinterest';\nimport ReportsGrid from '@/components/Reports/ReportsGrid';\nimport NextPageButton from '@/components/Blog/NextPageButton';\n\nexport const dynamic = 'force-static';\nexport const revalidate = false;\n\nexport const metadata: Metadata = {\n  title: 'Pinterest Predicts: Nails Edition - Monthly Trend Forecasts | Mirellé Inspo',\n  description:\n    \"Every month, we break down what Pinterest predicts will trend next for nails - and show exactly what we created around it. No recaps, just what's coming and what we built.\",\n  authors: [{ name: 'Gaurav Verma', url: 'https://mirelleinspo.com/authors/ri-mirelle' }],\n  alternates: { canonical: 'https://mirelleinspo.com/pinterest' },\n  openGraph: {\n    title: 'Pinterest Predicts: Nails Edition - Monthly Trend Forecasts',\n    description:\n      \"What Pinterest predicts will trend next for nails, and what we built around it. Updated monthly.\",\n    url: 'https://mirelleinspo.com/pinterest',\n    siteName: 'Mirellé Inspo',\n    type: 'website',\n    locale: 'en_US',\n    images: [{ url: '/logo.png', width: 250, height: 60, alt: 'Mirellé Inspo Pinterest Predicts' }],\n  },\n  twitter: {\n    card: 'summary_large_image',\n    title: 'Pinterest Predicts: Nails Edition - Monthly Trend Forecasts',\n    description: \"What Pinterest predicts will trend next for nails, and what we built around it.\",\n    creator: '@mirelleinspo',\n    site: '@mirelleinspo',\n  },\n  robots: {\n    index: true,\n    follow: true,\n    googleBot: { index: true, follow: true, 'max-video-preview': -1, 'max-image-preview': 'large', 'max-snippet': -1 },\n  },\n};\n\ninterface PageProps {\n  searchParams: Promise<{ page?: string }>;\n}\n\nexport default async function PinterestIndexPage({ searchParams }: PageProps) {\n  const params = await searchParams;\n  const currentPage = Number(params.page) || 1;\n  const postsPerPage = 12;\n\n  const allReports = await getAllPinterestReports();\n  const { reports, totalPages } = await getPaginatedPinterestReports(currentPage, postsPerPage);\n  const latest = allReports[0];\n\n  return (\n    <div className=\"min-h-screen bg-[#f9fafb]\">\n      <section className=\"py-24 bg-[#f9fafb] border-b border-gray-100\">\n        <div className=\"max-w-[700px] mx-auto px-6 text-center\">\n          <h1 className=\"text-5xl md:text-6xl mb-6\" style={{ fontFamily: 'Larken, serif' }}>\n            Pinterest Predicts: Nails Edition\n          </h1>\n          <p className=\"text-lg md:text-xl text-gray-500 italic\" style={{ fontFamily: 'Larken, Georgia, serif' }}>\n            &ldquo;What Pinterest predicts will trend next for nails - and what we built around it. Every month.&rdquo;\n          </p>\n        </div>\n      </section>\n\n      {latest && (\n        <section className=\"py-12 border-b border-gray-100\">\n          <div className=\"max-w-[700px] mx-auto px-6\">\n            <p className=\"text-sm uppercase tracking-wide text-gray-500 mb-3\">Latest edition</p>\n            <Link href={`/pinterest/${latest.slug}`} className=\"block group\">\n              <h2\n                className=\"text-2xl md:text-3xl group-hover:underline\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                {latest.title}\n              </h2>\n              {latest.excerpt && <p className=\"text-gray-600 mt-2\">{latest.excerpt}</p>}\n            </Link>\n          </div>\n        </section>\n      )}\n\n      <ReportsGrid reports={reports.map((r) => ({ ...r, category: `${r.month} ${r.year}` }))} />\n\n      {currentPage < totalPages && (\n        <NextPageButton href={`/pinterest?page=${currentPage + 1}`} />\n      )}\n    </div>\n  );\n}"

      "path": "src/components/ExitIntentPopup.tsx",
      "content": "'use client';\n\nimport { useState, useEffect } from 'react';\nimport { usePathname } from 'next/navigation';\nimport Image from 'next/image';\n\nconst STORAGE_KEY = 'mirelle_exit_popup_dismissed';\n\nfunction getCopy(pathname: string): { headline: string; sub: string } {\n  if (pathname.startsWith('/blog')) {\n    return {\n      headline: 'Trending nails, seasonal looks, and what\\'s next ',\n      sub: 'straight to your inbox.',\n    };\n  }\n  if (pathname.startsWith('/inspo')) {\n    return {\n      headline: 'New nail inspo drops weekly.',\n      sub: 'Be the first to see them.',\n    };\n  }\n  if (pathname.startsWith('/shop')) {\n    return {\n      headline: 'The right products for your nails,',\n      sub: 'curated and delivered to your inbox.',\n    };\n  }\n  if (pathname.startsWith('/work-nails')) {\n    return {\n      headline: 'Polished, professional, put-together.',\n      sub: 'Get work nail ideas that mean business.',\n    };\n  }\n  if (pathname.startsWith('/topics')) {\n    return {\n      headline: 'Trending nails, seasonal looks, and what\\'s next ',\n      sub: 'straight to your inbox.',\n    };\n  }\n  if (pathname.startsWith('/nail-faqs')) {\n    return {\n      headline: 'Get nail answers, tips, and expert picks',\n      sub: 'delivered weekly.',\n    };\n  }\n  // Fallback\n  return {\n    headline: 'Weekly nail trends, inspo, and picks',\n    sub: 'from the Mirellé edit.',\n  };\n}\n\nexport default function ExitIntentPopup() {\n  const pathname = usePathname();\n  const [visible, setVisible] = useState(false);\n  const [email, setEmail] = useState('');\n  const [status, setStatus] = useState<'idle' | 'loading' | 'success' | 'error'>('idle');\n\n  useEffect(() => {\n    // Don't show if already dismissed this session\n    if (sessionStorage.getItem(STORAGE_KEY)) return;\n\n    let triggered = false;\n\n    const handleMouseLeave = (e: MouseEvent) => {\n      // Trigger when mouse moves toward top of viewport (exit intent)\n      if (triggered) return;\n      if (e.clientY <= 20) {\n        triggered = true;\n        setVisible(true);\n      }\n    };\n\n    // Mobile fallback  show after 3 minutes of inactivity\n    let inactivityTimer: ReturnType<typeof setTimeout>;\n    const resetTimer = () => {\n      clearTimeout(inactivityTimer);\n      inactivityTimer = setTimeout(() => {\n        if (!triggered && !sessionStorage.getItem(STORAGE_KEY)) {\n          triggered = true;\n          setVisible(true);\n        }\n      }, 180000); // 3 minutes\n    };\n\n    document.addEventListener('mouseleave', handleMouseLeave);\n    document.addEventListener('touchstart', resetTimer);\n    document.addEventListener('scroll', resetTimer);\n    resetTimer();\n\n    return () => {\n      document.removeEventListener('mouseleave', handleMouseLeave);\n      document.removeEventListener('touchstart', resetTimer);\n      document.removeEventListener('scroll', resetTimer);\n      clearTimeout(inactivityTimer);\n    };\n  }, []);\n\n  const dismiss = () => {\n    sessionStorage.setItem(STORAGE_KEY, '1');\n    setVisible(false);\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setStatus('loading');\n\n    try {\n      const response = await fetch('/api/newsletter', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ email }),\n      });\n\n      if (response.ok) {\n        setStatus('success');\n        setEmail('');\n        sessionStorage.setItem(STORAGE_KEY, '1');\n        setTimeout(() => {\n          setVisible(false);\n        }, 2500);\n      } else {\n        setStatus('error');\n      }\n    } catch {\n      setStatus('error');\n    }\n  };\n\n  if (!visible) return null;\n\n  const copy = getCopy(pathname);\n\n  return (\n    <>\n      {/* Backdrop */}\n      <div\n        className=\"fixed inset-0 bg-black/40 z-[998] backdrop-blur-sm\"\n        onClick={dismiss}\n      />\n\n      {/* Popup */}\n      <div className=\"fixed inset-0 z-[999] flex items-center justify-center px-4\">\n        <div className=\"bg-background w-full max-w-md relative\">\n\n          {/* Close button */}\n          <button\n            onClick={dismiss}\n            aria-label=\"Close\"\n            className=\"absolute top-4 right-4 text-foreground/40 hover:text-foreground transition-colors\"\n          >\n            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" strokeWidth={1.5}>\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n            </svg>\n          </button>\n\n          <div className=\"px-10 py-12 text-center\">\n            {/* Logo */}\n            <div className=\"flex justify-center mb-6\">\n              <Image\n                src=\"/logo.png\"\n                alt=\"Mirellé\"\n                width={48}\n                height={48}\n                className=\"object-contain\"\n              />\n            </div>\n\n            {/* Copy */}\n            {status === 'success' ? (\n              <div className=\"py-4\">\n                <p className=\"font-heading text-2xl text-foreground mb-2\">You're in.</p>\n                <p className=\"font-ui text-sm text-gray-500\">Check your inbox soon.</p>\n              </div>\n            ) : (\n              <>\n                <p className=\"font-heading text-2xl md:text-3xl text-foreground leading-snug mb-1\">\n                  {copy.headline}\n                </p>\n                <p className=\"font-heading text-2xl md:text-3xl text-foreground leading-snug mb-8\">\n                  {copy.sub}\n                </p>\n\n                <form onSubmit={handleSubmit} className=\"flex flex-col gap-3\">\n                  <input\n                    type=\"email\"\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    placeholder=\"Your email address\"\n                    required\n                    className=\"w-full px-5 py-3 border border-gray-300 font-ui text-sm focus:outline-none focus:ring-2 focus:ring-foreground bg-background\"\n                  />\n                  <button\n                    type=\"submit\"\n                    disabled={status === 'loading'}\n                    className=\"w-full bg-foreground text-background px-6 py-3 font-ui text-sm uppercase tracking-widest hover:opacity-80 transition-opacity disabled:opacity-50\"\n                  >\n                    {status === 'loading' ? 'JOINING...' : \"DON'T LEAVE ME OUT\"}\n                  </button>\n                </form>\n\n                {status === 'error' && (\n                  <p className=\"text-red-600 font-ui text-xs mt-3\">Something went wrong. Try again.</p>\n                )}\n\n                <button\n                  onClick={dismiss}\n                  className=\"mt-4 font-ui text-xs text-gray-400 hover:text-gray-600 transition-colors uppercase tracking-wide\"\n                >\n                  No thanks\n                </button>\n              </>\n            )}\n          </div>\n        </div>\n      </div>\n    </>\n  );\n}"

      "path": "src/components/inspo/InspoClient.tsx",
      "content": "// src/components/Inspo/InspoClient.tsx\n'use client';\n\nimport { useState, useRef, useEffect } from 'react';\nimport Link from 'next/link';\nimport Image from 'next/image';\nimport Breadcrumbs from '@/components/Breadcrumbs';\nimport type { DesignData, DesignImage } from '@/types/inspo';\n\ninterface InspoClientProps {\n  designData: DesignData;\n  initialImages: DesignImage[];\n  relatedDesigns: DesignData[];\n  breadcrumbItems: Array<{ label: string; href: string }>;\n}\n\nexport default function InspoClient({ designData, initialImages, relatedDesigns, breadcrumbItems }: InspoClientProps) {\n  const [selectedImage, setSelectedImage] = useState<DesignImage | null>(null);\n  const [filter, setFilter] = useState<'all' | 'premium'>('all');\n  const [sortBy, setSortBy] = useState<'trending' | 'newest' | 'popular'>('trending');\n  const [displayCount, setDisplayCount] = useState(20);\n  const [likedImages, setLikedImages] = useState<Set<string>>(new Set());\n  const [savedImages, setSavedImages] = useState<Set<string>>(new Set());\n  const [aboutOpen, setAboutOpen] = useState(false);\n  const loadMoreRef = useRef<HTMLDivElement>(null);\n\n  const filteredImages = filter === 'premium' ? initialImages.filter(img => img.isPremium) : initialImages;\n  const sortedImages = [...filteredImages].sort((a, b) => {\n    if (sortBy === 'popular') return (likedImages.has(b.id) ? 1 : 0) - (likedImages.has(a.id) ? 1 : 0);\n    return 0;\n  });\n  const displayedImages = sortedImages.slice(0, displayCount);\n  const hasMore = displayCount < sortedImages.length;\n\n  // Mid-content ad  inject after 50% of displayed images\n  const midPoint = Math.floor(displayedImages.length / 2);\n\n  useEffect(() => {\n    const observer = new IntersectionObserver(\n      (entries) => { if (entries[0].isIntersecting && hasMore) setDisplayCount(prev => prev + 20); },\n      { threshold: 0.1 }\n    );\n    if (loadMoreRef.current) observer.observe(loadMoreRef.current);\n    return () => observer.disconnect();\n  }, [hasMore]);\n\n  useEffect(() => {\n    if (!selectedImage) return;\n    const handleKey = (e: KeyboardEvent) => {\n      if (e.key === 'Escape') { setSelectedImage(null); return; }\n      const ci = displayedImages.findIndex(img => img.id === selectedImage.id);\n      if (e.key === 'ArrowLeft') setSelectedImage(displayedImages[ci > 0 ? ci - 1 : displayedImages.length - 1]);\n      if (e.key === 'ArrowRight') setSelectedImage(displayedImages[ci < displayedImages.length - 1 ? ci + 1 : 0]);\n    };\n    window.addEventListener('keydown', handleKey);\n    document.body.style.overflow = 'hidden';\n    return () => { window.removeEventListener('keydown', handleKey); document.body.style.overflow = 'unset'; };\n  }, [selectedImage, displayedImages]);\n\n  useEffect(() => {\n    if (!selectedImage) return;\n    let startX = 0;\n    const onStart = (e: TouchEvent) => { startX = e.changedTouches[0].screenX; };\n    const onEnd = (e: TouchEvent) => {\n      const diff = startX - e.changedTouches[0].screenX;\n      const ci = displayedImages.findIndex(img => img.id === selectedImage.id);\n      if (diff > 50) setSelectedImage(displayedImages[ci < displayedImages.length - 1 ? ci + 1 : 0]);\n      if (diff < -50) setSelectedImage(displayedImages[ci > 0 ? ci - 1 : displayedImages.length - 1]);\n    };\n    window.addEventListener('touchstart', onStart);\n    window.addEventListener('touchend', onEnd);\n    return () => { window.removeEventListener('touchstart', onStart); window.removeEventListener('touchend', onEnd); };\n  }, [selectedImage, displayedImages]);\n\n  const handleLike = (id: string) => setLikedImages(prev => { const s = new Set(prev); s.has(id) ? s.delete(id) : s.add(id); return s; });\n  const handleSave = (id: string) => setSavedImages(prev => { const s = new Set(prev); s.has(id) ? s.delete(id) : s.add(id); return s; });\n  const handleShare = async () => {\n    if (navigator.share) { try { await navigator.share({ title: designData.displayName, text: designData.description, url: window.location.href }); } catch {} }\n    else { navigator.clipboard.writeText(window.location.href); alert('Link copied!'); }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-cyan-50\">\n      {/* Breadcrumbs */}\n      <div className=\"bg-white border-b border-gray-200 shadow-sm\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4\">\n          <Breadcrumbs items={breadcrumbItems} currentPage={designData.displayName} />\n        </div>\n      </div>\n\n      {/* Hero */}\n      <section className=\"relative overflow-hidden\">\n        <div className=\"relative h-[60vh] md:h-[70vh] min-h-[500px]\">\n          {designData.heroImage.startsWith('/') ? (\n            <Image src={designData.heroImage} alt={`${designData.displayName} nail designs inspiration`} fill priority className=\"object-cover\" sizes=\"100vw\" />\n          ) : (\n            <div className=\"absolute inset-0 bg-cover bg-center\" style={{ backgroundImage: `url(${designData.heroImage})` }} />\n          )}\n          <div className=\"absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/80\" />\n          <div className=\"relative h-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col justify-center text-white\">\n            <div className=\"inline-flex w-fit items-center gap-2 bg-white/10 backdrop-blur-md border border-white/30 px-5 py-2 mb-6 text-sm font-semibold uppercase tracking-wider rounded-full\">\n              <span>{designData.category}</span><span>•</span><span>{designData.year}</span>\n            </div>\n            <h1 className=\"font-display text-5xl md:text-6xl lg:text-7xl font-bold mb-6 tracking-tight\">{designData.displayName}</h1>\n            <p className=\"text-xl md:text-2xl text-white/90 mb-8 max-w-3xl font-light\">{designData.description}</p>\n            <div className=\"flex gap-4 mb-8 text-4xl\">\n              {designData.emojis.map((emoji, i) => <span key={i} className=\"animate-bounce\" style={{ animationDelay: `${i * 0.1}s` }}>{emoji}</span>)}\n            </div>\n            {designData.tldr && (\n              <div className=\"bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 max-w-2xl\">\n                <h3 className=\"text-lg font-semibold mb-4 text-white flex items-center gap-2\"><span className=\"text-2xl\">✨</span>Quick Overview</h3>\n                <ul className=\"space-y-3 text-white/90\">\n                  {designData.tldr.summary.map((item, i) => (\n                    <li key={i} className=\"flex items-start gap-3\"><span className=\"text-cyan-300 mt-1 flex-shrink-0\">✓</span><span className=\"text-sm md:text-base\">{item}</span></li>\n                  ))}\n                </ul>\n              </div>\n            )}\n          </div>\n        </div>\n        <div className=\"absolute bottom-0 left-0 right-0\">\n          <svg className=\"w-full h-12 fill-white\" viewBox=\"0 0 1200 120\" preserveAspectRatio=\"none\">\n            <path d=\"M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z\" />\n          </svg>\n        </div>\n      </section>\n\n\n      {/* Sticky Action Bar */}\n      <section className=\"bg-white border-b border-gray-200 sticky top-0 z-40 shadow-sm\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3\">\n          <div className=\"flex items-center justify-between gap-4\">\n            <div className=\"flex items-center gap-3\">\n              <button onClick={() => handleLike('category')} className=\"flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-200 rounded-full font-medium hover:border-pink-400 hover:text-pink-600 transition-all\">\n                <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z\" /></svg>\n                <span className=\"hidden sm:inline\">Like</span>\n              </button>\n              <button onClick={() => handleSave('category')} className=\"flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-200 rounded-full font-medium hover:border-accent/50 hover:text-accent/80 transition-all\">\n                <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z\" /></svg>\n                <span className=\"hidden sm:inline\">Save</span>\n              </button>\n              <button onClick={handleShare} className=\"flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-200 rounded-full font-medium hover:border-blue-400 hover:text-blue-600 transition-all\">\n                <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z\" /></svg>\n                <span className=\"hidden sm:inline\">Share</span>\n              </button>\n            </div>\n            <div className=\"text-sm text-gray-600 font-medium\">{displayedImages.length} of {sortedImages.length} designs</div>\n          </div>\n        </div>\n      </section>\n\n      {/* Filter & Sort */}\n      <section className=\"bg-white border-b border-gray-200 py-4\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n            <div className=\"flex flex-wrap gap-3\">\n              <button onClick={() => setFilter('all')} className={`px-5 py-2 rounded-full font-medium transition-all duration-300 ${filter === 'all' ? 'bg-accent text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}`}>All ({initialImages.length})</button>\n              <button onClick={() => setFilter('premium')} className={`px-5 py-2 rounded-full font-medium transition-all duration-300 inline-flex items-center gap-2 ${filter === 'premium' ? 'bg-accent text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}`}>\n                <span className=\"text-yellow-500\">⭐</span>Premium ({initialImages.filter(img => img.isPremium).length})\n              </button>\n            </div>\n            <select value={sortBy} onChange={(e) => setSortBy(e.target.value as any)} className=\"px-4 py-2 border border-gray-300 rounded-full text-sm font-medium bg-white cursor-pointer\">\n              <option value=\"trending\">🔥 Trending</option>\n              <option value=\"newest\">🆕 Newest</option>\n              <option value=\"popular\">💖 Most Liked</option>\n            </select>\n          </div>\n        </div>\n      </section>\n\n      {/* Gallery */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12\">\n        {displayedImages.length === 0 ? (\n          <div className=\"text-center py-20\">\n            <div className=\"text-6xl mb-4\">🎨</div>\n            <h3 className=\"text-2xl font-bold text-gray-900 mb-2\">No designs available yet</h3>\n            <p className=\"text-gray-500 text-lg mb-6\">We're adding amazing {designData.displayName.toLowerCase()} soon!</p>\n            <Link href=\"/inspo\" className=\"inline-flex items-center gap-2 bg-accent text-white px-6 py-3 rounded-full font-semibold hover:opacity-90 transition-opacity\">\n              Browse All Categories <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 5l7 7-7 7\" /></svg>\n            </Link>\n          </div>\n        ) : (\n          <>\n            <div className=\"columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4\">\n              {displayedImages.map((image, idx) => (\n                <>\n                  \n                  <div key={image.id} className=\"break-inside-avoid mb-4\">\n                    <div className=\"group relative overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 bg-white\">\n                      <button onClick={() => setSelectedImage(image)} className=\"w-full\">\n                        <div className=\"relative\">\n                          <Image src={image.url} alt={image.alt} width={400} height={600} className=\"w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-500\" sizes=\"(max-width: 768px) 50vw, (max-width: 1200px) 33vw, 25vw\" />\n                          <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300\">\n                            <div className=\"absolute bottom-0 left-0 right-0 p-4\"><p className=\"text-white text-sm font-medium line-clamp-3\">{image.alt}</p></div>\n                          </div>\n                          {image.isPremium && <div className=\"absolute top-3 right-3 bg-gradient-to-r from-yellow-400 to-orange-400 text-yellow-900 text-xs font-bold px-3 py-1.5 rounded-full shadow-lg\">⭐ PRO</div>}\n                          <div className=\"absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300\">\n                            <span className=\"bg-white text-accent px-4 py-2 rounded-full text-sm font-bold shadow-lg\">View Full</span>\n                          </div>\n                        </div>\n                      </button>\n                      <div className=\"flex items-center justify-between p-3 bg-white\">\n                        <button onClick={(e) => { e.stopPropagation(); handleLike(image.id); }} className={`flex items-center gap-1 text-sm font-medium transition-colors ${likedImages.has(image.id) ? 'text-pink-600' : 'text-gray-600 hover:text-pink-600'}`}>\n                          <svg className={`w-5 h-5 ${likedImages.has(image.id) ? 'fill-current' : ''}`} fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z\" /></svg>\n                        </button>\n                        <button onClick={(e) => { e.stopPropagation(); handleSave(image.id); }} className={`flex items-center gap-1 text-sm font-medium transition-colors ${savedImages.has(image.id) ? 'text-accent/80' : 'text-gray-600 hover:text-accent/80'}`}>\n                          <svg className={`w-5 h-5 ${savedImages.has(image.id) ? 'fill-current' : ''}`} fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z\" /></svg>\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                </>\n              ))}\n            </div>\n\n            {hasMore && (\n              <div ref={loadMoreRef} className=\"py-12 text-center\">\n                <div className=\"inline-flex items-center gap-2 text-gray-600\">\n                  <svg className=\"animate-spin w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\"><circle className=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" strokeWidth=\"4\" /><path className=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\" /></svg>\n                  Loading more designs...\n                </div>\n              </div>\n            )}\n            {!hasMore && sortedImages.length > 0 && (\n              <div className=\"text-center py-12\">\n                <p className=\"text-gray-600 mb-4\">You've seen all {sortedImages.length} designs! 🎉</p>\n                <button onClick={() => window.scrollTo({ top: 0, behavior: 'smooth' })} className=\"inline-flex items-center gap-2 px-6 py-3 bg-gray-200 text-gray-700 rounded-full font-semibold hover:bg-gray-300 transition-colors\">Back to Top ↑</button>\n              </div>\n            )}\n          </>\n        )}\n      </section>\n\n      {/* About */}\n      <section className=\"py-16 bg-white\">\n        <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <details open={aboutOpen} onToggle={(e: any) => setAboutOpen(e.target.open)} className=\"group bg-gradient-to-br from-slate-50 to-blue-50 rounded-3xl shadow-lg overflow-hidden border border-gray-100\">\n            <summary className=\"cursor-pointer px-8 py-6 flex justify-between items-center hover:bg-white/50 transition-colors\">\n              <div className=\"flex items-center gap-4\">\n                <div className=\"w-12 h-12 bg-accent/20 rounded-xl flex items-center justify-center\"><span className=\"text-2xl\">💡</span></div>\n                <div>\n                  <h2 className=\"font-display text-2xl font-bold text-gray-900\">About {designData.displayName}</h2>\n                  <p className=\"text-sm text-gray-600\">Everything you need to know about this style</p>\n                </div>\n              </div>\n              <svg className=\"w-6 h-6 text-accent/80 transform group-open:rotate-180 transition-transform\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M19 9l-7 7-7-7\" /></svg>\n            </summary>\n            <div className=\"px-8 pb-8 space-y-6 text-gray-700 leading-relaxed\">\n              <p className=\"text-lg font-medium text-gray-900\">{designData.description}</p>\n              <p>{designData.displayName} combine timeless elegance with modern nail art techniques, working beautifully on all nail lengths and shapes.</p>\n              {designData.perfectFor?.length && (\n                <p><strong>Perfect for:</strong> {designData.perfectFor.join(', ')}.</p>\n              )}\n            </div>\n          </details>\n        </div>\n      </section>\n\n      {/* Style Tips */}\n      {designData.styleGuide && designData.styleGuide.length > 0 && (\n        <section className=\"py-16 bg-gradient-to-br from-slate-50 to-blue-50\">\n          <div className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div className=\"text-center mb-12\">\n              <h2 className=\"text-4xl font-display font-bold text-gray-900 mb-4\">Pro Tips for {designData.displayName}</h2>\n              <p className=\"text-xl text-gray-600\">Expert advice to achieve the perfect look</p>\n            </div>\n            <div className=\"grid md:grid-cols-3 gap-6\">\n              {designData.styleGuide.map((tip, index) => (\n                <div key={index} className=\"bg-white rounded-2xl p-6 shadow-lg border border-gray-100\">\n                  <div className=\"w-14 h-14 bg-gradient-to-br from-pink-100 to-purple-100 rounded-xl flex items-center justify-center mb-4\">\n                    <span className=\"text-3xl\">{['💡', '✨', '🎨', '💅', '🌟', '⭐'][index % 6]}</span>\n                  </div>\n                  <h3 className=\"font-bold text-lg text-gray-900 mb-2\">Tip #{index + 1}</h3>\n                  <p className=\"text-gray-600 leading-relaxed\">{tip}</p>\n                </div>\n              ))}\n            </div>\n          </div>\n        </section>\n      )}\n\n      {/* FAQ */}\n      <section className=\"py-16 bg-white\">\n        <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center mb-12\">\n            <h2 className=\"text-4xl font-display font-bold text-gray-900 mb-4\">Frequently Asked Questions</h2>\n          </div>\n          <div className=\"space-y-4\">\n            {[\n              { q: `What nail shapes work best for ${designData.displayName.toLowerCase()}?`, a: `Almond, oval, and square shapes all work beautifully.` },\n              { q: `How long do ${designData.displayName.toLowerCase()} last?`, a: `With gel polish, typically 2-3 weeks. Regular polish lasts 5-7 days.` },\n              { q: `Can I create ${designData.displayName.toLowerCase()} at home?`, a: `Yes, with the right tools and practice. Start simple and work up to complex designs.` },\n              { q: `How much does it cost at a salon?`, a: `Typically $40-80 for regular polish, $60-100 for gel, $80-150+ for nail art.` },\n            ].map((faq, index) => (\n              <details key={index} className=\"group bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:border-accent/40 transition-colors\">\n                <summary className=\"cursor-pointer px-6 py-5 flex justify-between items-center\">\n                  <h3 className=\"font-semibold text-gray-900 pr-4 text-lg\">{faq.q}</h3>\n                  <svg className=\"w-5 h-5 text-accent/80 transform group-open:rotate-45 transition-transform flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M12 4v16m8-8H4\" /></svg>\n                </summary>\n                <div className=\"px-6 pb-5 text-gray-600 leading-relaxed\"><p>{faq.a}</p></div>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* Related */}\n      {relatedDesigns.length > 0 && (\n        <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20\">\n          <h2 className=\"text-4xl font-display font-bold text-gray-900 mb-12 text-center\">You Might Also Love</h2>\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n            {relatedDesigns.map((design) => (\n              <Link key={design.slug} href={`/inspo/${design.slug}`} className=\"group relative bg-white rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden\">\n                <div className=\"relative h-80 overflow-hidden\">\n                  {design.heroImage.startsWith('/') ? (\n                    <Image src={design.heroImage} alt={`${design.displayName} nail design inspiration`} fill className=\"object-cover transform group-hover:scale-110 transition-transform duration-700\" sizes=\"(max-width: 768px) 100vw, 33vw\" />\n                  ) : (\n                    <div className=\"absolute inset-0 bg-cover bg-center transform group-hover:scale-110 transition-transform duration-700\" style={{ backgroundImage: `url(${design.heroImage})` }} />\n                  )}\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent\" />\n                  <div className=\"absolute bottom-0 left-0 right-0 p-6 text-white\">\n                    <span className=\"inline-block px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-xs font-semibold uppercase mb-3\">{design.category}</span>\n                    <h3 className=\"text-2xl font-display font-bold mb-2 group-hover:text-cyan-300 transition-colors\">{design.displayName}</h3>\n                    <p className=\"text-white/90 text-sm mb-3 line-clamp-2\">{design.description}</p>\n                    <span className=\"inline-flex items-center text-sm font-semibold border-b-2 border-transparent group-hover:border-cyan-300 transition-all\">View Gallery →</span>\n                  </div>\n                </div>\n              </Link>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Lightbox */}\n      {selectedImage &&
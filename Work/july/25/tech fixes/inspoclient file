/20'}`}>\n                    <span className=\"flex items-center gap-2\">\n                      <svg className=\"w-5 h-5\" fill={likedImages.has(selectedImage.id) ? 'currentColor' : 'none'} stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z\" /></svg>\n                      {likedImages.has(selectedImage.id) ? 'Liked' : 'Like'}\n                    </span>\n                  </button>\n                  <button onClick={(e) => { e.stopPropagation(); handleSave(selectedImage.id); }} className={`px-6 py-3 rounded-full font-semibold transition-all shadow-xl ${savedImages.has(selectedImage.id) ? 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white' : 'bg-white/10 border border-white/20 text-white hover:bg-white/20'}`}>\n                    <span className=\"flex items-center gap-2\">\n                      <svg className=\"w-5 h-5\" fill={savedImages.has(selectedImage.id) ? 'currentColor' : 'none'} stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z\" /></svg>\n                      {savedImages.has(selectedImage.id) ? 'Saved' : 'Save'}\n                    </span>\n                  </button>\n                  {selectedImage.pinterestUrl && (\n                    <a href={selectedImage.pinterestUrl} target=\"_blank\" rel=\"noopener noreferrer\" onClick={(e) => e.stopPropagation()} className=\"px-6 py-3 rounded-full font-semibold bg-white/10 border border-white/20 text-white hover:bg-white/20 transition-all shadow-xl\">\n                      <span className=\"flex items-center gap-2\">\n                        <svg className=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z\"/></svg>\n                        Pin\n                      </span>\n                    </a>\n                  )}\n                </div>\n              </div>\n              <div className=\"mt-6 pt-6 border-t border-white/10 flex items-center justify-center gap-6 text-white/60 text-sm\">\n                <span className=\"flex items-center gap-2\"><kbd className=\"px-2 py-1 bg-white/10 rounded text-xs\">←</kbd><kbd className=\"px-2 py-1 bg-white/10 rounded text-xs\">→</kbd>Navigate</span>\n                <span className=\"flex items-center gap-2\"><kbd className=\"px-3 py-1 bg-white/10 rounded text-xs\">ESC</kbd>Close</span>\n              </div>\n            </div>\n          </div>\n          <style jsx>{`\n            @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }\n            @keyframes scaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }\n          `}</style>\n        </div>\n      )}\n    </div>\n  );\n}"

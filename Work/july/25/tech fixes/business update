      "content": "// src/app/business/[country]/[state]/[clientType]/page.tsx\nimport { Metadata } from 'next';\nimport { notFound } from 'next/navigation';\nimport Link from 'next/link';\nimport {\n  getBusinessCountries,\n  getBusinessStates,\n  getBusinessClientTypes,\n  getBusinessPostsByClientType,\n} from '@/lib/business';\nimport { ClientType } from '@/types/business';\n\n\n\nconst CLIENT_TYPE_LABELS: Record<ClientType, string> = {\n  influencer:  'Influencer',\n  brand:       'Brand',\n  'nail-tech': 'Nail Tech',\n  salon:       'Salon',\n};\n\nexport async function generateStaticParams() {\n  const countries = await getBusinessCountries();\n  const params: { country: string; state: string; clientType: string }[] = [];\n\n  for (const { countrySlug } of countries) {\n    const states = await getBusinessStates(countrySlug);\n    for (const { stateSlug } of states) {\n      const types = await getBusinessClientTypes(countrySlug, stateSlug);\n      for (const ct of types) {\n        params.push({ country: countrySlug, state: stateSlug, clientType: ct });\n      }\n    }\n  }\n  return params;\n}\n\n\nexport async function generateMetadata({ params }: { params: Promise<{ country: string; state: string; clientType: string }> }): Promise<Metadata> {\n  const { country, state, clientType } = await params;\n  const countryName = country.replace(/-/g, ' ').replace(/\\b\\w/g, (l) => l.toUpperCase());\n  const stateName = state.replace(/-/g, ' ').replace(/\\b\\w/g, (l) => l.toUpperCase());\n  const clientTypeName = clientType.replace(/-/g, ' ').replace(/\\b\\w/g, (l) => l.toUpperCase());\n  const canonicalUrl = `https://mirelleinspo.com/business/${country}/${state}/${clientType}`;\n \n  return {\n    title: `${clientTypeName} Nail Market  ${stateName}, ${countryName}`,\n    description: `Nail industry insights for ${clientTypeName.toLowerCase()} businesses in ${stateName}, ${countryName}. Data-driven research from Mirellé Inspo.`,\n    authors: [{ name: 'Gaurav Verma', url: 'https://mirelleinspo.com/authors/ri-mirelle' }],\n    creator: 'Gaurav Verma',\n    alternates: { canonical: canonicalUrl },\n    openGraph: {\n      title: `${clientTypeName} Nail Market  ${stateName}, ${countryName}`,\n      description: `Nail industry insights for ${clientTypeName.toLowerCase()} businesses in ${stateName}, ${countryName}.`,\n      url: canonicalUrl,\n      siteName: 'Mirellé Inspo',\n      type: 'website',\n      locale: 'en_US',\n      images: [{ url: '/logo.png', width: 250, height: 60, alt: `Mirellé Inspo  ${clientTypeName} Nail Market` }],\n    },\n    twitter: {\n      card: 'summary_large_image',\n      title: `${clientTypeName} Nail Market  ${stateName}, ${countryName}`,\n      description: `Nail industry insights for ${clientTypeName.toLowerCase()} businesses in ${stateName}.`,\n      creator: '@mirelleinspo',\n      site: '@mirelleinspo',\n      images: ['/logo.png'],\n    },\n    robots: {\n      index: true,\n      follow: true,\n      googleBot: { index: true, follow: true, 'max-image-preview': 'large', 'max-snippet': -1 },\n    },\n  };\n}\n \n\nexport default async function ClientTypePage(\n  { params }: { params: Promise<{ country: string; state: string; clientType: string }> }\n) {\n  const { country, state, clientType: clientTypeParam } = await params;\n\n  const validTypes: ClientType[] = ['influencer', 'brand', 'nail-tech', 'salon'];\n  if (!validTypes.includes(clientTypeParam as ClientType)) notFound();\n\n  const clientType = clientTypeParam as ClientType;\n\n  const [countries, states, posts] = await Promise.all([\n    getBusinessCountries(),\n    getBusinessStates(country),\n    getBusinessPostsByClientType(country, state, clientType),\n  ]);\n\n  if (!posts.length) notFound();\n\n  const countryMatch = countries.find(c => c.countrySlug === country);\n  const stateMatch   = states.find(s => s.stateSlug === state);\n  const label        = CLIENT_TYPE_LABELS[clientType];\n\n  const breadcrumbSchema = {\n    '@context':
// src/components/Inspo/SubmitArtSection.tsx
'use client';

import { useState } from 'react';

const SUBMIT_EMAIL = 'editor@mirelleinspo.com';

export default function SubmitArtSection() {
  const [name, setName] = useState('');
  const [social, setSocial] = useState('');

  const buildMailto = () => {
    const subject = encodeURIComponent('Nail Art Submission  Feature Request');
    const greeting = name ? `Hi! I'm ${name}.` : `Hi!`;
    const socialLine = social
      ? `My social handle to link back: ${social}`
      : `My social handle to link back: (add your Instagram/TikTok/Pinterest handle here)`;

    const body = encodeURIComponent(
      `${greeting}\n\nI'd love to submit my nail art for a feature on Mirellé.\n\n${socialLine}\n\n(Please attach 1–3 photos of your nail art to this email before sending.)\n\nThanks!`
    );

    return `mailto:${SUBMIT_EMAIL}?subject=${subject}&body=${body}`;
  };

  return (
    <section className="py-16 md:py-20 bg-white border-t border-[#252220]/10">
      <div className="max-w-3xl mx-auto px-6 text-center">
        <span
          className="inline-block px-4 py-1.5 rounded-full bg-[#252220]/5 text-[#252220]/70 mb-5"
          style={{ fontFamily: 'General Sans, sans-serif', fontSize: '12px', letterSpacing: '0.05em' }}
        >
          COMMUNITY SPOTLIGHT
        </span>

        <h2
          className="text-[#252220] mb-4"
          style={{ fontFamily: 'Larken, serif', fontSize: '34px', lineHeight: 1.15 }}
        >
          Submit your nail art & get featured
        </h2>

        <p
          className="text-[#252220]/70 mb-8 max-w-xl mx-auto"
          style={{ fontFamily: 'Crimson Text, serif', fontSize: '17px', lineHeight: 1.6 }}
        >
          Show off your manicure to thousands of nail lovers. Share a few photos and your
          social handle  we'll credit and link back to you if we feature your design.
        </p>

        {/* Lightweight inputs just personalize the email draft; actual submission happens via mail client */}
        <div className="flex flex-col sm:flex-row gap-3 max-w-md mx-auto mb-3">
          <input
            type="text"
            value={name}
            onChange={(e) => setName(e.target.value)}
            placeholder="Your name (optional)"
            className="flex-1 px-4 py-3 rounded-xl border border-[#252220]/15 bg-[#f9fafb] text-[#252220] placeholder:text-[#252220]/40 focus:outline-none focus:border-[#252220]/40 transition-colors"
            style={{ fontFamily: 'General Sans, sans-serif', fontSize: '14px' }}
          />
          <input
            type="text"
            value={social}
            onChange={(e) => setSocial(e.target.value)}
            placeholder="@yourhandle (Instagram, TikTok...)"
            className="flex-1 px-4 py-3 rounded-xl border border-[#252220]/15 bg-[#f9fafb] text-[#252220] placeholder:text-[#252220]/40 focus:outline-none focus:border-[#252220]/40 transition-colors"
            style={{ fontFamily: 'General Sans, sans-serif', fontSize: '14px' }}
          />
        </div>

        <a
          href={buildMailto()}
          className="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[#252220] text-white hover:bg-[#252220]/90 active:scale-95 transition-all duration-200 max-w-full text-center whitespace-normal"
          style={{ fontFamily: 'General Sans, sans-serif', fontSize: '14px', fontWeight: 500, lineHeight: 1.3 }}
        >
          <svg className="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Email Your Photos</span>
        </a>

        <p
          className="text-[#252220]/45 mt-4"
          style={{ fontFamily: 'General Sans, sans-serif', fontSize: '12.5px' }}
        >
          Opens your email app, addressed to {SUBMIT_EMAIL}. Attach your photos before sending 
          don't forget your social handle so we can link back to you.
        </p>
      </div>
    </section>
  );
}

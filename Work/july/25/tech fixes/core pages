      "path": "src/app/about/page.tsx",
      "content": "import { Metadata } from 'next';\nimport Link from 'next/link';\n\nexport const dynamic = 'force-static'\nexport const revalidate = false\n\n\nexport const metadata: Metadata = {\n  title: 'About Mirellé Inspo  The Nail Publication Built on Research',\n  description:\n    'Mirellé Inspo is a research-driven nail editorial platform built by Jyotika Verma and Gaurav Verma. 20K+ monthly readers, 5M+ monthly Pinterest visitors.',\n  authors: [\n    { name: 'Jyotika Verma', url: 'https://mirelleinspo.com/authors/jyoti-mirelle' },\n    { name: 'Gaurav Verma', url: 'https://mirelleinspo.com/authors/ri-mirelle' },\n  ],\n  alternates: { canonical: 'https://mirelleinspo.com/about' },\n  openGraph: {\n    title: 'About Mirellé Inspo  The Nail Publication Built on Research',\n    description: 'Research-driven nail editorial built by two people who track trends, not follow them. 20K+ monthly readers, 5M+ monthly Pinterest visitors.',\n    url: 'https://mirelleinspo.com/about',\n    siteName: 'Mirellé Inspo',\n    type: 'website',\n    locale: 'en_US',\n    images: [{ url: '/logo.png', width: 250, height: 60, alt: 'Mirellé Inspo  About' }],\n  },\n  twitter: {\n    card: 'summary_large_image',\n    title: 'About Mirellé Inspo  The Nail Publication Built on Research',\n    description: 'Research-driven nail editorial. 20K+ monthly readers. 5M+ monthly Pinterest visitors.',\n    creator: '@mirelleinspo',\n    site: '@mirelleinspo',\n    images: ['/logo.png'],\n  },\n  robots: {\n    index: true,\n    follow: true,\n    googleBot: { index: true, follow: true, 'max-video-preview': -1, 'max-image-preview': 'large', 'max-snippet': -1 },\n  },\n};\n \n\nexport default function AboutPage() {\n  return (\n    <div className=\"min-h-screen bg-background\">\n\n      {/* Hero */}\n      <section className=\"py-24 border-b border-foreground/10\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n          <p className=\"font-ui text-sm uppercase tracking-wider text-foreground/50 mb-6\">\n            About Mirellé\n          </p>\n          <h1\n            className=\"font-heading text-5xl md:text-6xl text-foreground mb-8 leading-tight\"\n            style={{ fontFamily: 'Larken, Georgia, serif' }}\n          >\n            We are not nail technicians. We are researchers.\n          </h1>\n          <p\n            className=\"font-body text-xl text-foreground/70 leading-relaxed max-w-3xl\"\n            style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n          >\n            Mirellé exists because nail content online had a problem: most of it was trend-chasing without real understanding. Generic roundups, recycled aesthetics, no signal behind the noise. We built something different.\n          </p>\n        </div>\n      </section>\n\n      {/* What we built */}\n      <section className=\"py-20 border-b border-foreground/10\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n          <h2\n            className=\"font-heading text-4xl text-foreground mb-8\"\n            style={{ fontFamily: 'Larken, Georgia, serif' }}\n          >\n            What Mirellé is\n          </h2>\n          <div\n            className=\"font-body text-lg text-foreground/70 leading-relaxed space-y-6\"\n            style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n          >\n            <p>\n              Mirellé is a nail editorial platform built on research. We track Pinterest data, search signals, and market behavior to understand what people actually want from nail content and why certain trends move the way they do.\n            </p>\n            <p>\n              We cover the full nail ecosystem: brands, nail techs, home nail enthusiasts, salon culture, consumer behavior. We know what works, when, and why. That depth is what separates this from a standard beauty blog.\n            </p>\n            <p>\n              Our tagline is \"we curate so you don't have to.\" That's not a marketing line. It's a description of the work.\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* Team */}\n      <section className=\"py-20 border-b border-foreground/10\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n          <h2\n            className=\"font-heading text-4xl text-foreground mb-12\"\n            style={{ fontFamily: 'Larken, Georgia, serif' }}\n          >\n            The team\n          </h2>\n\n          <div className=\"grid md:grid-cols-2 gap-12\">\n            <div>\n              <p className=\"font-ui text-sm uppercase tracking-wider text-foreground/40 mb-3\">\n                Co-Founder\n              </p>\n              <h3\n                className=\"font-heading text-3xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                Ri\n              </h3>\n              <p\n                className=\"font-body text-base text-foreground/70 leading-relaxed mb-6\"\n                style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n              >\n                Ri runs the research side. Pinterest data, search trend analysis, market behavior, topic planning, and editorial direction. He handles business and brand content, trend reports, and technical SEO. He understands why something is trending before most people notice it has.\n              </p>\n              <Link\n                href=\"/authors/ri-mirelle\"\n                className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n              >\n                View profile\n              </Link>\n            </div>\n\n            <div>\n              <p className=\"font-ui text-sm uppercase tracking-wider text-foreground/40 mb-3\">\n                Co-Founder\n              </p>\n              <h3\n                className=\"font-heading text-3xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                Jyoti\n              </h3>\n              <p\n                className=\"font-body text-base text-foreground/70 leading-relaxed mb-6\"\n                style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n              >\n                Jyoti writes everything: blog posts, FAQs, work-nails content, spotlights, social copy. She manages Pinterest and the community. She's the reason the platform feels human. Every piece of content that goes live passes through her.\n              </p>\n              <Link\n                href=\"/authors/jyoti-mirelle\"\n                className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n              >\n                View profile\n              </Link>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* Stats */}\n      <section className=\"py-20 border-b border-foreground/10\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n          <p className=\"font-ui text-sm uppercase tracking-wider text-foreground/40 mb-12\">\n            By the numbers  under one year old\n          </p>\n          <div className=\"grid sm:grid-cols-2 md:grid-cols-4 gap-10\">\n            <div>\n              <div\n                className=\"font-heading text-5xl text-foreground mb-2\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                10K+\n              </div>\n              <p className=\"font-ui text-xs uppercase tracking-wide text-foreground/50\">\n                Monthly readers\n              </p>\n            </div>\n            <div>\n              <div\n                className=\"font-heading text-5xl text-foreground mb-2\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                1M\n              </div>\n              <p className=\"font-ui text-xs uppercase tracking-wide text-foreground/50\">\n                Monthly Pinterest visitors\n              </p>\n            </div>\n            <div>\n              <div\n                className=\"font-heading text-5xl text-foreground mb-2\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                63%\n              </div>\n              <p className=\"font-ui text-xs uppercase tracking-wide text-foreground/50\">\n                Engagement rate\n              </p>\n            </div>\n            <div>\n              <div\n                className=\"font-heading text-5xl text-foreground mb-2\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                60%\n              </div>\n              <p className=\"font-ui text-xs uppercase tracking-wide text-foreground/50\">\n                Organic search traffic\n              </p>\n            </div>\n          </div>\n\n          <div className=\"mt-12 pt-12 border-t border-foreground/10\">\n            <p className=\"font-ui text-sm uppercase tracking-wider text-foreground/40 mb-4\">\n              Top markets\n            </p>\n            <p\n              className=\"font-body text-base text-foreground/70\"\n              style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n            >\n              United States (47%), United Kingdom (8.5%), Canada (6.4%), Singapore, India, Australia\n            </p>\n            <p\n              className=\"font-body text-sm text-foreground/40 mt-3\"\n              style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n            >\n              Live since September 2024\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* CTA */}\n      <section className=\"py-20\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n          <h2\n            className=\"font-heading text-4xl text-foreground mb-6\"\n            style={{ fontFamily: 'Larken, Georgia, serif' }}\n          >\n            Work with us or follow along\n          </h2>\n          <p\n            className=\"font-body text-lg text-foreground/70 leading-relaxed mb-10 max-w-2xl\"\n            style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n          >\n            If you're a brand, salon, or nail tech interested in working with us, head to the partnerships page. If you just want the content, subscribe below.\n          </p>\n          <div className=\"flex flex-wrap gap-4\">\n            <Link\n              href=\"/work-with-us\"\n              className=\"inline-block bg-foreground text-background px-8 py-4 font-ui text-sm uppercase tracking-wider hover:opacity-90 transition-opacity\"\n            >\n              Work with us\n            </Link>\n            <Link\n              href=\"/subscribe\" \n              className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground self-center\"\n            >\n              Subscribe to the newsletter\n            </Link>\n          </div>\n        </div>\n      </section>\n\n    </div>\n  );\n}"

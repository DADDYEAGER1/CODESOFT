      "path": "src/app/privacy-policy/page.tsx",
      "content": "import { Metadata } from 'next';\nexport const dynamic = 'force-static'\nexport const revalidate = false\n\nexport const metadata: Metadata = {\n  title: 'Privacy Policy  How Mirellé Inspo Handles Your Data',\n  description: 'How Mirellé Inspo collects, uses, and protects your personal information. Read our full privacy policy.',\n  alternates: { canonical: 'https://mirelleinspo.com/privacy-policy' },\n  openGraph: {\n    title: 'Privacy Policy  How Mirellé Inspo Handles Your Data',\n    description: 'How Mirellé Inspo collects, uses, and protects your personal information.',\n    url: 'https://mirelleinspo.com/privacy-policy',\n    siteName: 'Mirellé Inspo',\n    type: 'website',\n    locale: 'en_US',\n    images: [{ url: '/logo.png', width: 250, height: 60, alt: 'Mirellé Inspo Privacy Policy' }],\n  },\n  twitter: {\n    card: 'summary',\n    title: 'Privacy Policy  How Mirellé Inspo Handles Your Data',\n    description: 'How Mirellé Inspo collects, uses, and protects your personal information.',\n    creator: '@mirelleinspo',\n    site: '@mirelleinspo',\n  },\n  robots: { index: true, follow: true },\n};\n\nexport default function PrivacyPage() {\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <section className=\"py-20\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n\n          <p className=\"font-ui text-sm uppercase tracking-wider text-foreground/40 mb-6\">\n            Legal\n          </p>\n          <h1\n            className=\"font-heading text-5xl text-foreground mb-4\"\n            style={{ fontFamily: 'Larken, Georgia, serif' }}\n          >\n            Privacy Policy\n          </h1>\n          <p\n            className=\"font-body text-sm text-foreground/40 mb-16\"\n            style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n          >\n            Effective Date: October 6, 2025\n          </p>\n\n          <div\n            className=\"font-body text-base text-foreground/70 leading-relaxed space-y-12\"\n            style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n          >\n            <p>\n              At Mirellé (mirelleinspo.com), we are committed to protecting your privacy and ensuring\n              transparency about how we collect, use, and safeguard your personal information. This Privacy\n              Policy explains our data practices and your rights regarding your information.\n            </p>\n\n            <div>\n              <h2\n                className=\"font-heading text-2xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                1. Information We Collect\n              </h2>\n              <h3\n                className=\"font-heading text-xl text-foreground mb-3\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                1.1 Information You Provide\n              </h3>\n              <p className=\"mb-4\">\n                We may collect personal information that you voluntarily provide when you subscribe to our\n                newsletter, submit comments or feedback, contact us via email or contact forms, or participate\n                in surveys or promotions.\n              </p>\n              <h3\n                className=\"font-heading text-xl text-foreground mb-3\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                1.2 Automatically Collected Information\n              </h3>\n              <p>\n                When you visit our website, we automatically collect certain technical information through\n                cookies and similar tracking technologies, including IP address and approximate geographic\n                location, browser type and version, device information, pages visited and navigation patterns,\n                referring website, and date and time of visits.\n              </p>\n            </div>\n\n            <div>\n              <h2\n                className=\"font-heading text-2xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                2. How We Use Your Information\n              </h2>\n              <p>\n                We use collected information to provide and improve our website, respond to inquiries, send\n                newsletter updates (with your consent), analyze traffic and content performance, personalize\n                content, display relevant advertisements, and comply with legal obligations.\n              </p>\n            </div>\n\n            <div>\n              <h2\n                className=\"font-heading text-2xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                3. Cookies and Tracking Technologies\n              </h2>\n              <p className=\"mb-4\">\n                Mirellé uses cookies, web beacons, and similar tracking technologies to enhance your browsing\n                experience and collect usage data. We use essential cookies for site functionality, analytics\n                cookies (including Google Analytics) to understand visitor behavior, advertising cookies for\n                relevant ad display, and functionality cookies to remember your preferences.\n              </p>\n              <p>\n                You can control cookies through your browser settings. Disabling cookies may affect site\n                functionality. To opt out of interest-based advertising, visit the Digital Advertising Alliance\n                or Network Advertising Initiative opt-out pages.\n              </p>\n            </div>\n\n            <div>\n              <h2\n                className=\"font-heading text-2xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                4. Third-Party Services and Data Sharing\n              </h2>\n              <h3\n                className=\"font-heading text-xl text-foreground mb-3\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                Mediavine Programmatic Advertising (Ver 1.1)\n              </h3>\n              <p className=\"mb-4\">\n                The Website works with Mediavine to manage third-party interest-based advertising appearing on\n                the Website. Mediavine serves content and advertisements when you visit the Website, which may\n                use first and third-party cookies. A cookie is a small text file which is sent to your computer\n                or mobile device (referred to in this policy as a &ldquo;device&rdquo;) by the web server so\n                that a website can remember some information about your browsing activity on the Website.\n              </p>\n              <p className=\"mb-4\">\n                First party cookies are created by the website that you are visiting. A third-party cookie is\n                frequently used in behavioral advertising and analytics and is created by a domain other than\n                the website you are visiting. Third-party cookies, tags, pixels, beacons and other similar\n                technologies (collectively, &ldquo;Tags&rdquo;) may be placed on the Website to monitor\n                interaction with advertising content and to target and optimize advertising. Each internet\n                browser has functionality so that you can block both first and third-party cookies and clear\n                your browser&apos;s cache. The &ldquo;help&rdquo; feature of the menu bar on most browsers will\n                tell you how to stop accepting new cookies, how to receive notification of new cookies, how to\n                disable existing cookies and how to clear your browser&apos;s cache. For more information about\n                cookies and how to disable them, you can consult the information at{' '}\n                <a\n                  href=\"https://www.allaboutcookies.org/manage-cookies/\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n                >\n                  All About Cookies\n                </a>.\n              </p>\n              <p className=\"mb-4\">\n                Without cookies you may not be able to take full advantage of the Website content and features.\n                Please note that rejecting cookies does not mean that you will no longer see ads when you visit\n                our Site. In the event you opt-out, you will still see non-personalized advertisements on the\n                Website.\n              </p>\n              <p className=\"mb-2\">\n                The Website collects the following data using a cookie when serving personalized ads:\n              </p>\n              <ul className=\"list-disc pl-6 mb-4\">\n                <li>IP Address</li>\n                <li>Operating System type</li>\n                <li>Operating System version</li>\n                <li>Device Type</li>\n                <li>Language of the website</li>\n                <li>Web browser type</li>\n                <li>Email (in hashed form)</li>\n              </ul>\n              <p className=\"mb-4\">\n                Mediavine Partners (companies listed below with whom Mediavine shares data) may also use this\n                data to link to other end user information the partner has independently collected to deliver\n                targeted advertisements. Mediavine Partners may also separately collect data about end users\n                from other sources, such as advertising IDs or pixels, and link that data to data collected\n                from Mediavine publishers in order to provide interest-based advertising across your online\n                experience, including devices, browsers and apps. This data includes usage data, cookie\n                information, device information, information about interactions between users and\n                advertisements and websites, geolocation data, traffic data, and information about a\n                visitor&apos;s referral source to a particular website. Mediavine Partners may also create\n                unique IDs to create audience segments, which are used to provide targeted advertising.\n              </p>\n              <p className=\"mb-4\">\n                If you would like more information about this practice and to know your choices to opt-in or\n                opt-out of this data collection, please visit{' '}\n                <a\n                  href=\"https://thenai.org/opt-out/\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n                >\n                  National Advertising Initiative opt out page\n                </a>. You may also visit{' '}\n                <a\n                  href=\"http://optout.aboutads.info/#/\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n                >\n                  Digital Advertising Alliance website\n                </a>{' '}\n                and{' '}\n                <a\n                  href=\"http://optout.networkadvertising.org/#\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n                >\n                  Network Advertising Initiative website\n                </a>{' '}\n                to learn more information about interest-based advertising. You may download the AppChoices app\n                at{' '}\n                <a\n                  href=\"https://youradchoices.com/appchoices\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n                >\n                  Digital Advertising Alliance&apos;s AppChoices app\n                </a>{' '}\n                to opt out in connection with mobile apps, or use the platform controls on your mobile device to\n                opt out.\n              </p>\n              <p className=\"mb-6\">\n                For specific information about Mediavine Partners, the data each collects and their data\n                collection and privacy policies, please visit{' '}\n                <a\n                  href=\"https://www.mediavine.com/ad-partners/\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n                >\n                  Mediavine Partners\n                </a>.\n              </p>\n\n              <h3\n                className=\"font-heading text-xl text-foreground mb-3\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                4.2 Google AdSense\n              </h3>\n              <p className=\"mb-6\">\n                We use Google AdSense to display advertisements. Google uses cookies to serve ads based on\n                your prior visits. You may opt out of personalized advertising via{' '}\n                <a\n                  href=\"https://www.google.com/settings/ads\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n                >\n                  Google Ads Settings\n                </a>{' '}\n                or{' '}\n                <a\n                  href=\"http://www.aboutads.info\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n                >\n                  aboutads.info\n                </a>.\n              </p>\n              <h3\n                className=\"font-heading text-xl text-foreground mb-3\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                4.3 Google Analytics\n              </h3>\n              <p className=\"mb-6\">\n                We use Google Analytics to analyze website traffic. You can opt out via the{' '}\n                <a\n                  href=\"https://tools.google.com/dlpage/gaoptout\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n                >\n                  Google Analytics Opt-out Browser Add-on\n                </a>.\n              </p>\n              <h3\n                className=\"font-heading text-xl text-foreground mb-3\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                4.4 Affiliate Partners\n              </h3>\n              <p className=\"mb-6\">\n                We participate in affiliate programs including Amazon Associates. When you click affiliate\n                links and make purchases, those third-party partners may collect transaction data governed by\n                their own privacy policies.\n              </p>\n              <h3\n                className=\"font-heading text-xl text-foreground mb-3\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                4.5 Email Service Providers\n              </h3>\n              <p className=\"mb-6\">\n                Newsletter subscribers have their email stored and processed by our email service provider.\n                You can unsubscribe at any time via the link in any email.\n              </p>\n              <h3\n                className=\"font-heading text-xl text-foreground mb-3\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                4.6 Social Media Platforms\n              </h3>\n              <p>\n                Our site includes social sharing features for platforms like Pinterest and Instagram. Your\n                interactions with these features are governed by those platforms' own privacy policies.\n              </p>\n            </div>\n\n            <div>\n              <h2\n                className=\"font-heading text-2xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                5. Data Retention\n              </h2>\n              <p>\n                We retain personal information only as long as necessary for the purposes outlined here,\n                unless a longer period is required by law. Aggregated analytics data may be retained\n                indefinitely for statistical purposes.\n              </p>\n            </div>\n\n            <div>\n              <h2\n                className=\"font-heading text-2xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                6. Data Security\n              </h2>\n              <p>\n                We implement reasonable technical and organizational security measures including SSL\n                encryption, secure servers, and access controls. No method of internet transmission is\n                100% secure, and we cannot guarantee absolute security.\n              </p>\n            </div>\n\n            <div>\n              <h2\n                className=\"font-heading text-2xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                7. Your Privacy Rights\n              </h2>\n              <p>\n                Depending on your location, you may have rights to access, correct, delete, or port your\n                personal information, opt out of marketing, or object to certain processing. To exercise\n                these rights, contact us at{' '}\n                <a\n                  href=\"mailto:contact@mirelleinspo.com\"\n                  className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground\"\n                >\n                  contact@mirelleinspo.com\n                </a>.\n              </p>\n            </div>\n\n            <div>\n              <h2\n                className=\"font-heading text-2xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                8. Children's Privacy\n              </h2>\n              <p>\n                Mirellé is not intended for children under 13. We do not knowingly collect information\n                from children. If you believe we have done so inadvertently, contact us and we will\n                delete it promptly.\n              </p>\n            </div>\n\n            <div>\n              <h2\n                className=\"font-heading text-2xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                9. International Data Transfers\n              </h2>\n              <p>\n                Your information may be transferred to and processed in countries other than your own.\n                By using our site, you consent to such transfers. We take appropriate safeguards to\n                protect your information in accordance with this policy.\n              </p>\n            </div>\n\n            <div>\n              <h2\n                className=\"font-heading text-2xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                10. Do Not Track Signals\n              </h2>\n              <p>\n                Our website does not currently respond to Do Not Track (DNT) browser signals due to the\n                lack of industry-wide implementation standards.\n              </p>\n            </div>\n\n            <div>\n              <h2\n                className=\"font-heading text-2xl text-foreground mb-4\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                11. California Privacy Rights (CCPA)\n              </h2>\n              <p className=\"mb-4\">\n                California residents have rights under the CCPA (as amended by the CPRA) including the right\n                to know what information we collect, request deletion or correction, and opt out of the\n                &ldquo;sale&rdquo; or &ldquo;sharing&rdquo; of personal information. We do not sell personal\n                information for money. However, our use of interest-based advertising cookies through\n                Mediavine and its advertising partners may be considered a &ldquo;sale&rdquo; or\n                &ldquo;sharing&rdquo; of personal information under CCPA/CPRA, since data such as your IP\n                address, device identifiers, and browsing activity may be shared with third parties for\n                targeted advertising purposes.\n              </p>\n              <p>\n                To opt out of this sharing, you can use the National Advertising Initiative, Digital\n                Advertising Alliance, or Network Advertising Initiative opt-out tools linked in Section 4\n                above, or adjust your cookie preferences in your browser. To exercise any other CCPA rights,\n                contact us at{' '}\n                <a\n                  href=\"mailt
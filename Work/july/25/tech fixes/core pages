      "path": "src/app/business/page.tsx",
      "content": "// src/app/business/page.tsx\nimport { Metadata } from 'next';\nimport { getBusinessCountries } from '@/lib/business';\nimport RegionCard from '@/components/business/RegionCard';\n\nexport const dynamic = 'force-static'\nexport const revalidate = false\n\n\nexport const metadata: Metadata = {\n  title: 'Work With Mirellé Inspo  Editorial Nail Content & Brand Partnerships',\n  description:\n    'Mirellé Inspo produces research-led nail editorial for brands, salons, and campaigns. 20K+ monthly readers, 5M+ monthly Pinterest visitors. Reach the audience that cares about nails.',\n  authors: [{ name: 'Gaurav Verma', url: 'https://mirelleinspo.com/authors/ri-mirelle' }],\n  alternates: { canonical: 'https://mirelleinspo.com/business' },\n  openGraph: {\n    title: 'Work With Mirellé Inspo  Editorial Nail Content & Brand Partnerships',\n    description: 'Research-led nail editorial for brands and salons. 20K+ monthly readers. 5M+ monthly Pinterest visitors.',\n    url: 'https://mirelleinspo.com/business',\n    type: 'website',\n    siteName: 'Mirellé Inspo',\n    locale: 'en_US',\n    images: [{ url: '/logo.png', width: 250, height: 60, alt: 'Work With Mirellé Inspo' }],\n  },\n  twitter: {\n    card: 'summary_large_image',\n    title: 'Work With Mirellé Inspo  Editorial Nail Content & Brand Partnerships',\n    description: 'Research-led nail editorial for brands and salons. 20K+ monthly readers.',\n    creator: '@mirelleinspo',\n    site: '@mirelleinspo',\n    images: ['/logo.png'],\n  },\n  robots: {\n    index: true,\n    follow: true,\n    googleBot: { index: true, follow: true, 'max-video-preview': -1, 'max-image-preview': 'large', 'max-snippet': -1 },\n  },\n};\n \n\nconst indexSchema = {\n  '@context': 'https://schema.org',\n  '@type': 'BreadcrumbList',\n  itemListElement: [\n    { '@type': 'ListItem', position: 1, name: 'Home',     item: 'https://mirelleinspo.com' },\n    { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://mirelleinspo.com/business' },\n  ],\n};\n\n// emoji flags by countrySlug  extend as needed\nconst COUNTRY_FLAGS: Record<string, string> = {\n  india:          '🇮🇳',\n  'united-kingdom': '🇬🇧',\n  'united-states':  '🇺🇸',\n  australia:      '🇦🇺',\n  canada:         '🇨🇦',\n  uae:            '🇦🇪',\n  singapore:      '🇸🇬',\n};\n\nexport default async function BusinessIndexPage() {\n  const countries = await getBusinessCountries();\n\n  return (\n    <>\n      <script\n        type=\"application/ld+json\"\n        dangerouslySetInnerHTML={{ __html: JSON.stringify(indexSchema) }}\n      />\n\n      <div className=\"min-h-screen bg-background\">\n\n        {/* ── Hero ─────────────────────────────────────────────────────────── */}\n        <section className=\"w-full border-b border-[#E0E0E0]\">\n          <div className=\"w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-16 md:py-24\">\n            <p className=\"font-ui text-ui uppercase tracking-wider text-[#666666] mb-6\">\n              Mirellé · Editorial\n            </p>\n            <h1 className=\"font-heading text-h1-mobile md:text-h1 text-foreground max-w-[700px] leading-tight mb-6\">\n              Work With Us\n            </h1>\n            <p className=\"font-body text-body-lg text-foreground max-w-[560px] leading-relaxed\">\n              We produce editorial nail content, campaign direction, and trend coverage for\n              brands and salons in key markets worldwide. Select a country below to explore\n              opportunities in your region.\n            </p>\n          </div>\n        </section>\n\n        {/* ── Country Cards ─────────────────────────────────────────────────── */}\n        <section className=\"w-full\">\n          <div className=\"w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-16 md:py-20\">\n\n            {countries.length > 0 ? (\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6\">\n                {countries.map(({ country, countrySlug }) => (\n                  <RegionCard\n                    key={countrySlug}\n                    href={`/business/${countrySlug}`}\n                    label={country}\n                    flag={COUNTRY_FLAGS[countrySlug] || '🌍'}\n                    variant=\"country\"\n                  />\n                ))}\n              </div>\n            ) : (\n              <p className=\"font-body text-body text-[#666666]\">\n                No regions available yet. Check back soon.\n              </p>\n            )}\n\n          </div>\n        </section>\n\n      </div>\n    </>\n  );\n}"

max-w-6xl mx-auto px-6 sm:px-8 lg:px-12\">\n            <h2\n              className=\"font-heading text-4xl text-foreground mb-4\"\n              style={{ fontFamily: 'Larken, Georgia, serif' }}\n            >\n              For brands\n            </h2>\n            <p\n              className=\"font-body text-base text-foreground/70 leading-relaxed mb-12 max-w-2xl\"\n              style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n            >\n              Sponsored placements, product features, and Pinterest campaigns. All sponsored content is clearly disclosed per our editorial policy.\n            </p>\n\n            <div className=\"grid md:grid-cols-2 gap-8\">\n              <div className=\"border border-foreground/10 p-8\">\n                <h3\n                  className=\"font-heading text-2xl text-foreground mb-4\"\n                  style={{ fontFamily: 'Larken, Georgia, serif' }}\n                >\n                  Sponsored content\n                </h3>\n                <p\n                  className=\"font-body text-base text-foreground/70 leading-relaxed\"\n                  style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n                >\n                  Branded editorial pieces written by Jyoti and planned by Ri against real search demand. Content that earns traffic, not just impressions.\n                </p>\n              </div>\n\n              <div className=\"border border-foreground/10 p-8\">\n                <h3\n                  className=\"font-heading text-2xl text-foreground mb-4\"\n                  style={{ fontFamily: 'Larken, Georgia, serif' }}\n                >\n                  Pinterest campaigns\n                </h3>\n                <p\n                  className=\"font-body text-base text-foreground/70 leading-relaxed\"\n                  style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n                >\n                  Targeted pin placements on our account with 1M monthly visitors and
      "content": "import { Metadata } from 'next';\nimport Link from 'next/link';\nexport const dynamic = 'force-static'\nexport const revalidate = false\n\nexport const metadata: Metadata = {\n  title: 'Press  Mirellé Inspo Media Kit & Stats',\n  description:\n    'Press information for Mirellé Inspo. 20K+ monthly readers, 5M+ monthly Pinterest visitors. Media kit, team bios, and contact for press inquiries.',\n  alternates: { canonical: 'https://mirelleinspo.com/press' },\n  openGraph: {\n    title: 'Press  Mirellé Inspo Media Kit & Stats',\n    description: '20K+ monthly readers, 5M+ monthly Pinterest visitors. Media kit, team bios, and press contacts.',\n    url: 'https://mirelleinspo.com/press',\n    siteName: 'Mirellé Inspo',\n    type: 'website',\n    locale: 'en_US',\n    images: [{ url: '/logo.png', width: 250, height: 60, alt: 'Mirellé Inspo Press' }],\n  },\n  twitter: {\n    card: 'summary',\n    title: 'Press  Mirellé Inspo Media Kit & Stats',\n    description: '20K+ monthly readers, 5M+ monthly Pinterest visitors. Media kit and press contacts.',\n    creator: '@mirelleinspo',\n    site: '@mirelleinspo',\n  },\n  robots: { index: true, follow: true },\n};\n \nexport default function PressPage() {\n  return (\n    <div className=\"min-h-screen bg-background\">\n\n      {/* Hero */}\n      <section className=\"py-24 border-b border-foreground/10\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n          <p className=\"font-ui text-sm uppercase tracking-wider text-foreground/50 mb-6\">\n            Press\n          </p>\n          <h1\n            className=\"font-heading text-5xl md:text-6xl text-foreground mb-8 leading-tight\"\n            style={{ fontFamily: 'Larken, Georgia, serif' }}\n          >\n            Mirellé in the media\n          </h1>\n          <p\n            className=\"font-body text-xl text-foreground/70 leading-relaxed max-w-3xl\"\n            style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n          >\n            Mirellé is a research-driven nail editorial platform that reached 1M monthly Pinterest visitors and 10K+ monthly readers in under a year. Built by two people. No agency, no funding, no legacy audience.\n          </p>\n        </div>\n      </section>\n\n      {/* Stats */}\n      <section className=\"py-20 border-b border-foreground/10\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n          <p className=\"font-ui text-sm uppercase tracking-wider text-foreground/40 mb-12\">\n            Platform at a glance\n          </p>\n\n          <div className=\"grid sm:grid-cols-2 md:grid-cols-3 gap-10 mb-16\">\n            <div>\n              <div\n                className=\"font-heading text-5xl text-foreground mb-2\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                10K+\n              </div>\n              <p className=\"font-ui text-xs uppercase tracking-wide text-foreground/50\">\n                Monthly readers\n              </p>\n            </div>\n            <div>\n              <div\n                className=\"font-heading text-5xl text-foreground mb-2\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                1M\n              </div>\n              <p className=\"font-ui text-xs uppercase tracking-wide text-foreground/50\">\n                Monthly Pinterest visitors\n              </p>\n            </div>\n            <div>\n              <div\n                className=\"font-heading text-5xl text-foreground mb-2\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                63%\n              </div>\n              <p className=\"font-ui text-xs uppercase tracking-wide text-foreground/50\">\n                Engagement rate\n              </p>\n            </div>\n            <div>\n              <div\n                className=\"font-heading text-5xl text-foreground mb-2\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                60%\n              </div>\n              <p className=\"font-ui text-xs uppercase tracking-wide text-foreground/50\">\n                Organic search traffic\n              </p>\n            </div>\n            <div>\n              <div\n                className=\"font-heading text-5xl text-foreground mb-2\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                &lt;1yr\n              </div>\n              <p className=\"font-ui text-xs uppercase tracking-wide text-foreground/50\">\n                Live since September 2024\n              </p>\n            </div>\n          </div>\n\n          <div className=\"border-t border-foreground/10 pt-10\">\n            <p className=\"font-ui text-sm uppercase tracking-wider text-foreground/40 mb-4\">\n              Top markets\n            </p>\n            <p\n              className=\"font-body text-base text-foreground/70\"\n              style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n            >\n              United States (47%), United Kingdom (8.5%), Canada (6.4%), Singapore, India, Australia\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* What Mirellé is */}\n      <section className=\"py-20 border-b border-foreground/10\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n          <h2\n            className=\"font-heading text-4xl text-foreground mb-8\"\n            style={{ fontFamily: 'Larken, Georgia, serif' }}\n          >\n            What Mirellé is\n          </h2>\n          <div\n            className=\"font-body text-lg text-foreground/70 leading-relaxed space-y-6 max-w-3xl\"\n            style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n          >\n            <p>\n              Mirellé is not a beauty blog. It is a nail editorial platform built on research. Every content decision is driven by Pinterest trend data, organic search signals, and market analysis. The result is a platform that understands the nail space at a depth most content in this category does not.\n            </p>\n            <p>\n              The platform covers the full nail ecosystem: brands, nail technicians, home nail enthusiasts, salon culture, and consumer behavior. It launched in September 2024 and reached scale without paid acquisition. 60% of traffic comes from organic search.\n            </p>\n            <p>\n              Tagline: \"We curate so you don't have to.\"\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* Team */}\n      <section className=\"py-20 border-b border-foreground/10\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n          <h2\n            className=\"font-heading text-4xl text-foreground mb-12\"\n            style={{ fontFamily: 'Larken, Georgia, serif' }}\n          >\n            The founders\n          </h2>\n\n          <div className=\"grid md:grid-cols-2 gap-12\">\n            <div>\n              <h3\n                className=\"font-heading text-2xl text-foreground mb-1\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                Ri\n              </h3>\n              <p className=\"font-ui text-xs uppercase tracking-wide text-foreground/40 mb-4\">\n                Co-Founder  Research, Data & Editorial Direction\n              </p>\n              <p\n                className=\"font-body text-base text-foreground/70 leading-relaxed\"\n                style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n              >\n                Ri tracks nail trends through Pinterest data, search analysis, and market research. He handles content planning, editorial direction, business content, trend reports, and technical SEO. He is the research engine behind the platform.\n              </p>\n            </div>\n\n            <div>\n              <h3\n                className=\"font-heading text-2xl text-foreground mb-1\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                Jyoti\n              </h3>\n              <p className=\"font-ui text-xs uppercase tracking-wide text-foreground/40 mb-4\">\n                Co-Founder  Content, Community & Pinterest\n              </p>\n              <p\n                className=\"font-body text-base text-foreground/70 leading-relaxed\"\n                style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n              >\n                Jyoti writes all published content: blogs, FAQs, work-nails pieces, and spotlights. She manages Pinterest and community engagement. Every piece of content that reaches readers passes through her.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* Press contact */}\n      <section className=\"py-20\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n          <h2\n            className=\"font-heading text-4xl text-foreground mb-6\"\n            style={{ fontFamily: 'Larken, Georgia, serif' }}\n          >\n            Press enquiries\n          </h2>\n          <p\n            className=\"font-body text-lg text-foreground/70 leading-relaxed mb-4 max-w-2xl\"\n            style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n          >\n            For interviews, features, data requests, or any media enquiry, reach out directly. We do not have a press kit available at this time but can provide stats, bios, and brand assets on request.\n          </p>\n          <p\n            className=\"font-body text-base text-foreground/40 leading-relaxed mb-10\"\n            style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n          >\n            We typically respond within 2-3 business days.\n          </p>\n          <a\n            href=\"mailto:contact@mirelleinspo.com\"\n            className=\"inline-block bg-foreground text-background px-8 py-4 font-ui text-sm uppercase tracking-wider hover:opacity-90 transition-opacity\"\n          >\n            contact@mirelleinspo.com\n          </a>\n        </div>\n      </section>\n\n    </div>\n  );\n}"
    },

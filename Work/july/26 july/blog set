iv key={index} dangerouslySetInnerHTML={{ __html: part }} />;\n      })}\n    </>\n  );\n}\n\nexport default function SplitLeftTemplate({ post }: SplitLeftTemplateProps) {\n  const postProducts = post.products ?? [];\n  const author = post.author ? getAuthor(post.author) : null;\n  const bodyImages = extractBodyImages(post.content || '', post.image);\n\n  // Split content into thirds\n  const h2Blocks = (post.content || '').split(/(?=<h2[\\s>])/);\n  const total = h2Blocks.length;\n  const cut1 = Math.max(1, Math.floor(total * 0.33));\n  const cut2 = Math.max(cut1 + 1, Math.floor(total * 0.67));\n  const firstThird  = h2Blocks.slice(0, cut1).join('');\n  const secondThird = h2Blocks.slice(cut1, cut2).join('');\n  const lastThird   = h2Blocks.slice(cut2).join('');\n\n  if (post.isMDX) {\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <DownloadButton slug={post.slug} title={post.title} bodyImages={bodyImages} />\n        <ShareButton url={post.canonical} title={post.title} />\n        <Lightbox />\n\n        {/* Hero */}\n        <div className=\"w-full\">\n          <div className=\"hidden md:grid md:grid-cols-2 h-[600px]\">\n            <div className=\"flex items-center justify-center px-16 py-12\" style={{ backgroundColor: '#f9fafb' }}>\n              <div className=\"text-center max-w-[420px] w-full\">\n                {post.category && <p className=\"font-ui text-sm uppercase tracking-wider text-gray-600 mb-4\">{post.category}</p>}\n                <h1 className=\"font-heading text-[36px] md:text-[42px] leading-tight mb-4\" style={{ color: '#252220' }}>{post.title}</h1>\n                <p className=\"font-ui text-sm uppercase tracking-wide mb-2\" style={{ color: '#252220' }}>BY {post.author}</p>\n                <p className=\"font-ui text-sm text-gray-600\">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>\n              </div>\n            </div>\n            <div className=\"flex items-center justify-center p-12 overflow-hidden\" style={{ backgroundColor: '#f9fafb' }}>\n              {post.image && <img src={post.image} alt={post.imageAlt || post.title} className=\"w-full h-full object-contain\" />}\n            </div>\n          </div>\n          <div className=\"md:hidden w-full\">\n            <div className=\"text-center py-8 px-6\" style={{ backgroundColor: '#f9fafb' }}>\n              {post.category && <p className=\"font-ui text-xs uppercase tracking-wider text-gray-600 mb-3\">{post.category}</p>}\n              <h1 className=\"font-heading text-[36px] mb-3\" style={{ color: '#252220' }}>{post.title}</h1>\n              <p className=\"font-ui text-xs uppercase tracking-wide mb-2\" style={{ color: '#252220' }}>BY {post.author}</p>\n              <p className=\"font-ui text-xs text-gray-600\">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>\n            </div>\n            {post.image && <img src={post.image} alt={post.imageAlt || post.title} className=\"w-full h-auto\" />}\n          </div>\n        </div>\n\n        <div className=\"w-full flex flex-col items-start\">\n          <div className=\"w-full max-w-[700px] px-6 md:px-12 lg:px-16 mt-12\">\n            <article className=\"prose-content-magazine\">\n              <MDXContent source={post.content} products={postProducts} topic={post.topic} />\n            </article>\n          </div>\n        </div>\n\n        {post.faqItems && post.faqItems.length > 0 && (\n          <div className=\"w-full flex justify-center\">\n            <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n              <FAQ faqs={post.faqItems} />\n            </div>\n          </div>\n        )}\n        <div className=\"w-full flex justify-center\">\n          <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n            <FinalNewsletter />\n          </div>\n        </div>\n        <div className=\"w-full flex justify-center\">\n          <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n            {author && <AuthorCard author={author} />}\n          </div>\n        </div>\n        <AboutEEAT />\n        <ReadMoreSection currentSlug={post.slug} />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <DownloadButton slug={post.slug} title={post.title} bodyImages={bodyImages} />\n      <ShareButton url={post.canonical} title={post.title} />\n      <Lightbox />\n\n      {/* Hero */}\n      <div className=\"w-full\">\n        <div className=\"hidden md:grid md:grid-cols-2 h-[600px]\">\n          <div className=\"flex items-center justify-center px-16 py-12\" style={{ backgroundColor: '#f9fafb' }}>\n            <div className=\"text-center max-w-[420px] w-full\">\n              {post.category && <p className=\"font-ui text-sm uppercase tracking-wider text-gray-600 mb-4\">{post.category}</p>}\n              <h1 className=\"font-heading text-[36px] md:text-[42px] leading-tight mb-4\" style={{ color: '#252220' }}>{post.title}</h1>\n              <p className=\"font-ui text-sm uppercase tracking-wide mb-2\" style={{ color: '#252220' }}>BY {post.author}</p>\n              <p className=\"font-ui text-sm text-gray-600\">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>\n            </div>\n          </div>\n          <div className=\"flex items-center justify-center p-12 overflow-hidden\" style={{ backgroundColor: '#f9fafb' }}>\n            {post.image && <img src={post.image} alt={post.imageAlt || post.title} className=\"w-full h-full object-contain\" />}\n          </div>\n        </div>\n        <div className=\"md:hidden w-full\">\n          <div className=\"text-center py-8 px-6\" style={{ backgroundColor: '#f9fafb' }}>\n            {post.category && <p className=\"font-ui text-xs uppercase tracking-wider text-gray-600 mb-3\">{post.category}</p>}\n            <h1 className=\"font-heading text-[36px] mb-3\" style={{ color: '#252220' }}>{post.title}</h1>\n            <p className=\"font-ui text-xs uppercase tracking-wide mb-2\" style={{ color: '#252220' }}>BY {post.author}</p>\n            <p className=\"font-ui text-xs text-gray-600\">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>\n          </div>\n          {post.image && <img src={post.image} alt={post.imageAlt || post.title} className=\"w-full h-auto\" />}\n        </div>\n      </div>\n\n      <div className=\"w-full flex justify-center mt-12\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <div className=\"mb-8\">\n            <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }]} currentPage={post.title} includeSchema={false} />\n          </div>\n          <div className=\"block lg:hidden mb-8\">\n            <TableOfContents content={post.content} />\n          </div>\n\n          <div>\n            {post.tldr && <WrapUp tldr={post.tldr} />}\n            <article className=\"prose-content-magazine\">\n              {/* First third ~33% */}\n              {renderContentWithProducts(firstThird, post.products)}\n            </article>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"w-full\"><SocialFollowCTA platforms={['instagram', 'pinterest', 'twitter', 'facebook', 'youtube']} /></div>\n\n      {/* Inline newsletter 1  at ~33% */}\n      <div className=\"w-full my-10\">\n        <InlineNewsletter />\n      </div>\n\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <article className=\"prose-content-magazine\">\n            {/* Second third ~33–67% */}\n            {renderContentWithProducts(secondThird, post.products)}\n\n            {post.carouselImages && post.carouselImages.length > 0 && (\n              <div className=\"my-12\"><ImageCarousel images={post.carouselImages} /></div>\n            )}\n          </article>\n        </div>\n      </div>\n\n      {/* Inline newsletter 2  at ~67% */}\n      <div className=\"w-full my-10\">\n        <InlineNewsletter />\n      </div>\n\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <article className=\"prose-content-magazine\">\n            {/* Last third ~67–100% */}\n            {renderContentWithProducts(lastThird, post.products)}\n          </article>\n        </div>\n      </div>\n\n      <div className=\"w-full\"><SocialFollowCTA platforms={['instagram', 'pinterest', 'twitter', 'facebook', 'youtube']} /></div>\n\n      {post.faqItems && post.faqItems.length > 0 && (\n        <div className=\"w-full flex justify-center\">\n          <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n            <FAQ faqs={post.faqItems} />\n          </div>\n        </div>\n      )}\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <FinalNewsletter />\n        </div>\n      </div>\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          {author && <AuthorCard author={author} />}\n        </div>\n      </div>\n      <AboutEEAT />\n      <ReadMoreSection currentSlug={post.slug} />\n    </div>\n  );\n}"

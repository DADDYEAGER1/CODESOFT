      "path": "src/app/blog/page.tsx",
      "content": "// src/app/blog/page.tsx\nimport { Metadata } from 'next';\nimport { getAllBlogPosts, getPostsByCategory, getAllClusters, getStandalonePosts } from '@/lib/blog';\nimport { BlogMetadata } from '@/types/blog';\nimport MainHeroSection from '@/components/Blog/MainHeroSection';\nimport MustReadSection from '@/components/Blog/MustReadSection';\nimport CarouselSection from '@/components/Blog/CarouselSection';\nimport LatestStoriesSection from '@/components/Blog/LatestStoriesSection';\nimport NextPageButton from '@/components/Blog/NextPageButton';\nimport BlogCategoryNav from '@/components/Blog/BlogCategoryNav';\nimport InlineNewsletter from '@/components/Blog/InlineNewsletter';\n\nexport const dynamic = 'force-static'\nexport const revalidate = false\n\n\n \nexport const metadata: Metadata = {\n  title: 'Nail Art Blog  Tutorials, Seasonal Trends & Design Guides',\n  description:\n    'Editorial nail content from Mirellé Inspo  seasonal trend breakdowns, step-by-step tutorials, shape guides, and care advice. Written by Jyotika Verma, updated weekly.',\n  authors: [{ name: 'Jyotika Verma', url: 'https://mirelleinspo.com/authors/jyoti-mirelle' }],\n  alternates: { canonical: 'https://mirelleinspo.com/blog' },\n  openGraph: {\n    title: 'Nail Art Blog - Tutorials, Seasonal Trends & Design Guides',\n    description: 'Seasonal trend breakdowns, step-by-step tutorials, and nail care advice  written by Jyotika Verma and updated weekly.',\n    url: 'https://mirelleinspo.com/blog',\n    siteName: 'Mirellé Inspo',\n    type: 'website',\n    locale: 'en_US',\n    images: [{ url: '/logo.png', width: 250, height: 60, alt: 'Mirellé Inspo Blog' }],\n  },\n  twitter: {\n    card: 'summary_large_image',\n    title: 'Nail Art Blog  Tutorials, Seasonal Trends & Design Guides',\n    description: 'Seasonal trends, step-by-step tutorials, and nail care advice. Updated weekly.',\n    creator: '@mirelleinspo',\n    site: '@mirelleinspo',\n    images: ['/logo.png'],\n  },\n  robots: {\n    index: true,\n    follow: true,\n    googleBot: { index: true, follow: true, 'max-video-preview': -1, 'max-image-preview': 'large', 'max-snippet': -1 },\n  },\n};\n \n\ninterface PageProps {\n  searchParams: Promise<{\n    page?: string;\n    category?: string;\n  }>;\n}\n\nconst CLUSTERS_PER_PAGE = 3;\nconst MUST_READ_COUNT = 3;\nconst LATEST_EDITS_PER_PAGE = 6;\nconst HERO_TARGET_COUNT = 12;\n\ninterface PageAllocation {\n  heroPosts: BlogMetadata[];\n  carousel1: { pillar: BlogMetadata; clusters: BlogMetadata[] } | undefined;\n  carousel2: { pillar: BlogMetadata; clusters: BlogMetadata[] } | undefined;\n  mustReadPosts: BlogMetadata[];\n  latestEditsPosts: BlogMetadata[];\n  hasNextPage: boolean;\n}\n\nasync function buildPageAllocation(targetPage: number): Promise<PageAllocation> {\n  const allClusters = await getAllClusters();\n  const standalonePosts = await getStandalonePosts();\n\n  const usedSlugs = new Set<string>();\n  const overflowQueue: BlogMetadata[] = [];\n\n  let result: PageAllocation | null = null;\n\n  for (let page = 1; page <= targetPage; page++) {\n    const clusterStartIndex = (page - 1) * CLUSTERS_PER_PAGE;\n    const clustersForPage = allClusters.slice(clusterStartIndex, clusterStartIndex + CLUSTERS_PER_PAGE);\n    const [heroCluster, carousel1, carousel2] = clustersForPage;\n\n    if (carousel1) {\n      usedSlugs.add(carousel1.pillar.slug);\n      carousel1.clusters.forEach(p => usedSlugs.add(p.slug));\n    }\n    if (carousel2) {\n      usedSlugs.add(carousel2.pillar.slug);\n      carousel2.clusters.forEach(p => usedSlugs.add(p.slug));\n    }\n\n    let heroPosts: BlogMetadata[] = [];\n    if (heroCluster) {\n      const family = [heroCluster.pillar, ...heroCluster.clusters];\n      family.forEach(p => usedSlugs.add(p.slug));\n\n      if (family.length > HERO_TARGET_COUNT) {\n        heroPosts = family.slice(0, HERO_TARGET_COUNT);\n        const overflow = family.slice(HERO_TARGET_COUNT);\n        overflow.forEach(p => {\n          usedSlugs.delete(p.slug);\n          overflowQueue.push(p);\n        });\n      } else if (family.length < HERO_TARGET_COUNT) {\n        const needed = HERO_TARGET_COUNT - family.length;\n        const filler = standalonePosts.filter(p => !usedSlugs.has(p.slug)).slice(0, needed);\n        filler.forEach(p => usedSlugs.add(p.slug));\n        heroPosts = [...family, ...filler];\n      } else {\n        heroPosts = family;\n      }\n    }\n\n    const eligiblePool = [\n      ...overflowQueue.filter(p => !usedSlugs.has(p.slug)),\n      ...standalonePosts.filter(p => !usedSlugs.has(p.slug)),\n    ];\n    const seenInPool = new Set<string>();\n    const dedupedPool = eligiblePool.filter(p => {\n      if (seenInPool.has(p.slug)) return false;\n      seenInPool.add(p.slug);\n      return true;\n    });\n\n    const mustReadPosts = dedupedPool.slice(0, MUST_READ_COUNT);\n    mustReadPosts.forEach(p => usedSlugs.add(p.slug));\n\n    const remainingPool = dedupedPool.filter(p => !mustReadPosts.some(mp => mp.slug === p.slug));\n    const latestEditsPosts = remainingPool.slice(0, LATEST_EDITS_PER_PAGE);\n    latestEditsPosts.forEach(p => usedSlugs.add(p.slug));\n\n    for (const p of [...mustReadPosts, ...latestEditsPosts]) {\n      const qIdx = overflowQueue.findIndex(o => o.slug === p.slug);\n      if (qIdx !== -1) overflowQueue.splice(qIdx, 1);\n    }\n\n    const hasMoreClusters = allClusters.length > clusterStartIndex + CLUSTERS_PER_PAGE;\n    const remainingStandalone = standalonePosts.filter(p => !usedSlugs.has(p.slug)).length;\n    const hasMoreOverflow = overflowQueue.length > 0;\n    const hasNextPage = hasMoreClusters || remainingStandalone > 0 || hasMoreOverflow;\n\n    if (page === targetPage) {\n      result = { heroPosts, carousel1, carousel2, mustReadPosts, latestEditsPosts, hasNextPage };\n    }\n  }\n\n  return result!;\n}\n\nexport default async function BlogPage({ searchParams }: PageProps) {\n  const params = await searchParams;\n  const currentPage = Math.max(1, Number(params.page) || 1);\n  const selectedCategory = params.category;\n\n  // ── Category filtered view ───────────────────────────────────────────\n  if (selectedCategory) {\n    const allCategoryPosts = await getPostsByCategory(selectedCategory);\n    const postsPerPage = 12;\n    const totalPages = Math.ceil(allCategoryPosts.length / postsPerPage);\n    const startIndex = (currentPage - 1) * postsPerPage;\n    const posts = allCategoryPosts.slice(startIndex, startIndex + postsPerPage);\n\n    return (\n      <div className=\"min-h-screen bg-[#f9fafb]\">\n        <section className=\"py-16 bg-[#f9fafb] border-b border-gray-100\">\n          <div className=\"max-w-[1200px] mx-auto px-6 text-center\">\n            <h1\n              className=\"text-4xl md:text-5xl uppercase\"\n              style={{ fontFamily: 'Larken, Georgia, serif' }}\n            >\n              {selectedCategory.replace('-', ' ')}\n            </h1>\n          </div>\n        </section>\n\n        <BlogCategoryNav />\n        <LatestStoriesSection posts={posts} />\n\n        {currentPage < totalPages && (\n          <NextPageButton href={`/blog?category=${selectedCategory}&page=${currentPage + 1}`} />\n        )}\n      </div>\n    );\n  }\n\n  // ── Unified pagination ──────────────────────────────────────────────\n  const { heroPosts, carousel1, carousel2, mustReadPosts, latestEditsPosts, hasNextPage } =\n    await buildPageAllocation(currentPage);\n\n  return (\n    <div className=\"min-h-screen bg-[#f9fafb]\">\n      {/* Hero title */}\n      <section className=\"py-16 md:py-24 bg-[#f9fafb] border-b border-gray-100\">\n        <div className=\"max-w-[1200px] mx-auto px-6 text-center\">\n          <h1\n            className=\"text-5xl md:text-6xl\"\n            style={{ fontFamily: 'Larken, serif' }}\n          >\n            Nails\n          </h1>\n        </div>\n      </section>\n\n      <BlogCategoryNav />\n\n      {/* Inline newsletter 1  top of listing */}\n      <InlineNewsletter />\n\n      {heroPosts.length > 0 && <MainHeroSection posts={heroPosts} />}\n\n      {carousel1 && <CarouselSection clusterGroup={carousel1} />}\n\n      {mustReadPosts.length > 0 && <MustReadSection posts={mustReadPosts} />}\n\n      {/* Inline newsletter 2  after Must Read */}\n      <InlineNewsletter />\n\n      {carousel2 && <CarouselSection clusterGroup={carousel2} />}\n\n      {latestEditsPosts.length > 0 && <LatestStoriesSection posts={latestEditsPosts} />}\n\n      {hasNextPage && <NextPageButton href={`/blog?page=${currentPage + 1}`} />}\n    </div>\n  );\n}"

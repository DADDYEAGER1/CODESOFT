      "path": "src/lib/pinterest.ts",
      "content": "// src/lib/pinterest.ts\nimport fs from 'fs';\nimport path from 'path';\nimport matter from 'gray-matter';\nimport { PinterestReport, PinterestMetadata } from '@/types/pinterest';\n\nconst pinterestDirectory = path.join(process.cwd(), 'src/content/pinterest');\n\n// Slug is read from each file's frontmatter, not derived from the filename.\n// Filenames can be anything (e.g. dated for sorting on disk) - the `slug`\n// field in frontmatter is the single source of truth for the URL.\nfunction getAllPinterestFilenames(): string[] {\n  if (!fs.existsSync(pinterestDirectory)) return [];\n  return fs.readdirSync(pinterestDirectory).filter((f) => f.endsWith('.mdx'));\n}\n\nexport async function getAllPinterestSlugs(): Promise<string[]> {\n  const filenames = getAllPinterestFilenames();\n  const slugs = filenames.map((filename) => {\n    const fullPath = path.join(pinterestDirectory, filename);\n    const fileContents = fs.readFileSync(fullPath, 'utf8');\n    const { data } = matter(fileContents);\n    return data.slug as string | undefined;\n  });\n  return slugs.filter((s): s is string => Boolean(s));\n}\n\nexport async function getPinterestReport(slug: string): Promise<PinterestReport | null> {\n  try {\n    const filenames = getAllPinterestFilenames();\n\n    for (const filename of filenames) {\n      const fullPath = path.join(pinterestDirectory, filename);\n      const fileContents = fs.readFileSync(fullPath, 'utf8');\n      const { data, content } = matter(fileContents);\n\n      if (data.slug !== slug) continue;\n\n      return {\n        slug,\n        title: data.title || '',\n        excerpt: data.excerpt || '',\n        date: data.date || new Date().toISOString(),\n        dateModified: data.dateModified,\n        author: data.author || 'Mirellé',\n        month: data.month || '',\n        year: data.year || new Date().getFullYear(),\n        image: data.image || '/images/default-pinterest.jpg',\n        imageAlt: data.imageAlt,\n        imageWidth: data.imageWidth,\n        imageHeight: data.imageHeight,\n        imageCaption: data.imageCaption,\n        readTime: data.readTime,\n        wordCount: data.wordCount,\n        canonical: data.canonical || `https://mirelleinspo.com/pinterest/${slug}`,\n        tags: data.tags,\n        faqs: Array.isArray(data.faqs) ? data.faqs : [],\n        topicalMap: data.topicalMap,\n        navigationContext: data.navigationContext,\n        content,\n      };\n    }\n\n    return null; // no file had a matching frontmatter slug\n  } catch (error) {\n    console.error(`Error loading pinterest report ${slug}:`, error);\n    return null;\n  }\n}\n\nexport async function getAllPinterestReports(): Promise<PinterestMetadata[]> {\n  const slugs = await getAllPinterestSlugs();\n  const reports = await Promise.all(\n    slugs.map(async (slug) => {\n      const report = await getPinterestReport(slug);\n      if (!report) return null;\n      const { content, ...metadata } = report;\n      return metadata;\n    })\n  );\n  return reports\n    .filter((r): r is PinterestMetadata => r !== null)\n    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());\n}\n\nexport async function getRelatedPinterestReports(\n  currentSlug: string,\n  limit = 3\n): Promise<PinterestMetadata[]> {\n  const all = await getAllPinterestReports();\n  return all.filter((r) => r.slug !== currentSlug).slice(0, limit);\n}\n\nexport async function getPaginatedPinterestReports(page = 1, perPage = 12) {\n  const all = await getAllPinterestReports();\n  const total = all.length;\n  const totalPages = Math.ceil(total / perPage);\n  const start = (page - 1) * perPage;\n  return {\n    reports: all.slice(start, start + perPage),\n    currentPage: page,\n    totalPages,\n    totalReports: total,\n    hasNextPage: page < totalPages,\n    hasPreviousPage: page > 1,\n  };\n}\n\n// Returns the single most recent monthly prediction - useful for surfacing\n// \"this month's prediction\" on the index page hero without extra plumbing.\nexport async function getLatestPinterestReport(): Promise<PinterestMetadata | null> {\n  const all = await getAllPinterestReports();\n  return all[0] || null;\n}"

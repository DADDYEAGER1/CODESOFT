      "path": "src/lib/business.ts",
      "content": "// src/lib/business.ts\nimport fs from 'fs';\nimport path from 'path';\nimport matter from 'gray-matter';\nimport { marked } from 'marked';\nimport { BusinessPost, BusinessMetadata } from '@/types/business';\n\n// ─── Marked config ────────────────────────────────────────────────────────────\n\nmarked.setOptions({ breaks: true, gfm: true });\n\nconst renderer = new marked.Renderer();\n\nrenderer.html = (html: string) => html.replace(/src=\"images\\//g, 'src=\"/images/');\nrenderer.image = (href: string, title: string | null, text: string) => {\n  const fixedHref = href.startsWith('images/') ? `/${href}` : href;\n  const titleAttr = title ? ` title=\"${title}\"` : '';\n  return `<img src=\"${fixedHref}\" alt=\"${text}\"${titleAttr} loading=\"lazy\" />`;\n};\n\nmarked.use({ renderer });\n\n// ─── Paths ────────────────────────────────────────────────────────────────────\n\nconst BUSINESS_DIRECTORY = path.join(process.cwd(), 'src/content/business');\n\n// ─── Helpers ──────────────────────────────────────────────────────────────────\n\n/**\n * Flat directory read - src/content/business/*.md or *.mdx.\n * No nested country/state folders.\n */\nfunction getAllBusinessFiles(): { filePath: string; filename: string }[] {\n  if (!fs.existsSync(BUSINESS_DIRECTORY)) return [];\n  return fs\n    .readdirSync(BUSINESS_DIRECTORY)\n    .filter((f) => f.endsWith('.md') || f.endsWith('.mdx'))\n    .map((filename) => ({\n      filePath: path.join(BUSINESS_DIRECTORY, filename),\n      filename,\n    }));\n}\n\n/**\n * Finds a post file by matching frontmatter `slug`, not filename.\n */\nfunction resolveFileBySlug(slug: string): { filePath: string; isMDX: boolean } | null {\n  const files = getAllBusinessFiles();\n  for (const { filePath } of files) {\n    const raw = fs.readFileSync(filePath, 'utf8');\n    const { data } = matter(raw);\n    if (data.slug === slug) {\n      return { filePath, isMDX: filePath.endsWith('.mdx') };\n    }\n  }\n  return null;\n}\n\n// ─── Cache ────────────────────────────────────────────────────────────────────\n\ninterface CacheEntry<T> {\n  data: T;\n  timestamp: number;\n}\n\nclass BusinessCache {\n  private cache = new Map<string, CacheEntry<unknown>>();\n  private readonly TTL = 3600000;\n\n  get<T>(key: string): T | null {\n    const entry = this.cache.get(key);\n    if (!entry) return null;\n    if (Date.now() - entry.timestamp > this.TTL) {\n      this.cache.delete(key);\n      return null;\n    }\n    return entry.data as T;\n  }\n\n  set<T>(key: string, data: T): void {\n    this.cache.set(key, { data, timestamp: Date.now() });\n  }\n\n  clear(): void {\n    this.cache.clear();\n  }\n}\n\nconst businessCache = new BusinessCache();\n\n// ─── Parse metadata ───────────────────────────────────────────────────────────\n\nfunction parseMetadata(data: Record<string, unknown>): BusinessMetadata {\n  const slug = data.slug as string;\n\n  return {\n    slug,\n    title: (data.title as string) || 'Untitled',\n    excerpt: (data.excerpt as string) || '',\n    date: (data.date as string) || new Date().toISOString(),\n    dateModified: data.dateModified as string | undefined,\n    author: (data.author as string) || 'Ri Mirellé',\n\n    canonical: (data.canonical as string) || `https://mirelleinspo.com/business/${slug}`,\n    targetKeyword: (data.targetKeyword as string) || '',\n    secondaryKeywords: (data.secondaryKeywords as string[]) || [],\n    searchIntent: data.searchIntent as BusinessMetadata['searchIntent'],\n\n    tldr: (data.tldr as string) || '',\n    entityType: (data.entityType as string) || 'EditorialNailPlatform',\n    speakable: (data.speakable as boolean) ?? true,\n\n    contact: (data.contact as BusinessMetadata['contact']) || { email: 'contact@mirelleinspo.com' },\n    services: (data.services as BusinessMetadata['services']) || [],\n    schemaType: (data.schemaType as BusinessMetadata['schemaType']) || 'ProfessionalService',\n    template: 'business' as const,\n    url: `https://mirelleinspo.com/business/${slug}`,\n\n    postType: (data.postType as BusinessMetadata['postType']) || 'client-acquisition',\n    painPoint: (data.painPoint as string) || '',\n    statBlock: (data.statBlock as BusinessMetadata['statBlock']) || [],\n  };\n}\n\n// ─── Public API ───────────────────────────────────────────────────────────────\n\nexport async function getAllBusinessPosts(): Promise<BusinessMetadata[]> {\n  const cacheKey = 'all-business-posts';\n  const cached = businessCache.get<BusinessMetadata[]>(cacheKey);\n  if (cached) return cached;\n\n  try {\n    const files = getAllBusinessFiles();\n    const posts = files\n      .map(({ filePath }) => {\n        const content = fs.readFileSync(filePath, 'utf8');\n        const { data } = matter(content);\n        return parseMetadata(data);\n      })\n      .filter((p) => Boolean(p.slug))\n      .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());\n\n    businessCache.set(cacheKey, posts);\n    return posts;\n  } catch (error) {\n    console.error('Error reading business posts:', error);\n    return [];\n  }\n}\n\nexport async function getBusinessPost(slug: string): Promise<BusinessPost | null> {\n  const cacheKey = `business-post:${slug}`;\n  const cached = businessCache.get<BusinessPost>(cacheKey);\n  if (cached) return cached;\n\n  try {\n    const resolved = resolveFileBySlug(slug);\n    if (!resolved) {\n      console.error(`Business post not found: ${slug}`);\n      return null;\n    }\n\n    const { filePath, isMDX } = resolved;\n    const fileContent = fs.readFileSync(filePath, 'utf8');\n    const { data, content: rawContent } = matter(fileContent);\n\n    let htmlContent: string;\n\n    if (isMDX) {\n      htmlContent = rawContent;\n    } else {\n      let compiled = await marked(rawContent);\n      compiled = compiled.replace(/<h2>(.*?)<\\/h2>/g, (_match, text) => {\n        const id = text\n          .replace(/<[^>]*>/g, '')\n          .toLowerCase()\n          .replace(/[^a-z0-9]+/g, '-')\n          .replace(/^-+|-+$/g, '');\n        return `<h2 id=\"${id}\">${text}</h2>`;\n      });\n      htmlContent = compiled;\n    }\n\n    const meta = parseMetadata(data);\n\n    const post: BusinessPost = {\n      ...meta,\n      content: htmlContent,\n      isMDX,\n      faqSchema: (data.faqSchema as BusinessPost['faqSchema']) || [],\n      galleryImages: (data.galleryImages as BusinessPost['galleryImages']) || [],\n    };\n\n    businessCache.set(cacheKey, post);\n    return post;\n  } catch (error) {\n    console.error(`Error reading business post ${slug}:`, error);\n    return null;\n  }\n}\n\nexport async function getAllBusinessSlugs(): Promise<string[]> {\n  const posts = await getAllBusinessPosts();\n  return posts.map((p) => p.slug);\n}\n\nexport function clearBusinessCache(): void {\n  businessCache.clear();\n}"

      "path": "src/components/Blog/WrapUp.tsx",
      "content": "'use client';\n\nimport { useState, Fragment } from 'react';\n\ninterface FAQItem {\n  question: string;\n  answer: string;\n}\n\ninterface TLDR {\n  summary: string[];\n  keyTakeaways?: string[];\n  tldrFaqs?: FAQItem[];\n}\n\ninterface WrapUpProps {\n  tldr: TLDR;\n}\n\n// Renders simple **bold** markdown syntax as JSX <strong> tags.\n// tldr fields are plain text written with markdown bold, but this\n// component previously rendered them as raw strings.\nfunction renderBoldText(text: string): React.ReactNode {\n  const parts = text.split(/(\\*\\*[^*]+\\*\\*)/g);\n  return parts.map((part, i) => {\n    const match = part.match(/^\\*\\*([^*]+)\\*\\*$/);\n    if (match) {\n      return <strong key={i}>{match[1]}</strong>;\n    }\n    return <Fragment key={i}>{part}</Fragment>;\n  });\n}\n\nfunction FAQRow({ question, answer }: FAQItem) {\n  const [open, setOpen] = useState(false);\n\n  return (\n    <li className=\"border-b last:border-b-0\" style={{ borderColor: '#e5e7eb' }}>\n      <button\n        onClick={() => setOpen(!open)}\n        className=\"w-full text-left py-3 flex items-start justify-between gap-4 group\"\n        style={{ background: 'none', border: 'none', cursor: 'pointer' }}\n      >\n        <span\n          className=\"text-base leading-snug\"\n          style={{\n            fontFamily: 'var(--font-body)',\n            color: '#252220',\n            textDecoration: 'underline',\n            textUnderlineOffset: '3px',\n            textDecorationColor: '#c0b8b0',\n          }}\n        >\n          {question}\n        </span>\n        <span\n          className=\"flex-shrink-0 mt-0.5 text-sm transition-transform duration-200\"\n          style={{\n            color: '#252220',\n            transform: open ? 'rotate(180deg)' : 'rotate(0deg)',\n            display: 'inline-block',\n          }}\n        >\n          ↓\n        </span>\n      </button>\n\n      {open && (\n        <p\n          className=\"pb-3 text-sm leading-relaxed\"\n          style={{ fontFamily: 'var(--font-body)', color: '#555' }}\n        >\n          {answer}\n        </p>\n      )}\n    </li>\n  );\n}\n\nexport default function WrapUp({ tldr }: WrapUpProps) {\n  if (!tldr) return null;\n\n  const { summary, keyTakeaways, tldrFaqs } = tldr;\n\n  return (\n    <nav className=\"bg-white p-6 mb-10\" style={{ border: '1px solid #e5e7eb' }}>\n      <h2\n        className=\"font-heading text-xl mb-6 text-center\"\n        style={{ color: '#252220' }}\n      >\n        Wrap Up\n      </h2>\n\n      {/* Summary */}\n      {summary && summary.length > 0 && (\n        <div className=\"mb-6\">\n          <p\n            className=\"text-xs uppercase tracking-wider mb-3\"\n            style={{ fontFamily: 'var(--font-ui)', color: '#888' }}\n          >\n            Summary\n          </p>\n          <ul className=\"space-y-2\">\n            {summary.map((item, i) => (\n              <li\n                key={i}\n                className=\"flex items-start gap-2 text-sm leading-relaxed\"\n                style={{ fontFamily: 'var(--font-body)', color: '#252220' }}\n              >\n                <span className=\"mt-1 flex-shrink-0\" style={{ color: '#c0b8b0' }}>•</span>\n                {renderBoldText(item)}\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n\n      {/* Key Takeaways */}\n      {keyTakeaways && keyTakeaways.length > 0 && (\n        <div className=\"mb-6\">\n          <p\n            className=\"text-xs uppercase tracking-wider mb-3\"\n            style={{ fontFamily: 'var(--font-ui)', color: '#888' }}\n          >\n            Key Takeaways\n          </p>\n          <ul className=\"space-y-2\">\n            {keyTakeaways.map((item, i) => (\n              <li\n                key={i}\n                className=\"flex items-start gap-2 text-sm leading-relaxed\"\n                style={{ fontFamily: 'var(--font-body)', color: '#252220' }}\n              >\n                <span className=\"mt-1 flex-shrink-0\" style={{ color: '#c0b8b0' }}>•</span>\n                {renderBoldText(item)}\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n\n      {/* FAQs */}\n      {tldrFaqs && tldrFaqs.length > 0 && (\n        <div>\n          <p\n            className=\"text-xs uppercase tracking-wider mb-3\"\n            style={{ fontFamily: 'var(--font-ui)', color: '#888' }}\n          >\n            Quick Questions\n          </p>\n          <ul className=\"divide-y\" style={{ borderColor: '#e5e7eb' }}>\n            {tldrFaqs.map((faq, i) => (\n              <FAQRow key={i} question={faq.question} answer={faq.answer} />\n            ))}\n          </ul>\n        </div>\n      )}\n    </nav>\n  );\n}"
    },
    {
      "path": "src/components/Blog/TableOfContents.tsx",
      "content": "'use client';\n\nimport { useEffect, useState } from 'react';\n\ninterface TOCItem {\n  id: string;\n  text: string;\n  level: number;\n}\n\ninterface TableOfContentsProps {\n  content: string;\n}\n\nexport default function TableOfContents({ content }: TableOfContentsProps) {\n  const [tocItems, setTocItems] = useState<TOCItem[]>([]);\n  const [activeId, setActiveId] = useState<string>('');\n\n  useEffect(() => {\n  const actualHeadings = document.querySelectorAll('article h2, article h3');\n  \n  // Auto-assign IDs if missing\n  actualHeadings.forEach((heading) => {\n    if (!heading.id) {\n      const id = (heading.textContent || '')\n        .toLowerCase()\n        .replace(/[^a-z0-9]+/g, '-')\n        .replace(/^-+|-+$/g, '');\n      heading.id = id;\n    }\n  });\n\n  const items: TOCItem[] = Array.from(actualHeadings).map((heading) => ({\n    id: heading.id,\n    text: heading.textContent || '',\n    level: parseInt(heading.tagName.substring(1)),\n  }));\n\n  setTocItems(items);\n\n  const observer = new IntersectionObserver(\n    (entries) => {\n      entries.forEach((entry) => {\n        if (entry.isIntersecting) setActiveId(entry.target.id);\n      });\n    },\n    { rootMargin: '-100px 0px -66% 0px' }\n  );\n\n  actualHeadings.forEach((heading) => {\n    if (heading.id) observer.observe(heading);\n  });\n\n  return () => observer.disconnect();\n}, [content]);\n\n  if (tocItems.length === 0) return null;\n\n  const handleClick = (e: React.MouseEvent<HTMLAnchorElement>, id: string) => {\n    e.preventDefault();\n    const element = document.getElementById(id);\n    if (element) {\n      const yOffset = -100;\n      const y = element.getBoundingClientRect().top + window.pageYOffset + yOffset;\n      window.scrollTo({ top: y, behavior: 'smooth' });\n    }\n  };\n\n  return (\n    <nav className=\"bg-white p-6\" style={{ border: '1px solid #e5e7eb' }}>\n      <h2 className=\"font-heading text-xl mb-6 text-center\" style={{ color: '#252220' }}>\n        On This Page\n      </h2>\n      <ul className=\"space-y-4\">\n        {tocItems.map((item) => (\n          <li\n            key={item.id}\n            className={item.level === 3 ? 'ml-6' : ''}\n          >\n            <a\n              href={`#${item.id}`}\n              onClick={(e) => handleClick(e, item.id)}\n              className={`block text-base transition-all py-1 no-underline hover:no-underline ${\n                activeId === item.id ? 'border-l-4 pl-4 font-medium' : 'pl-4'\n              }`}\n              style={{\n                fontFamily: 'var(--font-body)',\n                color: '#252220',\n                borderColor: activeId === item.id ? '#252220' : 'transparent',\n                textDecoration: 'none'\n              }}\n            >\n              {item.text}\n            </a>\n          </li>\n        ))}\n      </ul>\n    </nav>\n  );\n}"
    },

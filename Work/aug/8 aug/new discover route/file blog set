      "path": "src/components/Blog/DownloadButton.tsx",
      "content": "'use client';\n\nimport { useState, useRef, useEffect } from 'react';\nimport { Download, Image as ImageIcon, FileText, Check } from 'lucide-react';\n\ninterface DownloadButtonProps {\n  slug: string;\n  title: string;\n  bodyImages: string[]; // body image URLs only, NOT the hero image\n}\n\nexport default function DownloadButton({ slug, title, bodyImages }: DownloadButtonProps) {\n  const [open, setOpen] = useState(false);\n  const [downloadingImages, setDownloadingImages] = useState(false);\n  const [downloadingPdf, setDownloadingPdf] = useState(false);\n  const [imagesDone, setImagesDone] = useState(false);\n  const wrapRef = useRef<HTMLDivElement>(null);\n  const hasBodyImages = bodyImages && bodyImages.length > 0;\n\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      if (wrapRef.current && !wrapRef.current.contains(e.target as Node)) {\n        setOpen(false);\n      }\n    }\n    document.addEventListener('mousedown', handleClickOutside);\n    return () => document.removeEventListener('mousedown', handleClickOutside);\n  }, []);\n\n  function slugifyName(base: string, index: number, url: string) {\n    const ext = url.split('.').pop()?.split('?')[0] || 'jpg';\n    return `${base}-${index + 1}.${ext}`;\n  }\n\n  async function handleDownloadImages() {\n    if (downloadingImages) return;\n    setDownloadingImages(true);\n    try {\n      for (let i = 0; i < bodyImages.length; i++) {\n        const url = bodyImages[i];\n        try {\n          const res = await fetch(url);\n          const blob = await res.blob();\n          const objectUrl = URL.createObjectURL(blob);\n          const a = document.createElement('a');\n          a.href = objectUrl;\n          a.download = slugifyName(slug, i, url);\n          document.body.appendChild(a);\n          a.click();\n          document.body.removeChild(a);\n          URL.revokeObjectURL(objectUrl);\n          // small delay so mobile browsers don't drop/block rapid-fire downloads\n          await new Promise((r) => setTimeout(r, 400));\n        } catch {\n          // skip failed image, continue with the rest\n        }\n      }\n      setImagesDone(true);\n      setTimeout(() => setImagesDone(false), 2000);\n    } finally {\n      setDownloadingImages(false);\n    }\n  }\n\n  async function handleDownloadPdf() {\n    if (downloadingPdf) return;\n    setDownloadingPdf(true);\n    try {\n      const res = await fetch(`/api/blog/${slug}/pdf`);\n      if (!res.ok) throw new Error('PDF generation failed');\n      const blob = await res.blob();\n      const objectUrl = URL.createObjectURL(blob);\n      const a = document.createElement('a');\n      a.href = objectUrl;\n      a.download = `${slug}.pdf`;\n      document.body.appendChild(a);\n      a.click();\n      document.body.removeChild(a);\n      URL.revokeObjectURL(objectUrl);\n    } catch {\n      // silently fail; button returns to normal state\n    } finally {\n      setDownloadingPdf(false);\n    }\n  }\n\n  const actions = [\n    ...(hasBodyImages\n      ? [\n          {\n            key: 'images',\n            label: imagesDone ? 'Downloaded' : downloadingImages ? 'Downloading…' : 'Download images',\n            icon: imagesDone ? <Check size={18} /> : <ImageIcon size={18} />,\n            onClick: handleDownloadImages,\n            disabled: downloadingImages,\n          },\n        ]\n      : []),\n    {\n      key: 'pdf',\n      label: downloadingPdf ? 'Preparing…' : 'Download as PDF',\n      icon: <FileText size={18} />,\n      onClick: handleDownloadPdf,\n      disabled: downloadingPdf,\n    },\n  ];\n\n  return (\n    <div\n      ref={wrapRef}\n      className=\"fixed z-40\"\n      style={{ bottom: '144px', right: '16px' }}\n    >\n      {open && (\n        <div\n          className=\"flex flex-col items-end gap-2 mb-3\"\n          role=\"menu\"\n          aria-label=\"Download this post\"\n        >\n          {actions.map((action, i) => (\n            <button\n              key={action.key}\n              onClick={action.onClick}\n              disabled={action.disabled}\n              role=\"menuitem\"\n              aria-label={action.label}\n              title={action.label}\n              className=\"flex items-center gap-2 pl-3 pr-4 h-11 rounded-full shadow-md border transition-transform hover:scale-105 active:scale-95 disabled:opacity-60 disabled:hover:scale-100\"\n              style={{\n                backgroundColor: 'var(--background)',\n                color: 'var(--foreground)',\n                borderColor: 'rgba(37,34,32,0.15)',\n                animation: `downloadFadeIn 0.18s ease-out ${i * 0.03}s both`,\n              }}\n            >\n              {action.icon}\n              <span className=\"text-sm font-ui whitespace-nowrap\">{action.label}</span>\n            </button>\n          ))}\n        </div>\n      )}\n\n      <button\n        onClick={() => setOpen((o) => !o)}\n        aria-label={open ? 'Close download menu' : 'Download this post'}\n        aria-expanded={open}\n        className=\"w-12 h-12 rounded-full flex items-center justify-center shadow-lg transition-transform hover:scale-105 active:scale-95\"\n        style={{\n          backgroundColor: 'var(--foreground)',\n          color: 'var(--background)',\n        }}\n      >\n        <Download size={20} style={{ transform: open ? 'rotate(180deg)' : 'none', transition: 'transform 0.2s ease' }} />\n      </button>\n\n      <style jsx>{`\n        @keyframes downloadFadeIn {\n          from {\n            opacity: 0;\n            transform: translateY(6px) scale(0.9);\n          }\n          to {\n            opacity: 1;\n            transform: translateY(0) scale(1);\n          }\n        }\n      `}</style>\n    </div>\n  );\n}"
    },

      "path": "src/components/ui/SocialFollowCTA.tsx",
      "content": "'use client';\n\nimport { useState, useEffect, useRef, useCallback, ReactElement } from 'react';\n\ntype Platform = 'twitter' | 'instagram' | 'pinterest' | 'facebook' | 'youtube';\n\ninterface PlatformConfig {\n  name: string;\n  handle: string;\n  url: string;\n  color: string; // brand color, used only on hover/active state\n  Icon: () => ReactElement;\n}\n\nconst ICONS: Record<Platform, () => ReactElement> = {\n  twitter: () => (\n    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" className=\"w-full h-full\">\n      <path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\" />\n    </svg>\n  ),\n  facebook: () => (\n    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" className=\"w-full h-full\">\n      <path d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879v-6.988h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.891h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" />\n    </svg>\n  ),\n  pinterest: () => (\n    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" className=\"w-full h-full\">\n      <path d=\"M12.017 2C6.484 2 2 6.484 2 12.017c0 4.243 2.636 7.868 6.356 9.319-.088-.791-.167-2.005.035-2.868.183-.78 1.180-4.973 1.180-4.973s-.301-.602-.301-1.492c0-1.397.812-2.442 1.822-2.442.859 0 1.273.645 1.273 1.418 0 .865-.55 2.158-.834 3.358-.237 1.005.504 1.825 1.494 1.825 1.793 0 3.17-1.891 3.17-4.618 0-2.414-1.735-4.102-4.212-4.102-2.87 0-4.554 2.152-4.554 4.377 0 .867.334 1.797.751 2.302a.302.302 0 0 1 .07.29c-.076.318-.246 1.005-.28 1.145-.044.183-.145.222-.334.134-1.249-.581-2.030-2.407-2.030-3.874 0-3.154 2.292-6.052 6.608-6.052 3.469 0 6.165 2.472 6.165 5.775 0 3.446-2.173 6.220-5.19 6.220-1.013 0-1.966-.526-2.292-1.148l-.623 2.375c-.226.869-.835 1.958-1.243 2.622.936.29 1.928.446 2.958.446 5.533 0 10.017-4.484 10.017-10.017C22.034 6.484 17.55 2 12.017 2z\" />\n    </svg>\n  ),\n  instagram: () => (\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" className=\"w-full h-full\">\n      <rect x=\"2.5\" y=\"2.5\" width=\"19\" height=\"19\" rx=\"5.5\" stroke=\"currentColor\" strokeWidth=\"1.8\" />\n      <circle cx=\"12\" cy=\"12\" r=\"4.6\" stroke=\"currentColor\" strokeWidth=\"1.8\" />\n      <circle cx=\"17.35\" cy=\"6.65\" r=\"1.15\" fill=\"currentColor\" />\n    </svg>\n  ),\n  youtube: () => (\n    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" className=\"w-full h-full\">\n      <path d=\"M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.376.55A3.016 3.016 0 0 0 .502 6.186 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .502 5.814 3.016 3.016 0 0 0 2.122 2.136C4.495 20.5 12 20.5 12 20.5s7.505 0 9.376-.55a3.016 3.016 0 0 0 2.122-2.136A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.502-5.814zM9.75 15.568V8.432L15.818 12z\" />\n    </svg>\n  ),\n};\n\nconst PLATFORM_CONFIG: Record<Platform, PlatformConfig> = {\n  twitter: {\n    name: 'X',\n    handle: '@mirelleinspo',\n    url: 'https://x.com/mirelleinspo',\n    color: '#000000',\n    Icon: ICONS.twitter,\n  },\n  instagram: {\n    name: 'Instagram',\n    handle: '@mirelle_inspo',\n    url: 'https://instagram.com/mirelle_inspo',\n    color: '#E4405F',\n    Icon: ICONS.instagram,\n  },\n  pinterest: {\n    name: 'Pinterest',\n    handle: '@mirelle_inspo',\n    url: 'https://pinterest.com/mirelle_inspo',\n    color: '#E60023',\n    Icon: ICONS.pinterest,\n  },\n  facebook: {\n    name: 'Facebook',\n    handle: 'mirelleinspo',\n    url: 'https://facebook.com/mirelleinspo',\n    color: '#1877F2',\n    Icon: ICONS.facebook,\n  },\n  youtube: {\n    name: 'YouTube',\n    handle: '@mirelleinspo',\n    url: 'https://www.youtube.com/@mirelleinspo',\n    color: '#FF0000',\n    Icon: ICONS.youtube,\n  },\n};\n\ninterface SocialFollowCTAProps {\n  /** Which platforms this instance displays. Order shown as given. */\n  platforms: Platform[];\n  /** Seconds each platform is highlighted before the emphasis moves on. Default 2.5 */\n  intervalSeconds?: number;\n  className?: string;\n}\n\nfunction SocialIcon({\n  platform,\n  isActive,\n}: {\n  platform: Platform;\n  isActive: boolean;\n}) {\n  const config = PLATFORM_CONFIG[platform];\n\n  const handleClick = useCallback(() => {\n    const isMobile =\n      typeof window !== 'undefined' &&\n      /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);\n    if (isMobile) {\n      window.location.href = config.url;\n    } else {\n      window.open(config.url, '_blank', 'noopener,noreferrer');\n    }\n  }, [config.url]);\n\n  return (\n    <div className=\"flex flex-col items-center gap-2\">\n      <button\n        type=\"button\"\n        onClick={handleClick}\n        aria-label={`Follow us on ${config.name}`}\n        className=\"group relative flex items-center justify-center rounded-full border border-[#252220]/15 bg-[#f9fafb] shadow-sm transition-all duration-500 ease-out hover:scale-110 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#252220]\"\n        style={{\n          width: isActive ? '4rem' : '3.25rem',\n          height: isActive ? '4rem' : '3.25rem',\n          boxShadow: isActive ? `0 0 0 3px ${config.color}22` : undefined,\n        }}\n      >\n        <span\n          className=\"pointer-events-none absolute inset-0 rounded-full transition-opacity duration-500\"\n          style={{\n            opacity: isActive ? 1 : 0,\n            background: `radial-gradient(circle, ${config.color}14 0%, transparent 70%)`,\n          }}\n        />\n        <span\n          className=\"relative transition-all duration-500 ease-out\"\n          style={{\n            width: isActive ? '1.9rem' : '1.5rem',\n            height: isActive ? '1.9rem' : '1.5rem',\n            color: isActive ? config.color : '#252220',\n            opacity: isActive ? 1 : 0.65,\n          }}\n        >\n          <config.Icon />\n        </span>\n      </button>\n\n      <div className=\"flex flex-col items-center text-center\">\n        <span\n          className=\"font-body text-xs leading-tight transition-colors duration-500\"\n          style={{ color: isActive ? '#252220' : '#252220b3' }}\n        >\n          {config.name}\n        </span>\n        <span className=\"font-body text-[10px] text-[#252220]/40 leading-tight\">\n          {config.handle}\n        </span>\n      </div>\n    </div>\n  );\n}\n\nexport default function SocialFollowCTA({\n  platforms,\n  intervalSeconds = 2.5,\n  className = '',\n}: SocialFollowCTAProps) {\n  const [activeIndex, setActiveIndex] = useState(0);\n  const timerRef = useRef<ReturnType<typeof setInterval> | null>(null);\n\n  useEffect(() => {\n    if (platforms.length <= 1) return;\n    timerRef.current = setInterval(() => {\n      setActiveIndex((i) => (i + 1) % platforms.length);\n    }, intervalSeconds * 1000);\n    return () => {\n      if (timerRef.current) clearInterval(timerRef.current);\n    };\n  }, [platforms.length, intervalSeconds]);\n\n  return (\n    <div\n      className={`flex flex-col items-center justify-center gap-6 py-10 ${className}`}\n    >\n      <span className=\"font-ui text-[11px] uppercase tracking-[0.2em] text-[#252220]/60\">\n        Follow us on\n      </span>\n\n      <div className=\"flex items-start justify-center gap-6 sm:gap-10 flex-wrap px-4\">\n        {platforms.map((platform, i) => (\n          <SocialIcon key={platform} platform={platform} isActive={i === activeIndex} />\n        ))}\n      </div>\n    </div>\n  );\n}\n\nexport type { Platform, SocialFollowCTAProps };"

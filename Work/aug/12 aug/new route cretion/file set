      "path": "src/components/Faqs/FaqInlineNewsletter.tsx",
      "content": "// src/components/Faqs/FaqInlineNewsletter.tsx\n'use client';\n\nimport { useState } from 'react';\nimport Image from 'next/image';\n\nexport default function FaqInlineNewsletter() {\n  const [email, setEmail] = useState('');\n  const [status, setStatus] = useState<'idle' | 'loading' | 'success' | 'error'>('idle');\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setStatus('loading');\n    try {\n      const res = await fetch('/api/newsletter', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ email }),\n      });\n      if (res.ok) {\n        setStatus('success');\n        setEmail('');\n        setTimeout(() => setStatus('idle'), 3000);\n      } else {\n        setStatus('error');\n      }\n    } catch {\n      setStatus('error');\n    }\n  };\n\n  return (\n    <section className=\"bg-[#e8e8e8] py-6\">\n      {/* Desktop */}\n      <div className=\"hidden md:flex items-center justify-center gap-8 px-6 lg:px-12\">\n        <div className=\"flex-shrink-0\">\n          <Image src=\"/logo.png\" alt=\"Mirellé Inspo\" width={60} height={60} className=\"object-contain\" />\n        </div>\n        <p className=\"font-body text-foreground text-lg flex-shrink-0\">\n          Elevate the Season with <span className=\"italic\">Mirellé</span>\n        </p>\n        <form onSubmit={handleSubmit} className=\"flex items-center\">\n          <input\n            type=\"email\"\n            value={email}\n            onChange={(e) => setEmail(e.target.value)}\n            placeholder=\"Enter your email\"\n            required\n            className=\"px-4 py-3 border border-gray-300 font-ui text-sm focus:outline-none focus:ring-2 focus:ring-foreground bg-white w-56\"\n          />\n          <button\n            type=\"submit\"\n            disabled={status === 'loading'}\n            className=\"bg-foreground text-white px-6 py-3 font-ui text-sm uppercase tracking-wider hover:opacity-80 transition-opacity disabled:opacity-50 whitespace-nowrap\"\n          >\n            {status === 'loading' ? 'SUBSCRIBING...' : status === 'success' ? '✓ SUBSCRIBED' : 'SUBSCRIBE NOW'}\n          </button>\n        </form>\n      </div>\n\n      {/* Mobile */}\n      <div className=\"md:hidden flex items-center justify-center py-2 px-4 gap-3\">\n        <div className=\"flex-shrink-0\">\n          <Image src=\"/logo.png\" alt=\"Mirellé Inspo\" width={45} height={45} className=\"object-contain\" />\n        </div>\n        <div className=\"flex flex-col gap-2\">\n          <p className=\"font-body text-foreground text-sm leading-tight\">\n            Elevate the Season with <span className=\"italic\">Mirellé</span>\n          </p>\n          <form onSubmit={handleSubmit} className=\"flex\">\n            <input\n              type=\"email\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n              placeholder=\"Your email\"\n              required\n              className=\"px-3 py-2 border border-gray-300 font-ui text-xs focus:outline-none focus:ring-2 focus:ring-foreground bg-white flex-1\"\n            />\n            <button\n              type=\"submit\"\n              disabled={status === 'loading'}\n              className=\"bg-foreground text-white px-3 py-2 font-ui text-xs uppercase tracking-wider hover:opacity-80 transition-opacity disabled:opacity-50 whitespace-nowrap\"\n            >\n              {status === 'loading' ? '...' : status === 'success' ? '✓' : 'SUBSCRIBE'}\n            </button>\n          </form>\n        </div>\n      </div>\n\n      {status === 'error' && (\n        <p className=\"text-red-600 font-ui text-xs text-center mt-2\">Failed to subscribe. Try again.</p>\n      )}\n    </section>\n  );\n}"

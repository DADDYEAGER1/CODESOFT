      "content": "// src/app/nail-faqs/page.tsx\nimport { Metadata } from 'next';\nimport { getAllFaqs, getFaqsByCategory } from '@/lib/faqs';\nimport FaqsGrid from '@/components/Faqs/FaqsGrid';\nimport NextPageButton from '@/components/Blog/NextPageButton';\nexport const dynamic = 'force-static'\nexport const revalidate = false\n\nexport const metadata: Metadata = {\n  title: 'Nail FAQs  Straight Answers to Every Nail Question',\n  description:\n    'Real answers to the most common nail questions  shapes, care, finishing techniques, trends, and what actually works at home. No filler, no fluff.',\n  alternates: { canonical: 'https://mirelleinspo.com/nail-faqs' },\n  openGraph: {\n    title: 'Nail FAQs  Straight Answers to Every Nail Question',\n    description: 'Real answers to common nail questions  shapes, care, finishing techniques, and trends. No filler.',\n    url: 'https://mirelleinspo.com/nail-faqs',\n    siteName: 'Mirellé Inspo',\n    type: 'website',\n    locale: 'en_US',\n    images: [{ url: '/logo.png', width: 250, height: 60, alt: 'Mirellé Inspo Nail FAQs' }],\n  },\n  twitter: {\n    card: 'summary_large_image',\n    title: 'Nail FAQs  Straight Answers to Every Nail Question',\n    description: 'Real answers to common nail questions. No filler, no fluff.',\n    creator: '@mirelleinspo',\n    site: '@mirelleinspo',\n    images: ['/logo.png'],\n  },\n  robots: {\n    index: true,\n    follow: true,\n    googleBot: { index: true, follow: true, 'max-video-preview': -1, 'max-image-preview': 'large', 'max-snippet': -1 },\n  },\n};\n\n\n\ninterface PageProps {\n  searchParams: Promise<{ page?: string; category?: string }>;\n}\n\nexport default async function NailFaqsPage({ searchParams }: PageProps) {\n  const params = await searchParams;\n  const currentPage = Number(params.page) || 1;\n  const selectedCategory = params.category;\n  const postsPerPage = 12;\n\n  if (selectedCategory) {\n    const categoryFaqs = await getFaqsByCategory(selectedCategory);\n    const totalPages = Math.ceil(categoryFaqs.length / postsPerPage);\n    const faqs = categoryFaqs.slice((currentPage - 1) * postsPerPage, currentPage * postsPerPage);\n\n    return (\n      <div className=\"min-h-screen bg-[#f9fafb]\">\n        <section className=\"py-16 bg-[#f9fafb] border-b border-gray-100\">\n          <div className=\"max-w-[1200px] mx-auto px-6 text-center\">\n            <h1 className=\"text-4xl md:text-5xl uppercase\" style={{ fontFamily: 'Larken, Georgia, serif' }}>\n              {selectedCategory.replace(/-/g, ' ')}\n            </h1>\n          </div>\n        </section>\n        <FaqsGrid faqs={faqs} />\n        {currentPage < totalPages && (\n          <NextPageButton href={`/nail-faqs?category=${selectedCategory}&page=${currentPage + 1}`} />\n        )}\n      </div>\n    );\n  }\n\n  const allFaqs = await getAllFaqs();\n  const totalPages = Math.ceil(allFaqs.length / postsPerPage);\n  const faqs = allFaqs.slice((currentPage - 1) * postsPerPage, currentPage * postsPerPage);\n\n  return (\n    <div className=\"min-h-screen bg-[#f9fafb]\">\n      <section className=\"py-24 bg-[#f9fafb] border-b border-gray-100\">\n        <div className=\"max-w-[700px] mx-auto px-6 text-center\">\n          <h1 className=\"text-5xl md:text-6xl mb-6\" style={{ fontFamily: 'Larken, serif' }}>\n            Nail FAQs\n          </h1>\n          <p className=\"text-lg md:text-xl text-gray-500 italic\" style={{ fontFamily: 'Larken, Georgia, serif' }}>\n            &ldquo;Real answers to real nail questions  from techs, for everyone.&rdquo;\n          </p>\n        </div>\n      </section>\n      <FaqsGrid faqs={faqs} />\n      {currentPage < totalPages && (\n        <NextPageButton href={`/nail-faqs?page=${currentPage + 1}`} />\n      )}\n    </div>\n  );\n}"

      "path": "src/components/Faqs/FaqAbout.tsx",
      "content": "// src/components/faqs/FaqAbout.tsx\n\nimport Link from 'next/link';\n\nexport default function AboutEEAT() {\n  return (\n    <section className=\"bg-background py-16 md:py-16 px-[6px] md:px-3 lg:px-[12px]\">\n      <div className=\"max-w-3xl mx-auto text-center\">\n        <h2 className=\"font-heading text-3xl md:text-4xl mb-6\">\n          About Mirellé Inspo\n        </h2>\n\n        <div className=\"font-body text-base md:text-lg leading-relaxed space-y-4 text-foreground/70\">\n          <p>\n            Mirellé is an editorial platform dedicated to nail trends and inspo. We track what the nail community is searching, pinning, and loving  and turn that into curated style guides, trend breakdowns, and inspiration.\n          </p>\n\n          <p>\n            Every piece on this site starts with real research: Pinterest data, search trends, and what nail enthusiasts, techs, and salons are actually gravitating toward. We curate so you don&apos;t have to.\n          </p>\n\n          <div className=\"pt-4\">\n            <Link\n              href=\"/about\"\n              className=\"font-ui text-sm uppercase tracking-wide text-foreground underline hover:no-underline transition-all\"\n            >\n              Learn More About Us\n            </Link>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}"

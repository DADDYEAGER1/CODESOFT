      "path": "src/data/authors.ts",
      "content": "// src/data/authors.ts\n\nimport { Author } from '@/types/author';\n\nexport const authors: Author[] = [\n  {\n    slug: 'ri-mirelle',\n    fullName: 'Gaurav Verma',\n    displayName: 'Ri',\n    role: 'Co-Founder & Editorial Director',\n    bio: 'Ri is the co-founder of Mirellé Inspo. He leads nail industry research, editorial strategy, and every technical layer that powers the publication  from trend data to site infrastructure.',\n    longBio: 'Ri is the co-founder of Mirellé Inspo and the driving force behind its research, strategy, and operations. He specialises in nail industry analysis, tracking what people are actually searching for, pinning, and demanding, then uses that data to shape the editorial direction of the publication. He handles content planning, SEO and GEO strategy, AEO, business development, client onboarding, trend reports, and everything that keeps the site running. Ri built Mirellé on a simple idea: the nail industry deserved a publication built on real demand, not guesswork.',\n    image: '/images/team/ri-mirelle.webp',\n    authorPageUrl: 'https://mirelleinspo.com/authors/ri-mirelle',\n    instagram: 'https://www.instagram.com/ri.atm1relle',\n    linkedin: 'https://www.linkedin.com/in/gaurav-verma-042519268/',\n    knowsAbout: [\n      'Nail Trend Forecasting',\n      'Beauty Industry Research',\n      'Audience Intelligence',\n      'SEO Strategy',\n      'GEO  Generative Engine Optimisation',\n      'AEO  Answer Engine Optimisation',\n      'Editorial Planning',\n      'Content Strategy',\n      'Client Onboarding',\n      'Nail Art Industry Analysis',\n    ],\n  },\n  {\n    slug: 'jyoti-mirelle',\n    fullName: 'Jyotika Verma',\n    displayName: 'Jyoti',\n    role: 'Co-Founder, Content Writer & Social Media Manager',\n    bio: 'Jyoti is the co-founder of Mirellé Inspo. She writes all editorial content across the publication and manages Mirellé\\'s social presence, turning research into writing the nail community actually wants to read.',\n    longBio: 'Jyoti is the co-founder of Mirellé Inspo and leads all content writing and social media management. She writes the blogs, FAQs, work-nail guides, spotlight features, and topic pieces published on the site, bringing research to life in a voice that resonates with the nail community. She manages Mirellé\\'s social presence across Instagram and Pinterest, and stays closely connected to the audience the publication is built for.',\n    image: '/images/team/jyoti-mirellee.webp',\n    authorPageUrl: 'https://mirelleinspo.com/authors/jyoti-mirelle',\n    instagram: 'https://www.instagram.com/jyoti.atm1relle',\n    linkedin: 'https://www.linkedin.com/in/jyotika-verma-b11435372/',\n    knowsAbout: [\n      'Nail Art Content Writing',\n      'Beauty Blogging',\n      'Social Media Management',\n      'Community Management',\n      'Nail Care',\n      'DIY Manicures',\n      'Press-On Nails',\n      'Seasonal Nail Trends',\n      'Nail Art Inspiration',\n    ],\n  },\n];\n\n// ── Helpers ────────────────────────────────────────────────────────────────────\n\nexport function getAuthorBySlug(slug: string): Author | undefined {\n  return authors.find((a) => a.slug === slug);\n}\n\nexport function getAuthorByName(name: string): Author | undefined {\n  return authors.find(\n    (a) =>\n      a.fullName.toLowerCase() === name.toLowerCase() ||\n      a.displayName.toLowerCase() === name.toLowerCase()\n  );\n}\n\n// Maps content frontmatter author strings to the correct Author object.\n// Handles \"Jyoti\", \"Jyotika Verma\", \"Ri\", \"Gaurav Verma\" etc.\nexport function resolveAuthor(authorString: string): Author | undefined {\n  if (!authorString) return undefined;\n  const lower = authorString.toLowerCase().trim();\n\n  if (\n    lower.includes('jyoti') ||\n    lower.includes('jyotika')\n  ) return authors.find((a) => a.slug === 'jyoti-mirelle');\n\n  if (\n    lower.includes('ri') ||\n    lower.includes('gaurav')\n  ) return authors.find((a) => a.slug === 'ri-mirelle');\n\n  return undefined;\n}"

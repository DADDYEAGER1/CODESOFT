n    ],\n    additionalSitemaps: [\n      'https://mirelleinspo.com/sitemap-blog.xml',\n      'https://mirelleinspo.com/sitemap-shop.xml',\n      'https://mirelleinspo.com/sitemap-topics.xml',\n      'https://mirelleinspo.com/sitemap-inspo.xml',\n      'https://mirelleinspo.com/sitemap-spotlight.xml',\n      'https://mirelleinspo.com/sitemap-work-nails.xml',\n      'https://mirelleinspo.com/sitemap-nail-faqs.xml',\n      'https://mirelleinspo.com/sitemap-trend-reports.xml',\n      'https://mirelleinspo.com/sitemap-business.xml',\n      'https://mirelleinspo.com/sitemap-authors.xml',\n      'https://mirelleinspo.com/sitemap-images-index.xml',\n    ],\n  },\n\n  transform: async (config, path) => {\n    let priority = config.priority;\n    let changefreq = config.changefreq;\n    let lastmod = config.autoLastmod ? new Date().toISOString() : undefined;\n\n    if (path === '/') {\n      priority = 1.0;\n      changefreq = 'daily';\n    } else if (['/blog', '/inspo', '/shop'].includes(path)) {\n      priority = 0.9;\n      changefreq = 'daily';\n    } else if (['/topics', '/spotlight', '/work-nails', '/nail-faqs', '/trend-reports', '/business'].includes(path)) {\n      priority = 0.8;\n      changefreq = 'weekly';\n    } else if (['/about', '/contact', '/pinterest', '/work-with-us', '/authors'].includes(path)) {\n      priority = 0.7;\n      changefreq = 'monthly';\n    } else if (['/privacy-policy', '/terms', '/subscribe'].includes(path)) {\n      priority = 0.5;\n      changefreq = 'yearly';\n    }\n\n    return {\n      loc: path,\n      changefreq,\n      priority,\n      lastmod,\n      alternateRefs: config.alternateRefs ?? [],\n    };\n  },\n};"

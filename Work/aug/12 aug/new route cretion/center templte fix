      "path": "src/lib/generateSchemas.ts ",
      "content": "// src/lib/generateSchemas.ts\n\nimport { BlogPost, BlogMetadata, TutorialMetadata } from '@/types/blog';\nimport { Author } from '@/types/author';\nimport { authors, resolveAuthor } from '@/data/authors';\nimport { generateAboutEntities } from './entityMapping';\n\nconst BASE_URL = 'https://mirelleinspo.com';\n\n// ── Shared constants ───────────────────────────────────────────────────────────\n\nconst ORG_ID   = `${BASE_URL}/#organization`;\nconst SITE_ID  = `${BASE_URL}/#website`;\nconst JYOTI_ID = `${BASE_URL}/authors/jyoti-mirelle#person`;\nconst RI_ID    = `${BASE_URL}/authors/ri-mirelle#person`;\n\n// ── Reusable types (exported for page use) ────────────────────────────────────\n\nexport interface FAQItem       { question: string; answer: string }\nexport interface TutorialStep  { position: number; name: string; text: string; image?: string }\nexport interface VideoMetadata { name: string; description: string; thumbnailUrl: string; uploadDate: string; duration?: string; embedUrl?: string }\nexport interface GalleryImage  { url: string; alt: string; width?: number; height?: number; caption?: string }\nexport interface EventData     { name: string; startDate: string; endDate: string; eventStatus: string; eventAttendanceMode: string; isVirtual: boolean }\n\nexport interface SchemaConfig {\n  post: BlogPost;\n  slug: string;\n  faqItems?: FAQItem[];\n  tutorialSteps?: TutorialStep[];\n  tutorialMetadata?: TutorialMetadata;\n  videoMetadata?: VideoMetadata;\n  galleryImages?: GalleryImage[];\n  eventData?: EventData;\n}\n\n// ── ORGANIZATION SCHEMA ───────────────────────────────────────────────────────\n\nexport function generateOrganizationSchema() {\n  return {\n    '@context': 'https://schema.org',\n    '@type': 'Organization',\n    '@id': ORG_ID,\n    'name': 'Mirellé Inspo',\n    'alternateName': 'Mirelle Inspo',\n    'url': BASE_URL,\n    'foundingDate': '2025-09',\n    'logo': {\n      '@type': 'ImageObject',\n      'url': `${BASE_URL}/logo.png`,\n      'width': 250,\n      'height': 60,\n    },\n    'image': `${BASE_URL}/logo.png`,\n    'description': 'Research-driven nail editorial platform covering nail art inspiration, tutorials, trend reports, and seasonal designs for modern women.',\n    'email': 'contact@mirelleinspo.com',\n    'contactPoint': {\n      '@type': 'ContactPoint',\n      'contactType': 'Customer Service',\n      'email': 'contact@mirelleinspo.com',\n      'url': `${BASE_URL}/contact`,\n      'availableLanguage': 'English',\n      'areaServed': 'Worldwide',\n    },\n    'sameAs': [\n      'https://www.instagram.com/mirelle_inspo',\n      'https://www.pinterest.com/mirelle_inspo',\n      'https://x.com/mirelleinspo',\n      'https://www.youtube.com/@mirelleinspo',\n      'https://www.facebook.com/MirelleInspo',\n    ],\n    'founder': [\n      { '@id': JYOTI_ID },\n      { '@id': RI_ID },\n    ],\n    'knowsAbout': [\n      'Nail Art',\n      'Nail Care',\n      'Beauty Trends',\n      'DIY Manicures',\n      'Press-On Nails',\n      'Seasonal Nail Designs',\n      'Nail Trend Forecasting',\n    ],\n    'audience': {\n      '@type': 'Audience',\n      'audienceType': 'Women aged 18–45 interested in nail art, beauty, and DIY manicures',\n    },\n    'areaServed': {\n      '@type': 'Place',\n      'name': 'Worldwide',\n    },\n  };\n}\n\n// ── WEBSITE SCHEMA ────────────────────────────────────────────────────────────\n\nexport function generateWebsiteSchema() {\n  return {\n    '@context': 'https://schema.org',\n    '@type': 'WebSite',\n    '@id': SITE_ID,\n    'name': 'Mirellé Inspo',\n    'url': BASE_URL,\n    'description': 'Nail art inspiration, tutorials, trend reports, and seasonal designs for modern women.',\n    'inLanguage': 'en-US',\n    'publisher': { '@id': ORG_ID },\n    'potentialAction': {\n      '@type': 'SearchAction',\n      'target': {\n        '@type': 'EntryPoint',\n        'urlTemplate': `${BASE_URL}/search?q={search_term_string}`,\n      },\n      'query-input': 'required name=search_term_string',\n    },\n  };\n}\n\n// ── PERSON SCHEMA  JYOTIKA VERMA ────────────────────────────────────────────\n\nexport function generateJyotiSchema() {\n  const author = authors.find((a) => a.slug === 'jyoti-mirelle')!;\n  return {\n    '@context': 'https://schema.org',\n    '@type': 'Person',\n    '@id': JYOTI_ID,\n    'name': author.fullName,\n    'givenName': 'Jyotika',\n    'familyName': 'Verma',\n    'alternateName': 'Jyoti',\n    'url': author.authorPageUrl,\n    'image': `${BASE_URL}${author.image}`,\n    'jobTitle': author.role,\n    'description': author.bio,\n    'worksFor': { '@id': ORG_ID },\n    'knowsAbout': author.knowsAbout,\n    'sameAs': [\n      author.instagram,\n      author.linkedin,\n    ].filter(Boolean),\n  };\n}\n\n// ── PERSON SCHEMA  GAURAV VERMA ─────────────────────────────────────────────\n\nexport function generateRiSchema() {\n  const author = authors.find((a) => a.slug === 'ri-mirelle')!;\n  return {\n    '@context': 'https://schema.org',\n    '@type': 'Person',\n    '@id': RI_ID,\n    'name': author.fullName,\n    'givenName': 'Gaurav',\n    'familyName': 'Verma',\n    'alternateName': 'Ri',\n    'url': author.authorPageUrl,\n    'image': `${BASE_URL}${author.image}`,\n    'jobTitle': author.role,\n    'description': author.bio,\n    'worksFor': { '@id': ORG_ID },\n    'knowsAbout': author.knowsAbout,\n    'sameAs': [\n      author.instagram,\n      author.linkedin,\n    ].filter(Boolean),\n  };\n}\n\n// ── RESOLVE AUTHOR SCHEMA from frontmatter string ─────────────────────────────\n// Used by blog/[...slug], work-nails/[slug], etc. to pick the right Person schema\n\nexport function resolveAuthorSchema(authorString: string) {\n  const author = resolveAuthor(authorString);\n  if (!author) return null;\n  return author.slug === 'ri-mirelle' ? generateRiSchema() : generateJyotiSchema();\n}\n\nexport function resolveAuthorId(authorString: string): string {\n  const author = resolveAuthor(authorString);\n  if (!author) return JYOTI_ID; // default to Jyoti\n  return author.slug === 'ri-mirelle' ? RI_ID : JYOTI_ID;\n}\n\n// ── BLOG ENTITY SCHEMA ────────────────────────────────────────────────────────\n\nexport function generateBlogSchema() {\n  return {\n    '@context': 'https://schema.org',\n    '@type': 'Blog',\n    '@id': `${BASE_URL}/blog#blog`,\n    'url': `${BASE_URL}/blog`,\n    'name': 'Mirellé Inspo Blog',\n    'description': 'Expert nail art inspiration, tutorials, and beauty tips for modern women. Seasonal trends, at-home techniques, and Pinterest-worthy nail designs.',\n    'inLanguage': 'en-US',\n    'publisher': { '@id': ORG_ID },\n    'author': [\n      { '@id': JYOTI_ID },\n    ],\n    'about': [\n      { '@type': 'Thing', 'name': 'Nail Art', 'sameAs': 'https://en.wikipedia.org/wiki/Nail_art' },\n      { '@type': 'Thing', 'name': 'Beauty', 'sameAs': 'https://en.wikipedia.org/wiki/Beauty' },\n      { '@type': 'Thing', 'name': 'Fashion', 'sameAs': 'https://en.wikipedia.org/wiki/Fashion' },\n    ],\n  };\n}\n\n// ── BLOG ITEMLIST SCHEMA ──────────────────────────────────────────────────────\n\nexport function generateBlogListSchema(posts: BlogMetadata[]) {\n  return {\n    '@context': 'https://schema.org',\n    '@type': 'ItemList',\n    'name': 'Mirellé Inspo Blog Posts',\n    'description': 'Complete collection of nail art tutorials, seasonal trends, and beauty inspiration',\n    'url': `${BASE_URL}/blog`,\n    'numberOfItems': posts.length,\n    'itemListElement': posts.map((post, index) => ({\n      '@type': 'ListItem',\n      'position': index + 1,\n      'url': `${BASE_URL}/blog/${post.slug}`,\n      'name': post.title,\n      'description': post.excerpt,\n      'image': post.image ? `${BASE_URL}${post.image}` : undefined,\n    })),\n  };\n}\n\n// ── ARTICLE / BLOGPOSTING SCHEMA ──────────────────────────────────────────────\n\nexport function generateArticleSchema(post: BlogPost) {\n  const articleUrl = `${BASE_URL}/blog/${post.slug}`;\n  const imag
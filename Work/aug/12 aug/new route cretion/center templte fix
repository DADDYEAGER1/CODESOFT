      "path": "src/lib/seo.ts",
      "content": "// src/lib/seo.ts\n\nimport type { Metadata } from 'next';\n\nconst BASE_URL = 'https://mirelleinspo.com';\nconst SITE_NAME = 'Mirellé Inspo';\nconst TWITTER_HANDLE = '@mirelleinspo';\nconst DEFAULT_OG_IMAGE = `${BASE_URL}/logo.png`; // TODO: replace with /og-image.jpg once created\n\n// ── generatePageMetadata ───────────────────────────────────────────────────────\n// Central function  every page.tsx calls this instead of writing raw metadata.\n//\n// Usage:\n//   export const metadata = generatePageMetadata({\n//     title: 'About Us',\n//     description: '...',\n//     path: '/about',\n//   });\n//\n//   // For article pages:\n//   export const metadata = generatePageMetadata({\n//     title: post.title,\n//     description: post.excerpt,\n//     path: `/blog/${post.slug}`,\n//     ogType: 'article',\n//     ogImage: post.image ? `${BASE_URL}${post.image}` : undefined,\n//     publishedTime: post.date,\n//     modifiedTime: post.dateModified,\n//     authorName: post.author,\n//     authorUrl: resolvedAuthor?.authorPageUrl,\n//     noIndex: false,\n//   });\n\nexport interface PageMetadataInput {\n  title: string;                // page title  template \" | Mirellé Inspo\" is applied by root layout\n  description: string;          // 80–155 chars\n  path: string;                 // e.g. '/about' or '/blog/chrome-nails'\n  ogType?: 'website' | 'article';\n  ogImage?: string;             // absolute URL  falls back to DEFAULT_OG_IMAGE\n  ogImageAlt?: string;\n  publishedTime?: string;       // ISO date  article pages only\n  modifiedTime?: string;        // ISO date  article pages only\n  authorName?: string;          // real full name e.g. \"Jyotika Verma\"\n  authorUrl?: string;           // e.g. https://mirelleinspo.com/authors/jyoti-mirelle\n  noIndex?: boolean;            // set true for legal/utility pages\n  keywords?: string[];\n}\n\nexport function generatePageMetadata(input: PageMetadataInput): Metadata {\n  const {\n    title,\n    description,\n    path,\n    ogType = 'website',\n    ogImage = DEFAULT_OG_IMAGE,\n    ogImageAlt = `${title} | ${SITE_NAME}`,\n    publishedTime,\n    modifiedTime,\n    authorName,\n    authorUrl,\n    noIndex = false,\n    keywords,\n  } = input;\n\n  const canonicalUrl = `${BASE_URL}${path}`;\n\n  return {\n    title,\n    description,\n\n    ...(keywords && { keywords }),\n\n    ...(authorName && {\n      authors: [{ name: authorName, url: authorUrl }],\n    }),\n\n    alternates: {\n      canonical: canonicalUrl,\n    },\n\n    openGraph: {\n      title,\n      description,\n      type: ogType,\n      url: canonicalUrl,\n      siteName: SITE_NAME,\n      locale: 'en_US',\n      images: [\n        {\n          url: ogImage,\n          width: 1200,\n          height: 630,\n          alt: ogImageAlt,\n        },\n      ],\n      ...(ogType === 'article' && publishedTime && {\n        publishedTime,\n        modifiedTime: modifiedTime || publishedTime,\n        authors: authorUrl ? [authorUrl] : undefined,\n      }),\n    },\n\n    twitter: {\n      card: 'summary_large_image',\n      title,\n      description,\n      site: TWITTER_HANDLE,\n      creator: TWITTER_HANDLE,\n      images: [ogImage],\n    },\n\n    robots: noIndex\n      ? { index: false, follow: false }\n      : {\n          index: true,\n          follow: true,\n          googleBot: {\n            index: true,\n            follow: true,\n            'max-video-preview': -1,\n            'max-image-preview': 'large',\n            'max-snippet': -1,\n          },\n        },\n  };\n}\n\n// ── Utility helpers (kept from original) ──────────────────────────────────────\n\nexport function generateImageAlt(keyword: string, description: string): string {\n  const alt = `${keyword} ${description}`;\n  return alt.length > 125 ? alt.substring(0, 122) + '...' : alt;\n}\n\nexport function calculateReadTime(wordCount: number): string {\n  const minutes = Math.ceil(wordCount / 200);\n  return `${minutes} min`;\n}\n\nexport function optimizeTitle(title: string, maxLength = 60): string {\n  if (title.length <= maxLength) return title;\n  return title.substring(0, maxLength - 3) + '...';\n}\n\nexport function optimizeDescription(description: string, maxLength = 155): string {\n  if (description.length <= maxLength) return description;\n  return description.substring(0, maxLength - 3) + '...';\n}\n\nexport function validateSlug(slug: string): boolean {\n  return /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug);\n}\n\nexport function generateSlug(title: string): string {\n  return title\n    .toLowerCase()\n    .trim()\n    .replace(/[^\\w\\s-]/g, '')\n    .replace(/[\\s_-]+/g, '-')\n    .replace(/^-+|-+$/g, '');\n}"

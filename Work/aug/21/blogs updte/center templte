import Image from 'next/image';
import { BlogPost } from '@/types/blog';
import MDXContent from './MDXContent';
import Breadcrumbs from '@/components/Breadcrumbs';
import ImageCarousel from '@/components/Blog/ImageCarousel';
import ProductGrid from '@/components/Blog/ProductGrid';
import InlineNewsletter from '@/components/Blog/InlineNewsletter';
import AboutEEAT from '@/components/Blog/AboutEEAT';
import AuthorCard from '@/components/Blog/AuthorCard';
import FinalNewsletter from '@/components/Blog/FinalNewsletter';
import ReadMoreSection from '@/components/Blog/ReadMoreSection';
import TableOfContents from '@/components/Blog/TableOfContents';
import WrapUp from '@/components/Blog/WrapUp';
import AffiliateBanner from '@/components/Blog/AffiliateBanner';
import { getAuthor } from '@/lib/authors';
import { extractBodyImages } from '@/lib/blog';
import ShareButton from '@/components/Blog/ShareButton';
import DownloadButton from '@/components/Blog/DownloadButton';
import GooglePreferredSourceButton from '@/components/Blog/GooglePreferredSourceButton';
import FAQ from '@/components/Blog/FAQ';
import Lightbox from '@/components/Blog/Lightbox';
import SocialFollowCTA from '@/components/ui/SocialFollowCTA';

interface CenterTemplateProps {
  post: BlogPost;
}

function renderContentWithProducts(html: string, products: BlogPost['products']): React.ReactNode {
  if (!products || products.length === 0) return <div dangerouslySetInnerHTML={{ __html: html }} />;
  const parts = html.split(/({{PRODUCTS:\d+:[\d,]+}})/g);
  if (parts.length === 1) return <div dangerouslySetInnerHTML={{ __html: html }} />;
  return (
    <>
      {parts.map((part, index) => {
        const match = part.match(/^{{PRODUCTS:(\d+):([\d,]+)}}$/);
        if (match) {
          const count = parseInt(match[1]) as 1 | 2 | 4;
          const indices = match[2].split(',').map((i) => parseInt(i.trim()));
          if (![1, 2, 4].includes(count)) return null;
          return <ProductGrid key={index} products={products} count={count} indices={indices} />;
        }
        return <div key={index} dangerouslySetInnerHTML={{ __html: part }} />;
      })}
    </>
  );
}

export default function CenterTemplate({ post }: CenterTemplateProps) {
  const postProducts = post.products ?? [];
  const author = post.author ? getAuthor(post.author) : null;
  const bodyImages = extractBodyImages(post.content || '', post.image);

  // Split content into thirds: ~33% / ~67% / rest
  const h2Blocks = (post.content || '').split(/(?=<h2[\s>])/);
  const total = h2Blocks.length;
  const cut1 = Math.max(1, Math.floor(total * 0.33));
  const cut2 = Math.max(cut1 + 1, Math.floor(total * 0.67));
  const firstThird  = h2Blocks.slice(0, cut1).join('');
  const secondThird = h2Blocks.slice(cut1, cut2).join('');
  const lastThird   = h2Blocks.slice(cut2).join('');

  if (post.isMDX) {
    return (
      <div className="min-h-screen bg-background">
        <DownloadButton slug={post.slug} title={post.title} bodyImages={bodyImages} />
        <ShareButton url={post.canonical} title={post.title} />
        <GooglePreferredSourceButton />
        <Lightbox />

        <div className="w-full">
          {/* Sponsor / advertise banner  sits below header, above title */}
          <AffiliateBanner />
          <div className="text-center py-12 md:py-16 px-6" style={{ backgroundColor: '#f9fafb' }}>
            {post.category && <p className="font-ui text-sm uppercase tracking-wider text-gray-600 mb-4">{post.category}</p>}
            <h1 className="font-heading text-[36px] md:text-[42px] leading-tight mb-6" style={{ color: '#252220' }}>{post.title}</h1>
            <p className="font-ui text-sm uppercase tracking-wide mb-2" style={{ color: '#252220' }}>BY {post.author}</p>
            <p className="font-ui text-sm text-gray-600">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
          </div>
          <div className="w-full relative">
            <Image
              src={post.image || "/images/default-blog.jpg"}
              alt={post.imageAlt || post.title}
              width={post.imageWidth || 1200}
              height={post.imageHeight || 630}
              className="w-full h-auto"
              priority
              sizes="100vw"
            />
          </div>
        </div>

        <div className="w-full flex justify-center mt-12">
          <div className="w-full max-w-7xl px-6 md:px-12 lg:px-16">
            <article className="prose-content-magazine">
              <MDXContent source={post.content} products={postProducts} topic={post.topic} showInspoGalleryLink={post.showInspoGalleryLink} />
            </article>
          </div>
        </div>

        <div className="w-full"><SocialFollowCTA platforms={['instagram', 'pinterest', 'twitter', 'facebook', 'youtube']} /></div>

        {post.faqItems && post.faqItems.length > 0 && (
          <div className="w-full flex justify-center">
            <div className="w-full max-w-7xl px-6 md:px-12 lg:px-16">
              <FAQ faqs={post.faqItems} />
            </div>
          </div>
        )}
        <div className="w-full flex justify-center">
          <div className="w-full max-w-7xl px-6 md:px-12 lg:px-16">
            <FinalNewsletter />
          </div>
        </div>
        <div className="w-full flex justify-center">
          <div className="w-full max-w-7xl px-6 md:px-12 lg:px-16">
            {author && <AuthorCard author={author} />}
          </div>
        </div>
        <AboutEEAT />
        <ReadMoreSection currentSlug={post.slug} />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-background">
      <DownloadButton slug={post.slug} title={post.title} bodyImages={bodyImages} />
      <ShareButton url={post.canonical} title={post.title} />
      <GooglePreferredSourceButton />
      <Lightbox />

      {/* Hero */}
      <div className="w-full">
        {/* Sponsor / advertise banner  sits below header, above title */}
        <AffiliateBanner />
        <div className="text-center py-12 md:py-16 px-6" style={{ backgroundColor: '#f9fafb' }}>
          {post.category && <p className="font-ui text-sm uppercase tracking-wider text-gray-600 mb-4">{post.category}</p>}
          <h1 className="font-heading text-[36px] md:text-[42px] leading-tight mb-6" style={{ color: '#252220' }}>{post.title}</h1>
          <p className="font-ui text-sm uppercase tracking-wide mb-2" style={{ color: '#252220' }}>BY {post.author}</p>
          <p className="font-ui text-sm text-gray-600">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        </div>
        <div className="w-full relative">
          <Image
            src={post.image || "/images/default-blog.jpg"}
            alt={post.imageAlt || post.title}
            width={post.imageWidth || 1200}
            height={post.imageHeight || 630}
            className="w-full h-auto"
            priority
            sizes="100vw"
          />
        </div>
      </div>

      <div className="w-full flex justify-center mt-12">
        <div className="w-full max-w-7xl px-6 md:px-12 lg:px-16">
          <div className="mb-8">
            <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }]} currentPage={post.title} includeSchema={false} />
          </div>
          <div className="block lg:hidden mb-8">
            <TableOfContents content={post.content} />
          </div>

          <div>
            {post.tldr && <WrapUp tldr={post.tldr} />}
            <article className="prose-content-magazine">
              {/* First third ~33% */}
              {renderContentWithProducts(firstThird, post.products)}
            </article>
          </div>
        </div>
      </div>

      {/* Inline newsletter 1  at ~33% */}
      <div className="w-full my-10">
        <InlineNewsletter />
      </div>

      <div className="w-full flex justify-center">
        <div className="w-full max-w-7xl px-6 md:px-12 lg:px-16">
          <article className="prose-content-magazine">
            {/* Second third ~33–67% */}
            {renderContentWithProducts(secondThird, post.products)}

            {post.carouselImages && post.carouselImages.length > 0 && (
              <div className="my-12"><ImageCarousel images={post.carouselImages} /></div>
            )}
          </article>
        </div>
      </div>

      <div className="w-full"><SocialFollowCTA platforms={['instagram', 'pinterest', 'twitter', 'facebook', 'youtube']} /></div>

      {/* Inline newsletter 2  at ~67% */}
      <div className="w-full my-10">
        <InlineNewsletter />
      </div>

      <div className="w-full flex justify-center">
        <div className="w-full max-w-7xl px-6 md:px-12 lg:px-16">
          <article className="prose-content-magazine">
            {/* Last third ~67–100% */}
            {renderContentWithProducts(lastThird, post.products)}
          </article>
        </div>
      </div>

      {post.faqItems && post.faqItems.length > 0 && (
        <div className="w-full flex justify-center">
          <div className="w-full max-w-7xl px-6 md:px-12 lg:px-16">
            <FAQ faqs={post.faqItems} />
          </div>
        </div>
      )}
      <div className="w-full flex justify-center">
        <div className="w-full max-w-7xl px-6 md:px-12 lg:px-16">
          <FinalNewsletter />
        </div>
      </div>
      <div className="w-full flex justify-center">
        <div className="w-full max-w-7xl px-6 md:px-12 lg:px-16">
          {author && <AuthorCard author={author} />}
        </div>
      </div>
      <AboutEEAT />
      <ReadMoreSection currentSlug={post.slug} />
    </div>
  );
}

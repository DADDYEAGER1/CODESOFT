instagram', 'pinterest', 'twitter', 'facebook', 'youtube']} /></div>\n\n        {post.faqItems && post.faqItems.length > 0 && (\n          <div className=\"w-full flex justify-center\">\n            <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n              <FAQ faqs={post.faqItems} />\n            </div>\n          </div>\n        )}\n        <div className=\"w-full flex justify-center\">\n          <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n            <FinalNewsletter />\n          </div>\n        </div>\n        <div className=\"w-full flex justify-center\">\n          <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n            {author && <AuthorCard author={author} />}\n          </div>\n        </div>\n        <AboutEEAT />\n        <ReadMoreSection currentSlug={post.slug} />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <DownloadButton slug={post.slug} title={post.title} bodyImages={bodyImages} />\n      <ShareButton url={post.canonical} title={post.title} />\n      <Lightbox />\n\n      {/* Hero: 3-image mosaic (3 → 2 → 1 responsive), edge-to-edge, then title block */}\n      <div className=\"w-full\">\n        <HeroMosaic images={heroImages} alt={post.imageAlt || post.title} />\n        <div className=\"text-center py-12 md:py-16 px-6\" style={{ backgroundColor: '#f9fafb' }}>\n          {post.category && <p className=\"font-ui text-sm uppercase tracking-wider text-gray-600 mb-4\">{post.category}</p>}\n          <h1 className=\"font-heading text-[36px] md:text-[42px] leading-tight mb-6\" style={{ color: '#252220' }}>{post.title}</h1>\n          <p className=\"font-ui text-sm uppercase tracking-wide mb-2\" style={{ color: '#252220' }}>BY {post.author}</p>\n          <p className=\"font-ui text-sm text-gray-600\">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>\n        </div>\n      </div>\n\n      <div className=\"w-full flex justify-center mt-4\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <div className=\"mb-8\">\n            <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }]} currentPage={post.title} includeSchema={false} />\n          </div>\n          <div className=\"block lg:hidden mb-8\">\n            <TableOfContents content={post.content} />\n          </div>\n\n          <div>\n            {post.tldr && <WrapUp tldr={post.tldr} />}\n            <AffiliateBanner\n              imageSrc=\"/images/banners/summer-sale.webp\"\n              imageAlt=\"MelodySusie Summer Sale — up to 50% off nail tools and gel polish\"\n              mobileImageSrc=\"/images/banners/melodysusie-sales-banner-mobile.webp\"\n              mobileImageAlt=\"MelodySusie Summer Sale — up to 50% off nail tools and gel polish\"\n              href=\"https://www.melodysusie.com/pages/deals?aff=3711&utm_campaign=3711&utm_source=affiliate&utm_medium=kol\"\n              width={2000}\n              height={714}\n            />\n            <article className=\"prose-content-magazine\">\n              {/* First third ~33% */}\n              {renderContentWithProducts(firstThird, post.products)}\n            </article>\n          </div>\n        </div>\n      </div>\n\n      {/* Inline newsletter 1  at ~33% */}\n      <div className=\"w-full my-10\">\n        <InlineNewsletter />\n      </div>\n\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <article className=\"prose-content-magazine\">\n            {/* Second third ~33-67% */}\n            {renderContentWithProducts(secondThird, post.products)}\n\n            {post.carouselImages && post.carouselImages.length > 0 && (\n              <div className=\"my-12\"><ImageCarousel images={post.carouselImages} /></div>\n            )}\n          </article>\n        </div>\n      </div>\n\n      <div className=\"w-full\"><SocialFollowCTA platforms={['instagram', 'pinterest', 'twitter', 'facebook', 'youtube']} /></div>\n\n      {/* Inline newsletter 2  at ~67% */}\n      <div className=\"w-full my-10\">\n        <InlineNewsletter />\n      </div>\n\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <article className=\"prose-content-magazine\">\n            {/* Last third ~67-100% */}\n            {renderContentWithProducts(lastThird, post.products)}\n          </article>\n        </div>\n      </div>\n\n      {post.faqItems && post.faqItems.length > 0 && (\n        <div className=\"w-full flex justify-center\">\n          <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n            <FAQ faqs={post.faqItems} />\n          </div>\n        </div>\n      )}\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <FinalNewsletter />\n        </div>\n      </div>\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          {author && <AuthorCard author={author} />}\n        </div>\n      </div>\n      <AboutEEAT />\n      <ReadMoreSection currentSlug={post.slug} />\n    </div>\n  );\n}"

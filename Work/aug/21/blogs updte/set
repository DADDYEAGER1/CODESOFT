      "path": "src/components/Blog/AffiliateBanner.tsx",
      "content": "// src/components/Blog/AffiliateBanner.tsx\nimport Image from 'next/image';\n\nexport interface AffiliateBannerProps {\n  /** Path or URL to the desktop/tablet banner image (e.g. '/images/banners/summer-sale.jpg') */\n  imageSrc: string;\n  /** Descriptive alt text for the desktop/tablet banner image */\n  imageAlt: string;\n  /**\n   * Optional path or URL to a dedicated portrait/mobile banner. If omitted,\n   * the component falls back to cropping `imageSrc` via object-cover on\n   * mobile. Provide this when you have a purpose-built vertical creative\n   * (e.g. an Instagram-story-style graphic) so mobile shows the full\n   * artwork instead of a crop of the wide desktop version.\n   */\n  mobileImageSrc?: string;\n  /** Alt text for the mobile image. Falls back to `imageAlt` if omitted. */\n  mobileImageAlt?: string;\n  /** Intrinsic width of the mobile image, in px. Defaults to 750 (matches the standard portrait creative size). */\n  mobileWidth?: number;\n  /** Intrinsic height of the mobile image, in px. Defaults to 1100 (matches the standard portrait creative size). */\n  mobileHeight?: number;\n  /** Destination affiliate URL */\n  href: string;\n  /** Intrinsic width of the desktop/tablet image, in px */\n  width?: number;\n  /** Intrinsic height of the desktop/tablet image, in px */\n  height?: number;\n  /** Email address shown for brand partnership inquiries */\n  contactEmail?: string;\n}\n\n/**\n * Promotional / affiliate banner.\n *\n * Currently called directly inside each blog template (CenterTemplate,\n * SplitLeftTemplate, etc.) right after the Wrap Up / TL;DR block, so it\n * appears once per post, not globally via blog/layout.tsx anymore.\n *\n * LAYOUT (same structure at every breakpoint):\n *   1. Short disclosure line, above the image: \"We may earn a commission\n *      from this link.\"\n *   2. The banner image itself (clickable). Mobile uses `mobileImageSrc`\n *      at its own aspect ratio if provided; tablet/desktop use `imageSrc`\n *      at its native wide ratio. Only the image swaps by breakpoint —\n *      everything else on the page is identical across screen sizes.\n *   3. A standalone \"Checkout\" button below the image, its own tap target.\n *   4. The brand outreach line: \"Want your brand featured here? Contact us.\"\n *\n * RESPONSIVE IMAGE NOTES:\n *  - The desktop `imageSrc` is a wide banner (~2.8:1). At that ratio on a\n *    ~375px mobile viewport it renders under 140px tall, too short for\n *    artwork/offer text to read.\n *  - Preferred fix: pass `mobileImageSrc` with a dedicated portrait\n *    creative (e.g. 750x1100). Below the `sm` breakpoint that image is\n *    displayed at a forced 3:4 ratio via `aspect-[3/4]` + `object-cover`\n *    (center-cropped if the source isn't exactly 3:4); at `sm` and up the\n *    regular `imageSrc` banner is shown instead. Only one of the two is\n *    ever visible via Tailwind's block/hidden classes.\n *  - Fallback (no `mobileImageSrc` provided): a single image is shown at\n *    all breakpoints, with the *display* aspect ratio overridden by\n *    `aspect-*` utilities and `object-cover` cropping to fill each box:\n *    4:3 on mobile, 16:7 on tablet, native ~2.8:1 on desktop.\n *\n * USAGE EXAMPLE:\n *   <AffiliateBanner\n *     imageSrc=\"/images/banners/summer-sale.webp\"\n *     imageAlt=\"Summer Sale, up to 50% off nail tools and polish\"\n *     mobileImageSrc=\"/images/banners/melodysusie-sales-banner-mobile.webp\"\n *     mobileImageAlt=\"Summer Sale, up to 50% off nail tools and polish\"\n *     href=\"https://your-affiliate-link.com\"\n *   />\n *\n * FTC compliance notes (per the Endorsement Guides \"clear and conspicuous\"\n * standard):\n *  - The short disclosure sits directly above the image, not on a separate\n *    page or behind a click, at every breakpoint.\n *  - Plain language is used (\"we may earn a commission\"), no jargon like\n *    \"affiliate\" alone or \"sponsored\" hashtags standing in for a real\n *    sentence.\n *  - Text is sized to stay readable at the smallest supported viewport\n *    (13px floor) so the disclosure remains \"conspicuous\" on mobile, not\n *    just present.\n *  - The link itself carries rel=\"sponsored noopener noreferrer\" so\n *    search engines and browsers also see the paid-link signal.\n */\nexport default function AffiliateBanner({\n  imageSrc,\n  imageAlt,\n  mobileImageSrc,\n  mobileImageAlt,\n  mobileWidth = 750,\n  mobileHeight = 1100,\n  href,\n  width = 2000,\n  height = 714,\n  contactEmail = 'contact@mirelleinspo.com',\n}: AffiliateBannerProps) {\n  const hasMobileImage = Boolean(mobileImageSrc);\n\n  return (\n    <section className=\"w-full bg-background border-b border-gray-100\">\n      <div className=\"max-w-[1200px] mx-auto px-4 py-3 sm:px-6 sm:py-4\">\n        {/* 1. Short disclosure, above the image at every breakpoint */}\n        <p className=\"mb-2 text-[13px] leading-snug sm:text-ui-xs text-foreground/70 font-ui text-center px-2\">\n          We may earn a commission from this link.\n        </p>\n\n        {/* 2. Banner image (clickable).\n              - Mobile shows `mobileImageSrc` at aspect-[3/4] if provided;\n                tablet/desktop shows `imageSrc` at its native wide ratio.\n              - `priority` + `quality={90}` because this banner is almost\n                always the LCP element wherever it renders in the post; it\n                should preload and not be lazy-loaded or over-compressed. */}\n        {hasMobileImage ? (\n          <>\n            <a\n              href={href}\n              target=\"_blank\"\n              rel=\"sponsored noopener noreferrer\"\n              className=\"block sm:hidden w-full overflow-hidden rounded-lg\"\n            >\n              <Image\n                src={mobileImageSrc as string}\n                alt={mobileImageAlt || imageAlt}\n                width={mobileWidth}\n                height={mobileHeight}\n                sizes=\"100vw\"\n                quality={90}\n                priority\n                className=\"w-full h-full object-cover aspect-[3/4]\"\n              />\n            </a>\n            <a\n              href={href}\n              target=\"_blank\"\n              rel=\"sponsored noopener noreferrer\"\n              className=\"hidden sm:block w-full overflow-hidden rounded-lg\"\n            >\n              <Image\n                src={imageSrc}\n                alt={imageAlt}\n                width={width}\n                height={height}\n                sizes=\"100vw\"\n                quality={90}\n                priority\n                className=\"w-full h-auto\"\n              />\n            </a>\n          </>\n        ) : (\n          <a\n            href={href}\n            target=\"_blank\"\n            rel=\"sponsored noopener noreferrer\"\n            className=\"block w-full overflow-hidden rounded-lg\"\n          >\n            <Image\n              src={imageSrc}\n              alt={imageAlt}\n              width={width}\n              height={height}\n              sizes=\"100vw\"\n              quality={90}\n              priority\n              className=\"w-full h-full object-cover aspect-[4/3] sm:aspect-[16/7] lg:aspect-[2000/714]\"\n            />\n          </a>\n        )}\n\n        {/* 3. Standalone Checkout CTA, below the image, every breakpoint */}\n        <a\n          href={href}\n          target=\"_blank\"\n          rel=\"sponsored noopener noreferrer\"\n          className=\"block w-full mt-3 py-3 rounded-lg bg-foreground text-background text-center text-sm font-ui font-medium tracking-wide hover:opacity-90 transition-opacity\"\n        >\n          Checkout\n        </a>\n\n        {/* 4. Brand outreach line, below the Checkout button */}\n        <p className=\"mt-3 text-[13px] leading-snug sm:text-ui-xs text-foreground/70 font-ui text-center px-2\">\n          Want your brand featured here?{' '}\n          <a\n            href={`mailto:${contactEmail}`}\n            className=\"underline hover:text-foreground transition-colors\"\n          >\n            Contact us\n          </a>\n          .\n        </p>\n      </div>\n    </section>\n  );\n}"
    },

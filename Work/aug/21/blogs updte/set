      "content": "// src/app/blog/templates/PostsTemplate.tsx\nimport Image from 'next/image';\nimport { BlogPost } from '@/types/blog';\nimport MDXContent from './MDXContent';\nimport Breadcrumbs from '@/components/Breadcrumbs';\nimport ImageCarousel from '@/components/Blog/ImageCarousel';\nimport ProductGrid from '@/components/Blog/ProductGrid';\nimport InlineNewsletter from '@/components/Blog/InlineNewsletter';\nimport AboutEEAT from '@/components/Blog/AboutEEAT';\nimport AuthorCard from '@/components/Blog/AuthorCard';\nimport FinalNewsletter from '@/components/Blog/FinalNewsletter';\nimport ReadMoreSection from '@/components/Blog/ReadMoreSection';\nimport TableOfContents from '@/components/Blog/TableOfContents';\nimport WrapUp from '@/components/Blog/WrapUp';\nimport AffiliateBanner from '@/components/Blog/AffiliateBanner';\nimport { getAuthor } from '@/lib/authors';\nimport { extractBodyImages } from '@/lib/blog';\nimport ShareButton from '@/components/Blog/ShareButton';\nimport DownloadButton from '@/components/Blog/DownloadButton';\nimport FAQ from '@/components/Blog/FAQ';\nimport Lightbox from '@/components/Blog/Lightbox';\nimport SocialFollowCTA from '@/components/ui/SocialFollowCTA';\n\ninterface PostsTemplateProps {\n  post: BlogPost;\n}\n\nfunction renderContentWithProducts(html: string, products: BlogPost['products']): React.ReactNode {\n  if (!products || products.length === 0) return <div dangerouslySetInnerHTML={{ __html: html }} />;\n  const parts = html.split(/({{PRODUCTS:\\d+:[\\d,]+}})/g);\n  if (parts.length === 1) return <div dangerouslySetInnerHTML={{ __html: html }} />;\n  return (\n    <>\n      {parts.map((part, index) => {\n        const match = part.match(/^{{PRODUCTS:(\\d+):([\\d,]+)}}$/);\n        if (match) {\n          const count = parseInt(match[1]) as 1 | 2 | 4;\n          const indices = match[2].split(',').map((i) => parseInt(i.trim()));\n          if (![1, 2, 4].includes(count)) return null;\n          return <ProductGrid key={index} products={products} count={count} indices={indices} />;\n        }\n        return <div key={index} dangerouslySetInnerHTML={{ __html: part }} />;\n      })}\n    </>\n  );\n}\n\nexport default function PostsTemplate({ post }: PostsTemplateProps) {\n  const postProducts = post.products ?? [];\n  const author = post.author ? getAuthor(post.author) : null;\n  const bodyImages = extractBodyImages(post.content || '', post.image);\n\n  // Split content into thirds: ~33% / ~67% / rest\n  const h2Blocks = (post.content || '').split(/(?=<h2[\\s>])/);\n  const total = h2Blocks.length;\n  const cut1 = Math.max(1, Math.floor(total * 0.33));\n  const cut2 = Math.max(cut1 + 1, Math.floor(total * 0.67));\n  const firstThird  = h2Blocks.slice(0, cut1).join('');\n  const secondThird = h2Blocks.slice(cut1, cut2).join('');\n  const lastThird   = h2Blocks.slice(cut2).join('');\n\n  if (post.isMDX) {\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <DownloadButton slug={post.slug} title={post.title} bodyImages={bodyImages} />\n        <ShareButton url={post.canonical} title={post.title} />\n        <Lightbox />\n\n        <div className=\"max-w-[1200px] mx-auto\">\n          <div className=\"max-w-[800px] px-6 pt-8\">\n            {post.category && <p className=\"font-ui uppercase text-xs text-foreground/50 tracking-wider mt-6\">{post.category}</p>}\n            <h1 className=\"font-heading text-4xl md:text-5xl leading-tight mt-3 mb-4\" style={{ color: '#252220' }}>{post.title}</h1>\n            <div className=\"flex items-center gap-2 font-ui text-sm text-foreground/60 mb-8\">\n              <span>BY {post.author?.toUpperCase()}</span>\n              <span>·</span>\n              <time dateTime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>\n            </div>\n          </div>\n\n          {/* Hero — 16:9, left-aligned with title, can extend wider than text column */}\n          <div className=\"px-6 mb-8\">\n            <div className=\"w-full max-w-[1000px] aspect-[16/9] overflow-hidden bg-foreground/5 relative mx-auto\">\n              <Image\n                src={post.image || \"/images/default-blog.jpg\"}\n                alt={post.imageAlt || post.title}\n                width={post.imageWidth || 1200}\n                height={post.imageHeight || 675}\n                className=\"w-full h-full object-cover\"\n                priority\n                sizes=\"(max-width: 1000px) 100vw, 1000px\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <div className=\"w-full flex justify-center mt-4\">\n          <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n            <article className=\"prose-content-magazine\">\n              <MDXContent source={post.content} products={postProducts} topic={post.topic} showInspoGalleryLink={post.showInspoGalleryLink} />\n            </article>\n          </div>\n        </div>\n\n        <div className=\"w-full\"><SocialFollowCTA platforms={['instagram', 'pinterest', 'twitter', 'facebook', 'youtube']} /></div>\n\n        {post.faqItems && post.faqItems.length > 0 && (\n          <div className=\"w-full flex justify-center\">\n            <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n              <FAQ faqs={post.faqItems} />\n            </div>\n          </div>\n        )}\n        <div className=\"w-full flex justify-center\">\n          <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n            <FinalNewsletter />\n          </div>\n        </div>\n        <div className=\"w-full flex justify-center\">\n          <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n            {author && <AuthorCard author={author} />}\n          </div>\n        </div>\n        <AboutEEAT />\n        <ReadMoreSection currentSlug={post.slug} />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <DownloadButton slug={post.slug} title={post.title} bodyImages={bodyImages} />\n      <ShareButton url={post.canonical} title={post.title} />\n      <Lightbox />\n\n      {/* Hero */}\n      <div className=\"max-w-[1200px] mx-auto\">\n        <div className=\"max-w-[800px] px-6 pt-8\">\n          <div className=\"mb-6\">\n            <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }]} currentPage={post.title} includeSchema={false} />\n          </div>\n          {post.category && <p className=\"font-ui uppercase text-xs text-foreground/50 tracking-wider\">{post.category}</p>}\n          <h1 className=\"font-heading text-4xl md:text-5xl leading-tight mt-3 mb-4\" style={{ color: '#252220' }}>{post.title}</h1>\n          <div className=\"flex items-center gap-2 font-ui text-sm text-foreground/60 mb-8\">\n            <span>BY {post.author?.toUpperCase()}</span>\n            <span>·</span>\n            <time dateTime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>\n          </div>\n        </div>\n\n        {/* Hero image — 16:9, left-aligned with title, can extend wider than text column */}\n        <div className=\"px-6 mb-8\">\n          <div className=\"w-full max-w-[1000px] aspect-[16/9] overflow-hidden bg-foreground/5 relative mx-auto\">\n            <Image\n              src={post.image || \"/images/default-blog.jpg\"}\n              alt={post.imageAlt || post.title}\n              width={post.imageWidth || 1200}\n              height={post.imageHeight || 675}\n              className=\"w-full h-full object-cover\"\n              priority\n              sizes=\"(max-width: 1000px) 100vw, 1000px\"\n            />\n          </div>\n        </div>\n      </div>\n\n      <div className=\"w-full flex justify-center mt-4\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <div className=\"block lg:hidden mb-8\">\n            <TableOfContents content={post.content} />\n          </div>\n\n          <div>\n            {post.tldr && <WrapUp tldr={post.tldr} />}\n            {/* Affiliate banner  moved here from blog/layout.tsx so it now\n                shows once, directly after the Wrap Up / TL;DR block, instead\n                of above the header on every blog page. */}\n            <AffiliateBanner\n              imageSrc=\"/images/banners/summer-sale.webp\"\n              imageAlt=\"MelodySusie Summer Sale — up to 50% off nail tools and gel polish\"\n              mobileImageSrc=\"/images/banners/melodysusie-sales-banner-mobile.webp\"\n              mobileImageAlt=\"MelodySusie Summer Sale — up to 50% off nail tools and gel polish\"\n              href=\"https://www.melodysusie.com/pages/deals?aff=3711&utm_campaign=3711&utm_source=affiliate&utm_medium=kol\"\n              width={2000}\n              height={714}\n            />\n            <article className=\"prose-content-magazine\">\n              {/* First third ~33% */}\n              {renderContentWithProducts(firstThird, post.products)}\n            </article>\n          </div>\n        </div>\n      </div>\n\n      {/* Inline newsletter 1  at ~33% */}\n      <div className=\"w-full my-10\">\n        <InlineNewsletter />\n      </div>\n\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <article className=\"prose-content-magazine\">\n            {/* Second third ~33–67% */}\n            {renderContentWithProducts(secondThird, post.products)}\n\n            {post.carouselImages && post.carouselImages.length > 0 && (\n              <div className=\"my-12\"><ImageCarousel images={post.carouselImages} /></div>\n            )}\n          </article>\n        </div>\n      </div>\n\n      <div className=\"w-full\"><SocialFollowCTA platforms={['instagram', 'pinterest', 'twitter', 'facebook', 'youtube']} /></div>\n\n      {/* Inline newsletter 2  at ~67% */}\n      <div className=\"w-full my-10\">\n        <InlineNewsletter />\n      </div>\n\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <article className=\"prose-content-magazine\">\n            {/* Last third ~67–100% */}\n            {renderContentWithProducts(lastThird, post.products)}\n          </article>\n        </div>\n      </div>\n\n      {post.faqItems && post.faqItems.length > 0 && (\n        <div className=\"w-full flex justify-center\">\n          <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n            <FAQ faqs={post.faqItems} />\n          </div>\n        </div>\n      )}\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <FinalNewsletter />\n        </div>\n      </div>\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          {author && <AuthorCard author={author} />}\n        </div>\n      </div>\n      <AboutEEAT />\n      <ReadMoreSection currentSlug={post.slug} />\n    </div>\n  );\n}"
    },
    {
      "path": "src/app/blog/templates/MDXContent.tsx",
      "content": "import { MDXRemote } from 'next-mdx-remote/rsc';\nimport ProductGrid from '@/components/Blog/ProductGrid';\nimport { Product } from '@/types/blog';\n\ninterface MDXContentProps {\n  source: string;\n  products: Product[];\n  topic?: string;\n  showInspoGalleryLink?: boolean;\n}\n\nfunction humanizeTopic(topic: string): string {\n  return topic.replace(/-/g, ' ');\n}\n\nexport default function MDXContent({ source, products, topic, showInspoGalleryLink = true }: MDXContentProps) {\n  const mdxComponents = {\n    ProductGrid: (props: any) => (\n      <ProductGrid {...props} products={products} />\n    ),\n    // Auto-wrap every <img> in MDX content with the inspo gallery link,\n    // matching the same behavior as MD posts. Only renders if `topic`\n    // is present in frontmatter AND showInspoGalleryLink is not false.\n    img: (props: any) => {\n      if (!topic || !showInspoGalleryLink) return <img {...props} />;\n      const galleryHref = `/inspo/${topic}-inspiration-gallery`;\n      return (\n        <>\n          <img {...props} />\n          <p className=\"inspo-gallery-link\">\n            <a href={galleryHref}>Explore {humanizeTopic(topic)} inspiration gallery</a>\n          </p>\n        </>\n      );\n    },\n  };\n\n  return (\n    <MDXRemote\n      source={source}\n      components={mdxComponents}\n    />\n  );\n}"
    }
  ],
  "missing": []
}

ndex} products={products} count={count} indices={indices} />;\n        }\n        return <div key={index} dangerouslySetInnerHTML={{ __html: part }} />;\n      })}\n    </>\n  );\n}\n\n/**\n * Hero mosaic: takes up to 3 images (hero cover image + first 2 body images,\n * falling back to more body images if no cover image is set) and lays them\n * edge-to-edge (no outer padding, small gap between tiles):\n *   - Desktop (lg+):  3 images side by side\n *   - Tablet (md):    2 images side by side, 3rd dropped\n *   - Mobile:         1 image, full width\n */\nfunction HeroMosaic({ images, alt }: { images: string[]; alt: string }) {\n  const tiles = images.slice(0, 3);\n  if (tiles.length === 0) return null;\n\n  // Column count reflects how many tiles actually exist, so a 1- or 2-image\n  // post never reserves empty grid tracks on wide screens.\n  const colClass =\n    tiles.length >= 3\n      ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'\n      : tiles.length === 2\n      ? 'grid-cols-1 md:grid-cols-2'\n      : 'grid-cols-1';\n\n  return (\n    <div className={`w-full grid ${colClass} gap-2`}>\n      {tiles.map((src, i) => (\n        <div\n          key={src + i}\n          className={`relative aspect-square overflow-hidden ${\n            i === 2 && tiles.length === 3 ? 'hidden lg:block' : ''\n          }`}\n        >\n          <img\n            src={src}\n            alt={`${alt} ${i + 1}`}\n            className=\"w-full h-full object-cover\"\n          />\n        </div>\n      ))}\n    </div>\n  );\n}\n\nexport default function GridTemplate({ post }: GridTemplateProps) {\n  const postProducts = post.products ?? [];\n  const author = post.author ? getAuthor(post.author) : null;\n  const bodyImages = extractBodyImages(post.content || '', post.image);\n\n  // Hero mosaic pulls the cover image first, then fills remaining slots\n  // from body images so it always tries for 3 tiles.\n  const heroImages = [post.image, ...bodyImages].filter(Boolean) as string[];\n\n  //
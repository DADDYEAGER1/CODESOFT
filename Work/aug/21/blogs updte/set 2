      "path": "src/components/Blog/Lightbox.tsx",
      "content": "'use client';\n\nimport { useState, useEffect, useCallback, useRef } from 'react';\nimport { X, Download } from 'lucide-react';\n\nconst FacebookIcon = () => (\n  <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"currentColor\">\n    <path d=\"M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.022 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.773-1.63 1.563v1.875h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.918 8.437-9.94z\" />\n  </svg>\n);\n\nconst PinterestIcon = () => (\n  <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"currentColor\">\n    <path d=\"M12.017 2C6.484 2 2 6.485 2 12.017c0 4.243 2.636 7.866 6.357 9.32-.088-.79-.167-2.005.035-2.868.183-.78 1.18-4.97 1.18-4.97s-.3-.605-.3-1.498c0-1.404.814-2.452 1.828-2.452.862 0 1.279.647 1.279 1.422 0 .867-.553 2.16-.838 3.358-.238 1.002.503 1.82 1.49 1.82 1.789 0 3.165-1.887 3.165-4.605 0-2.407-1.73-4.09-4.196-4.09-2.86 0-4.54 2.144-4.54 4.36 0 .863.328 1.79.738 2.293a.3.3 0 0 1 .069.286c-.076.32-.246.998-.28 1.137-.043.183-.143.222-.33.134-1.234-.575-2.005-2.378-2.005-3.827 0-3.117 2.264-5.98 6.529-5.98 3.428 0 6.094 2.443 6.094 5.706 0 3.404-2.146 6.144-5.124 6.144-1.001 0-1.943-.52-2.265-1.135 0 0-.496 1.886-.616 2.348-.222.855-.823 1.928-1.225 2.582.923.286 1.902.44 2.92.44 5.532 0 10.016-4.485 10.016-10.017C22.034 6.485 17.55 2 12.017 2z\" />\n  </svg>\n);\n\nconst XIcon = () => (\n  <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"currentColor\">\n    <path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\" />\n  </svg>\n);\n\ninterface LightboxState {\n  src: string;\n  alt: string;\n}\n\n/**\n * Mount once per template. Listens for clicks on <img> tags inside\n * .prose-content-magazine (blog body content) and opens a fullscreen\n * lightbox. Works for both MD (dangerouslySetInnerHTML) and MDX\n * (MDXRemote) content since it uses event delegation on the container,\n * not per-image handlers.\n */\nexport default function Lightbox() {\n  const [active, setActive] = useState<LightboxState | null>(null);\n  const pageUrl = typeof window !== 'undefined' ? window.location.href : '';\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    function handleClick(e: MouseEvent) {\n      const target = e.target as HTMLElement;\n      if (target.tagName !== 'IMG') return;\n\n      // Only intercept images inside the blog body content\n      const inProse = target.closest('.prose-content-magazine');\n      if (!inProse) return;\n\n      const img = target as HTMLImageElement;\n      setActive({ src: img.currentSrc || img.src, alt: img.alt || '' });\n    }\n\n    document.addEventListener('click', handleClick);\n    return () => document.removeEventListener('click', handleClick);\n  }, []);\n\n  const close = useCallback(() => setActive(null), []);\n\n  useEffect(() => {\n    if (!active) return;\n    function handleKey(e: KeyboardEvent) {\n      if (e.key === 'Escape') close();\n    }\n    document.addEventListener('keydown', handleKey);\n    document.body.style.overflow = 'hidden';\n    return () => {\n      document.removeEventListener('keydown', handleKey);\n      document.body.style.overflow = '';\n    };\n  }, [active, close]);\n\n  if (!active) return null;\n\n  const absoluteImgUrl = active.src.startsWith('http')\n    ? active.src\n    : typeof window !== 'undefined'\n    ? `${window.location.origin}${active.src}`\n    : active.src;\n\n  async function handleDownload() {\n    try {\n      const res = await fetch(active!.src);\n      const blob = await res.blob();\n      const blobUrl = URL.createObjectURL(blob);\n      const a = document.createElement('a');\n      a.href = blobUrl;\n      const filename = active!.src.split('/').pop() || 'image.jpg';\n      a.download = filename;\n      document.body.appendChild(a);\n      a.click();\n      document.body.removeChild(a);\n      URL.revokeObjectURL(blobUrl);\n    } catch {\n      // fallback: open in new tab if fetch/blob fails (e.g. CORS)\n      window.open(active!.src, '_blank');\n    }\n  }\n\n  function openShare(href: string) {\n    const isMobile = typeof navigator !== 'undefined' && /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);\n    if (isMobile) {\n      window.open(href, '_blank');\n    } else {\n      window.open(href, '_blank', 'noopener,noreferrer,width=600,height=600');\n    }\n  }\n\n  function shareFacebook() {\n    openShare(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`);\n  }\n\n  function shareX() {\n    openShare(`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}`);\n  }\n\n  function pinterestSave() {\n    openShare(\n      `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(pageUrl)}&media=${encodeURIComponent(\n        absoluteImgUrl\n      )}&description=${encodeURIComponent(active!.alt)}`\n    );\n  }\n\n  return (\n    <div\n      ref={containerRef}\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Image viewer\"\n      onClick={close}\n      className=\"fixed inset-0 z-[100] flex items-center justify-center\"\n      style={{ backgroundColor: 'rgba(0,0,0,0.92)' }}\n    >\n      {/* Close button */}\n      <button\n        onClick={close}\n        aria-label=\"Close\"\n        className=\"absolute top-4 right-4 w-10 h-10 rounded-full flex items-center justify-center\"\n        style={{ backgroundColor: 'rgba(255,255,255,0.1)', color: '#fff' }}\n      >\n        <X size={22} />\n      </button>\n\n      {/* Image  fit within viewport, no crop, no upscale beyond natural size */}\n      <img\n        src={active.src}\n        alt={active.alt}\n        onClick={(e) => e.stopPropagation()}\n        className=\"block\"\n        style={{\n          maxWidth: '90vw',\n          maxHeight: '72vh',\n          width: 'auto',\n          height: 'auto',\n          objectFit: 'contain',\n        }}\n      />\n\n      {/* Download  centered below image, with breathing room */}\n      <button\n        onClick={(e) => {\n          e.stopPropagation();\n          handleDownload();\n        }}\n        className=\"absolute flex items-center gap-2 px-4 py-2 rounded-full text-sm\"\n        style={{\n          bottom: '6vh',\n          left: '50%',\n          transform: 'translateX(-50%)',\n          backgroundColor: 'rgba(255,255,255,0.12)',\n          color: '#fff',\n        }}\n      >\n        <Download size={16} />\n        Download image\n      </button>\n\n      {/* Share buttons  bottom-right, thumb zone on mobile, same corner on desktop */}\n      <div\n        onClick={(e) => e.stopPropagation()}\n        className=\"absolute flex flex-col items-center gap-3\"\n        style={{ bottom: '84px', right: '16px' }}\n      >\n        <button\n          onClick={pinterestSave}\n          aria-label=\"Save to Pinterest\"\n          title=\"Save to Pinterest\"\n          className=\"w-11 h-11 rounded-full flex items-center justify-center\"\n          style={{ backgroundColor: '#fff', color: '#111' }}\n        >\n          <PinterestIcon />\n        </button>\n        <button\n          onClick={shareFacebook}\n          aria-label=\"Share on Facebook\"\n          title=\"Share on Facebook\"\n          className=\"w-11 h-11 rounded-full flex items-center justify-center\"\n          style={{ backgroundColor: '#fff', color: '#111' }}\n        >\n          <FacebookIcon />\n        </button>\n        <button\n          onClick={shareX}\n          aria-label=\"Share on X\"\n          title=\"Share on X\"\n          className=\"w-11 h-11 rounded-full flex items-center justify-center\"\n          style={{ backgroundColor: '#fff', color: '#111' }}\n        >\n          <XIcon />\n        </button>\n      </div>\n    </div>\n  );\n}"

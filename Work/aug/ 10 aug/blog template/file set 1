ssName=\"w-full my-10\">\n        <InlineNewsletter />\n      </div>\n\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <article className=\"prose-content-magazine\">\n            {/* Second third ~33–67% */}\n            {renderContentWithProducts(secondThird, post.products)}\n\n            {post.carouselImages && post.carouselImages.length > 0 && (\n              <div className=\"my-12\"><ImageCarousel images={post.carouselImages} /></div>\n            )}\n          </article>\n        </div>\n      </div>\n\n      <div className=\"w-full\"><SocialFollowCTA platforms={['instagram', 'pinterest', 'twitter', 'facebook', 'youtube']} /></div>\n\n      {/* Inline newsletter 2  at ~67% */}\n      <div className=\"w-full my-10\">\n        <InlineNewsletter />\n      </div>\n\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <article className=\"prose-content-magazine\">\n            {/* Last third ~67–100% */}\n            {renderContentWithProducts(lastThird, post.products)}\n          </article>\n        </div>\n      </div>\n\n      {post.faqItems && post.faqItems.length > 0 && (\n        <div className=\"w-full flex justify-center\">\n          <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n            <FAQ faqs={post.faqItems} />\n          </div>\n        </div>\n      )}\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          <FinalNewsletter />\n        </div>\n      </div>\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-7xl px-6 md:px-12 lg:px-16\">\n          {author && <AuthorCard author={author} />}\n        </div>\n      </div>\n      <AboutEEAT />\n      <ReadMoreSection currentSlug={post.slug} />\n    </div>\n  );\n}"

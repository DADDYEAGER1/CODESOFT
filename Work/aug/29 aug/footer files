// ─── Date window ────────────────────────────────────────────────────────────
// "Latest from Mirellé" shows whatever was pushed with a frontmatter `date`
// inside the trailing 15-day window from the moment the site builds.
// This is a rolling window, not a calendar month - it always looks back
// 15 days from "now", so it naturally refreshes on every rebuild/deploy.

const RECENT_WINDOW_DAYS = 15;

function isWithinLastNDays(dateString: string, days: number = RECENT_WINDOW_DAYS): boolean {
  const postDate = new Date(dateString);
  if (isNaN(postDate.getTime())) return false; // malformed/missing date → exclude, don't crash

  const now = new Date();
  const windowStart = new Date(now);
  windowStart.setDate(windowStart.getDate() - days);

  return postDate >= windowStart && postDate <= now;
}

// ─── Footer data ────────────────────────────────────────────────────────────

async function getFooterData() {
  const [allBlogs, allShop, allBusiness, allFaqs, allPinterest, allReports] = await Promise.all([
    getAllBlogPosts(),
    getAllShopPosts(),
    getAllBusinessPosts(),
    getAllFaqs(),
    getAllPinterestReports(),
    getAllReports(),
  ]);

  // Every getAllX() above already sorts newest-first, so after filtering by
  // date we just map straight to {title, url} - no re-sorting or slicing needed.

  const blogs = allBlogs
    .filter((p) => isWithinLastNDays(p.date))
    .map((p) => ({
      title: p.title,
      url: p.url.replace('https://mirelleinspo.com', ''),
    }));

  const shop = allShop
    .filter((p) => isWithinLastNDays(p.date))
    .map((p) => ({
      title: p.title,
      url: `/shop/${p.productType}/${p.slug}`,
    }));

  const business = allBusiness
    .filter((p) => isWithinLastNDays(p.date))
    .map((p) => ({
      title: p.title,
      url: `/business/${p.slug}`,
    }));

  const faqs = allFaqs
    .filter((f) => isWithinLastNDays(f.date))
    .map((f) => ({
      title: f.title,
      url: `/nail-faqs/${f.slug}`,
    }));

  const pinterest = allPinterest
    .filter((r) => isWithinLastNDays(r.date))
    .map((r) => ({
      title: r.title,
      url: `/pinterest/${r.slug}`,
    }));

  const reports = allReports
    .filter((r) => isWithinLastNDays(r.date))
    .map((r) => ({
      title: r.title,
      url: `/trend-reports/${r.slug}`,
    }));

  return { blogs, shop, business, faqs, pinterest, reports };
}


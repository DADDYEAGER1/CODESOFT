'use client';

// src/components/FooterClient.tsx
// "Latest from Mirellé" - collapsed by default on all screens.
// Uses native <details>/<summary> for guaranteed collapse behavior, no state bugs.
//
// Shows only content published in the last 15 days, across 6 categories:
// Edits (blog), Shop, Business, FAQs, Pinterest, Trend Reports.
// A category with zero posts in the last 15 days is hidden entirely.

import Link from 'next/link';

interface FooterLink {
  title: string;
  url: string;
}

interface Props {
  blogs: FooterLink[];
  shop: FooterLink[];
  business: FooterLink[];
  faqs: FooterLink[];
  pinterest: FooterLink[];
  reports: FooterLink[];
}

function LinkGrid({ links }: { links: FooterLink[] }) {
  const safeLinks = links ?? []; // defensive: never crash on a missing/undefined prop

  return (
    <ul className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-2">
      {safeLinks.map((link) => (
        <li key={link.url}>
          <Link
            href={link.url}
            prefetch={false} // ← collapsed links: no need to prefetch until clicked
            className="font-body text-[#252220]/55 hover:text-[#252220] transition-colors text-xs leading-snug block py-1 line-clamp-1"
          >
            {link.title}
          </Link>
        </li>
      ))}
    </ul>
  );
}

function SubSection({ title, links }: { title: string; links: FooterLink[] }) {
  const safeLinks = links ?? []; // defensive: never crash on a missing/undefined prop

  // Hide the whole accordion row if this category has no posts in the window.
  if (safeLinks.length === 0) return null;

  return (
    <details className="group border-t border-[#252220]/10">
      <summary className="w-full py-3 flex items-center justify-between text-left cursor-pointer list-none">
        <span className="font-ui text-xs uppercase tracking-widest text-[#252220]/40">
          {title}
        </span>
        <svg
          className="w-4 h-4 transition-transform duration-200 group-open:rotate-180"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div className="pb-5">
        <LinkGrid links={safeLinks} />
      </div>
    </details>
  );
}

export default function FooterClient({ blogs, shop, business, faqs, pinterest, reports }: Props) {
  // If every category is empty (e.g. a quiet 15-day window), don't render
  // an empty "Latest from Mirellé" shell at all.
  const hasAnyContent =
    blogs.length > 0 ||
    shop.length > 0 ||
    business.length > 0 ||
    faqs.length > 0 ||
    pinterest.length > 0 ||
    reports.length > 0;

  if (!hasAnyContent) return null;

  return (
    <details className="group mb-10 border-b border-[#252220]/20 pb-10">
      <summary className="w-full py-4 flex items-center justify-between text-left cursor-pointer list-none">
        <h3 className="font-ui text-sm uppercase tracking-widest text-[#252220]">
          Latest from Mirellé
        </h3>
        <svg
          className="w-4 h-4 transition-transform duration-200 group-open:rotate-180"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div className="mt-1">
        <SubSection title="Edits" links={blogs} />
        <SubSection title="Shop" links={shop} />
        <SubSection title="Business" links={business} />
        <SubSection title="FAQs" links={faqs} />
        <SubSection title="Pinterest" links={pinterest} />
        <SubSection title="Trend Reports" links={reports} />
      </div>
    </details>
  );
}


      "content": "import 'server-only';\nimport fs from 'fs';\nimport path from 'path';\nimport matter from 'gray-matter';\nimport { NailFeedPost, NailFeedMetadata } from '@/types/nailfeed';\nimport { marked } from 'marked';\n\n// Configure marked to handle HTML properly - same config as blog.ts\nmarked.setOptions({\n  breaks: true,\n  gfm: true,\n});\n\n// Custom renderer to preserve HTML and fix image paths - same as blog.ts\nconst renderer = new marked.Renderer();\n\nrenderer.html = (html: string) => {\n  return html.replace(/src=\"images\\//g, 'src=\"/images/');\n};\n\nrenderer.image = (href: string, title: string | null, text: string) => {\n  const fixedHref = href.startsWith('images/') ? `/${href}` : href;\n  const titleAttr = title ? ` title=\"${title}\"` : '';\n  return `<img src=\"${fixedHref}\" alt=\"${text}\"${titleAttr} loading=\"lazy\" />`;\n};\n\nmarked.use({ renderer });\n\nconst NAILFEED_DIRECTORY = path.join(process.cwd(), 'src/content/nailfeed');\n\n// ─── Helpers ─────────────────────────────────────────────────────────────────\n// Nail Feed is flat by design (no topic-folder nesting - confirmed), but this\n// still walks recursively in case content ever needs a shallow organizational\n// subfolder on disk without it affecting the flat /nail-feed/[slug] URL.\n\nfunction getAllNailFeedFilesRecursive(dir: string, base: string = ''): string[] {\n  let results: string[] = [];\n  let entries: fs.Dirent[];\n\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true });\n  } catch {\n    return [];\n  }\n\n  for (const entry of entries) {\n    const relativePath = base ? `${base}/${entry.name}` : entry.name;\n\n    if (entry.isDirectory()) {\n      results = results.concat(getAllNailFeedFilesRecursive(path.join(dir, entry.name), relativePath));\n    } else if (entry.isFile() && (entry.name.endsWith('.md') || entry.name.endsWith('.mdx'))) {\n      results.push(relativePath);\n    }\n  }\n\n  return results;\n}\n\nfunction fileToSlug(relativePath: string): string {\n  return relativePath.replace(/\\.mdx?$/, '');\n}\n\nfunction resolveFilePath(slug: string): { filePath: string; isMDX: boolean } | null {\n  const flatMdx = path.join(NAILFEED_DIRECTORY, `${slug}.mdx`);\n  const flatMd  = path.join(NAILFEED_DIRECTORY, `${slug}.md`);\n  if (fs.existsSync(flatMdx)) return { filePath: flatMdx, isMDX: true };\n  if (fs.existsSync(flatMd))  return { filePath: flatMd,  isMDX: false };\n\n  const allFiles = getAllNailFeedFilesRecursive(NAILFEED_DIRECTORY);\n\n  for (const relativePath of allFiles) {\n    const relativeSlug = fileToSlug(relativePath);\n    const fileBasename = path.basename(relativeSlug);\n    if (fileBasename === slug) {\n      const filePath = path.join(NAILFEED_DIRECTORY, relativePath);\n      return { filePath, isMDX: relativePath.endsWith('.mdx') };\n    }\n  }\n\n  return null;\n}\n\n// ─── Cache ───────────────────────────────────────────────────────────────────\n\ninterface CacheEntry<T> {\n  data: T;\n  timestamp: number;\n}\n\nclass NailFeedCache {\n  private cache = new Map<string, CacheEntry<any>>();\n  private readonly TTL = 3600000;\n\n  get<T>(key: string): T | null {\n    const entry = this.cache.get(key);\n    if (!entry) return null;\n    if (Date.now() - entry.timestamp > this.TTL) {\n      this.cache.delete(key);\n      return null;\n    }\n    return entry.data as T;\n  }\n\n  set<T>(key: string, data: T): void {\n    this.cache.set(key, { data, timestamp: Date.now() });\n  }\n\n  clear(): void {\n    this.cache.clear();\n  }\n}\n\nconst nailFeedCache = new NailFeedCache();\n\n// ─── Public API ──────────────────────────────────────────────────────────────\n\nexport async function getAllNailFeedPosts(): Promise<NailFeedMetadata[]> {\n  const cacheKey = 'all-nailfeed-posts';\n\n  const cached = nailFeedCache.get<NailFeedMetadata[]>(cacheKey);\n  if (cached) return cached;\n\n  try {\n    const files = getAllNailFeedFilesRecursive(NAILFEED_DIRECTORY);\n\n    const posts = files\n      .map(relativePath => {\n        const relativeSlug = fileToSlug(relativePath);\n        const slug     = path.basename(relativeSlug);\n        const filePath = path.join(NAILFEED_DIRECTORY, relativePath);\n        const content  = fs.readFileSync(filePath, 'utf8');\n        const { data } = matter(content);\n\n        return {\n          slug,\n          title:        data.title      || 'Untitled',\n          excerpt:      data.excerpt    || '',\n          date:         data.date       || new Date().toISOString(),\n          author:       data.author     || 'Mirellé Team',\n          category:     data.category,\n          image:        data.image      || null,\n          imageAlt:     data.imageAlt,\n          imageWidth:   data.imageWidth  || 1200,\n          imageHeight:  data.imageHeight || 675,\n          readTime:     data.readTime   || '4 min',\n          topic:        data.topic,\n          canonical:    data.canonical || `https://mirelleinspo.com/nail-feed/${slug}`,\n          topicalMap:   data.topicalMap,\n          url: `https://mirelleinspo.com/nail-feed/${slug}`,\n        } as NailFeedMetadata;\n      })\n      .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());\n\n    nailFeedCache.set(cacheKey, posts);\n    return posts;\n  } catch (error) {\n    console.error('Error reading nail feed posts:', error);\n    return [];\n  }\n}\n\nexport async function getNailFeedPost(slug: string): Promise<NailFeedPost | null> {\n  const cacheKey = `nailfeed-post:${slug}`;\n\n  const cached = nailFeedCache.get<NailFeedPost>(cacheKey);\n  if (cached) return cached;\n\n  try {\n    const resolved = resolveFilePath(slug);\n    if (!resolved) {\n      console.error(`Nail feed post not found: ${slug}`);\n      return null;\n    }\n\n    const { filePath, isMDX } = resolved;\n    const fileContent = fs.readFileSync(filePath, 'utf8');\n    const { data, content: rawContent } = matter(fileContent);\n\n    let htmlContent: string;\n\n    if (isMDX) {\n      htmlContent = rawContent;\n    } else {\n      let compiled = await marked(rawContent);\n\n      // H2 auto-ID injection - kept from blog.ts. This is a TableOfContents\n      // dependency, not blog-only logic, so it carries over unchanged.\n      compiled = compiled.replace(\n        /<h2>(.*?)<\\/h2>/g,\n        (_match, text) => {\n          const cleanText = text.replace(/<[^>]*>/g, '');\n          const id = cleanText\n            .toLowerCase()\n            .replace(/[^a-z0-9]+/g, '-')\n            .replace(/^-+|-+$/g, '');\n          return `<h2 id=\"${id}\">${text}</h2>`;\n        }\n      );\n\n      htmlContent = compiled;\n    }\n\n    const bareSlug = path.basename(slug.replace(/\\.mdx?$/, ''));\n\n    const post: NailFeedPost = {\n      slug:         bareSlug,\n      title:        data.title      || 'Untitled',\n      excerpt:      data.excerpt    || '',\n      content:      htmlContent,\n      isMDX,\n      date:         data.date       || new Date().toISOString(),\n      author:       data.author     || 'Mirellé Team',\n      category:     data.category,\n      image:        data.image      || null,\n      imageAlt:     data.imageAlt,\n      imageWidth:   data.imageWidth  || 1200,\n      imageHeight:  data.imageHeight || 675,\n      readTime:     data.readTime   || '4 min',\n      topic:        data.topic,\n      canonical:    data.canonical || `https://mirelleinspo.com/nail-feed/${bareSlug}`,\n      topicalMap:   data.topicalMap,\n      coverImage:   data.image      || '/images/default-nailfeed.jpg',\n      tldr:         data.tldr,\n      faqItems:     data.faqItems,\n      reaction:     data.reaction,\n      poll:         data.poll,\n      quiz:         data.quiz,\n    };\n\n    nailFeedCache.set(cacheKey, post);\n    return post;\n  } catch (error) {\n    console.error(`Error reading nail feed post ${slug}:`, error);\n    return null;\n  }\n}\n\nexport async function getAllNailFeedSlugs(): Promise<string[]> {\n  try {\n    return getAllNailFeedFilesRecursive(NAILFEED_DIRECTORY).map(f => path.basename(fileToSlug(f)));\n  } catch (error) {\n    console.error('Error reading nail feed slugs:', error);\n    return [];\n  }\n}\n\nexport async function getNailFeedPostsByCategory(categorySlug: string): Promise<NailFeedMetadata[]> {\n  const allPosts = await getAllNailFeedPosts();\n  return allPosts.filter(post => post.category === categorySlug);\n}\n\nexport async function getNailFeedPostsByTopic(topic: string): Promise<NailFeedMetadata[]> {\n  const allPosts = await getAllNailFeedPosts();\n  return allPosts.filter(post => post.topic === topic);\n}\n\n/**\n * Related posts for the ReadMore rail. Priority order:\n *   1. relatedClusters listed explicitly in topicalMap (sibling posts the\n *      author intentionally linked)\n *   2. Same topic, not already included\n *   3. Fallback - most recent posts, not already included\n * Capped at `limit` (default 6 - Nail Feed's ReadMore rail is lighter than\n * /blog's since posts are short-form), no duplicates.\n */\nexport async function getRelatedNailFeedPosts(\n  currentSlug: string,\n  limit: number = 6\n): Promise<NailFeedMetadata[]> {\n  const currentPost = await getNailFeedPost(currentSlug);\n  if (!currentPost) return [];\n\n  const allPosts = await getAllNailFeedPosts();\n  const seen = new Set<string>([currentSlug]);\n  const result: NailFeedMetadata[] = [];\n\n  // ── 1. Explicit related clusters ────────────────────────────────────\n  const relatedSlugs = currentPost.topicalMap?.relatedClusters || [];\n  if (relatedSlugs.length > 0) {\n    const explicit = allPosts.filter(post => !seen.has(post.slug) && relatedSlugs.includes(post.slug));\n    for (const post of explicit) {\n      if (result.length >= limit) break;\n      result.push(post);\n      seen.add(post.slug);\n    }\n  }\n\n  // ── 2. Same topic ─────────────────────────────────────────────────────\n  if (result.length < limit && currentPost.topic) {\n    const sameTopic = allPosts.filter(\n      post => !seen.has(post.slug) && post.topic === currentPost.topic\n    );\n    for (const post of sameTopic) {\n      if (result.length >= limit) break;\n      result.push(post);\n      seen.add(post.slug);\n    }\n  }\n\n  // ── 3. Fallback: most recent posts ──────────────────────────────────\n  if (result.length < limit) {\n    const remaining = allPosts.filter(post => !seen.has(post.slug));\n    for (const post of remaining) {\n      if (result.length >= limit) break;\n      result.push(post);\n      seen.add(post.slug);\n    }\n  }\n\n  return result;\n}\n\nexport async function getPaginatedNailFeedPosts(\n  page: number = 1,\n  perPage: number = 12\n): Promise<{\n  posts: NailFeedMetadata[];\n  totalPages: number;\n  currentPage: number;\n  totalPosts: number;\n}> {\n  const allPosts   = await getAllNailFeedPosts();\n  const totalPosts = allPosts.length;\n  const totalPages = Math.ceil(totalPosts / perPage);\n  const startIndex = (page - 1) * perPage;\n  const posts      = allPosts.slice(startIndex, startIndex + perPage);\n\n  return { posts, totalPages, currentPage: page, totalPosts };\n}\n\nexport function clearNailFeedCache() {\n  nailFeedCache.clear();\n}"

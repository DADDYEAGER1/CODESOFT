      "content": "// src/lib/stories.ts\nimport fs from 'fs';\nimport path from 'path';\nimport matter from 'gray-matter';\nimport { Story, StoryMetadata, StoryCategory } from '@/types/stories';\n\nconst storiesDirectory = path.join(process.cwd(), 'src/content/stories');\n\nexport async function getAllStorySlugs(): Promise<string[]> {\n  if (!fs.existsSync(storiesDirectory)) return [];\n  return fs\n    .readdirSync(storiesDirectory)\n    .filter((f) => f.endsWith('.md'))\n    .map((f) => f.replace(/\\.md$/, ''));\n}\n\nexport async function getStory(slug: string): Promise<Story | null> {\n  try {\n    const fullPath = path.join(storiesDirectory, `${slug}.md`);\n    if (!fs.existsSync(fullPath)) return null;\n\n    const fileContents = fs.readFileSync(fullPath, 'utf8');\n    const { data, content } = matter(fileContents);\n\n    return {\n      slug: data.slug || slug,\n      title: data.title || '',\n      excerpt: data.excerpt || '',\n      date: data.date || new Date().toISOString(),\n      dateModified: data.dateModified,\n      author: data.author || 'Mirellé',\n      category: data.category || 'UNCATEGORIZED',\n      image: data.image || '/images/default-story.jpg',\n      imageAlt: data.imageAlt,\n      imageCreditSocialLink: data.imageCreditSocialLink,\n      imageCreditDisplayText: data.imageCreditDisplayText,\n      creditBodyImages: data.creditBodyImages ?? true,\n      bodyImages: data.bodyImages || [],\n      readTime: data.readTime,\n      wordCount: data.wordCount,\n      canonical: data.canonical || `https://mirelleinspo.com/stories/${slug}`,\n      tags: data.tags,\n      featured: data.featured,\n      topicalMap: data.topicalMap,\n      navigationContext: data.navigationContext,\n      content, // raw markdown - no remark processing\n    };\n  } catch (error) {\n    console.error(`Error loading story ${slug}:`, error);\n    return null;\n  }\n}\n\nexport async function getAllStories(): Promise<StoryMetadata[]> {\n  const slugs = await getAllStorySlugs();\n  const stories = await Promise.all(\n    slugs.map(async (slug) => {\n      const story = await getStory(slug);\n      if (!story) return null;\n      const { content, ...metadata } = story;\n      return metadata;\n    })\n  );\n  return stories\n    .filter((s): s is StoryMetadata => s !== null)\n    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());\n}\n\nexport async function getStoriesByCategory(categorySlug: string): Promise<StoryMetadata[]> {\n  const allStories = await getAllStories();\n  const normalize = (s: string) => s.toLowerCase().replace(/\\s+/g, '-');\n  return allStories.filter((s) => normalize(s.category) === categorySlug.toLowerCase());\n}\n\nexport async function getAllStoryCategories(): Promise<StoryCategory[]> {\n  const allStories = await getAllStories();\n  const map = new Map<string, number>();\n  allStories.forEach((s) => map.set(s.category, (map.get(s.category) || 0) + 1));\n  return Array.from(map.entries())\n    .map(([name, count]) => ({ name, slug: name.toLowerCase().replace(/\\s+/g, '-'), count }))\n    .sort((a, b) => a.name.localeCompare(b.name));\n}\n\nexport async function getRelatedStories(currentSlug: string, limit = 9): Promise<StoryMetadata[]> {\n  const current = await getStory(currentSlug);\n  if (!current) return [];\n  const all = await getAllStories();\n  const others = all.filter((s) => s.slug !== currentSlug);\n  const sameCategory = others.filter((s) => s.category === current.category);\n  const rest = others.filter((s) => s.category !== current.category);\n  return [...sameCategory, ...rest].slice(0, limit);\n}\n\nexport async function getPaginatedStories(page = 1, perPage = 12) {\n  const all = await getAllStories();\n  const total = all.length;\n  const totalPages = Math.ceil(total / perPage);\n  const start = (page - 1) * perPage;\n  return {\n    stories: all.slice(start, start + perPage),\n    currentPage: page,\n    totalPages,\n    totalStories: total,\n    hasNextPage: page < totalPages,\n    hasPreviousPage: page > 1,\n  };\n}"

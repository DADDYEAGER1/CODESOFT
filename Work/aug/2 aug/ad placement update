// src/components/Header.tsx
// Server component — fetches the latest 5 posts per dynamic dropdown at
// build time, zero runtime cost. Mirrors the Footer.tsx / FooterClient.tsx
// server/client split so nav data stays auto-generated the same way.

import { getAllBlogPosts } from '@/lib/blog';
import { getAllShopPosts } from '@/lib/shop';
import { getAllTopics } from '@/lib/topic';
import { getAllFaqs } from '@/lib/faqs';
import HeaderClient, { NavLink } from './HeaderClient';

const MIRELLE_DOMAIN = 'https://mirelleinspo.com';

// Strips the absolute domain some lib functions bake into `url`/`canonical`,
// since internal <Link> hrefs need to be relative paths, not full URLs.
function toRelativePath(url: string): string {
  return url.replace(MIRELLE_DOMAIN, '');
}

// Wraps a single getAllX() call so one failing category can't take down
// the rest of the header via Promise.all's all-or-nothing rejection.
// Same defensive pattern as Footer.tsx's safeFetch().
async function safeFetch<T>(label: string, fn: () => Promise<T[]>): Promise<T[]> {
  try {
    return await fn();
  } catch (error) {
    console.error(`[Header] Failed to load "${label}" — showing empty dropdown instead.`, error);
    return [];
  }
}

async function getHeaderData() {
  const [allBlogs, allShop, allTopics, allFaqs] = await Promise.all([
    safeFetch('blog', getAllBlogPosts),
    safeFetch('shop', getAllShopPosts),
    safeFetch('topics', getAllTopics),
    safeFetch('faqs', getAllFaqs),
  ]);

  // Every getAllX() already sorts newest-first — just take the top 5 and
  // shape each into { label, href }. No date-window filtering here (unlike
  // the footer's "last 15 days"): the header always wants exactly 5 links,
  // regardless of how recently they were published.

  const edits: NavLink[] = allBlogs.slice(0, 5).map((p) => ({
    label: p.title,
    href: toRelativePath(p.url),
  }));

  const shop: NavLink[] = allShop.slice(0, 5).map((p) => ({
    label: p.title,
    href: `/shop/${p.productType}/${p.slug}`,
  }));

  const longReads: NavLink[] = allTopics.slice(0, 5).map((t) => ({
    label: t.title,
    href: toRelativePath(t.url),
  }));

  const nailFaqs: NavLink[] = allFaqs.slice(0, 5).map((f) => ({
    label: f.title,
    href: `/nail-faqs/${f.slug}`,
  }));

  return { edits, shop, longReads, nailFaqs };
}

export default async function Header() {
  const { edits, shop, longReads, nailFaqs } = await getHeaderData();

  return (
    <HeaderClient
      editsLinks={edits}
      shopLinks={shop}
      longReadsLinks={longReads}
      nailFaqsLinks={nailFaqs}
    />
  );
}

      "content": "// src/app/stories/[slug]/page.tsx\nimport { Metadata } from 'next';\nimport { notFound } from 'next/navigation';\nimport { getStory, getAllStorySlugs } from '@/lib/stories';\nimport { getAuthor } from '@/lib/authors';\nimport Breadcrumbs from '@/components/Breadcrumbs';\nimport StoryFeatured from '@/components/Stories/StoryFeatured';\nimport AuthorCard from '@/components/Blog/AuthorCard';\nimport StoryAbout from '@/components/Stories/StoryAbout';\nimport StoryFinalNewsletter from '@/components/Stories/StoryFinalNewsletter';\nimport StoryReadMore from '@/components/Stories/StoryReadMore';\nimport SocialFollowCTA from '@/components/ui/SocialFollowCTA';\nimport { remark } from 'remark';\nimport remarkGfm from 'remark-gfm';\nimport remarkHtml from 'remark-html';\nimport { StoryBodyImage } from '@/types/stories';\n\nexport const dynamic = 'force-static';\nexport const revalidate = false;\n\n// Splits compiled HTML into segments at <h2> boundaries so bodyImages can be\n// placed after a specific heading index, mirroring NailFeedTemplate's\n// splitContentIntoThirds pattern but keyed off explicit afterHeading values\n// instead of fixed thirds.\nfunction splitContentAtHeadings(html: string): string[] {\n  const blocks = html.split(/(?=<h2[\\s>])/);\n  return blocks;\n}\n\nfunction BodyImageBlock({ image, creditEnabled }: { image: StoryBodyImage; creditEnabled: boolean }) {\n  const showCredit = creditEnabled && image.creditDisplayText;\n  return (\n    <div className=\"w-full max-w-[560px] mx-auto my-8\">\n      <div className=\"relative w-full aspect-[4/5] sm:aspect-[3/4] overflow-hidden bg-foreground/5\">\n        <img src={image.src} alt={image.alt} className=\"w-full h-full object-cover\" />\n      </div>\n      {showCredit && (\n        <p className=\"font-ui text-xs text-foreground/50 mt-2 text-right\">\n          {image.creditSocialLink ? (\n            <a\n              href={image.creditSocialLink}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"hover:text-foreground underline\"\n            >\n              {image.creditDisplayText}\n            </a>\n          ) : (\n            image.creditDisplayText\n          )}\n        </p>\n      )}\n    </div>\n  );\n}\n\ninterface PageProps {\n  params: Promise<{ slug: string }>;\n}\n\nexport async function generateStaticParams() {\n  const slugs = await getAllStorySlugs();\n  return slugs.map((slug) => ({ slug }));\n}\n\nexport async function generateMetadata({ params }: PageProps): Promise<Metadata> {\n  const { slug } = await params;\n  const story = await getStory(slug);\n  if (!story) return {};\n\n  return {\n    title: story.title,\n    description: story.excerpt,\n    alternates: { canonical: story.canonical || `https://mirelleinspo.com/stories/${slug}` },\n    openGraph: {\n      title: story.title,\n      description: story.excerpt,\n      url: `https://mirelleinspo.com/stories/${slug}`,\n      siteName: 'Mirellé Inspo',\n      type: 'article',\n      publishedTime: story.date,\n      modifiedTime: story.dateModified || story.date,\n      authors: [story.author],\n      images: [{ url: story.image, width: 1200, height: 675, alt: story.title }],\n    },\n    twitter: {\n      card: 'summary_large_image',\n      title: story.title,\n      description: story.excerpt,\n      images: [story.image],\n    },\n    robots: {\n      index: true,\n      follow: true,\n      googleBot: { index: true, follow: true, 'max-video-preview': -1, 'max-image-preview': 'large', 'max-snippet': -1 },\n    },\n  };\n}\n\nexport default async function StoryPage({ params }: PageProps) {\n  const { slug } = await params;\n  const story = await getStory(slug);\n  if (!story) notFound();\n\n  const author = getAuthor(story.author);\n\n  const formattedDate = new Date(story.date).toLocaleDateString('en-US', {\n    year: 'numeric',\n    month: 'long',\n    day: 'numeric',\n  });\n\n  const processed = await remark().use(remarkGfm).use(remarkHtml).process(story.content);\n  const contentHtml = processed.toString();\n  const headingBlocks = splitContentAtHeadings(contentHtml);\n\n  const bodyImages = story.bodyImages || [];\n  const creditEnabled = story.creditBodyImages ?? true;\n\n  return (\n    <article className=\"min-h-screen bg-background\">\n      <div className=\"max-w-[1200px] mx-auto\">\n        <div className=\"max-w-[800px] px-6 pt-8\">\n          <Breadcrumbs\n            items={[{ label: 'Stories', href: '/stories' }]}\n            currentPage={story.title}\n          />\n\n          {story.category && (\n            <p className=\"font-ui uppercase text-xs text-foreground/50 tracking-wider mt-6\">\n              {story.category}\n            </p>\n          )}\n\n          <h1 className=\"font-heading text-4xl md:text-5xl leading-tight mt-3 mb-4\">\n            {story.title}\n          </h1>\n\n          <div className=\"flex items-center gap-2 font-ui text-sm text-foreground/60 mb-8\">\n            <span>BY {story.author.toUpperCase()}</span>\n            <span>·</span>\n            <time dateTime={story.date}>{formattedDate}</time>\n          </div>\n        </div>\n\n        {/* Hero — 16:9, 1200x675 minimum per Discover hero image spec.\n            Left edge aligns with the title's left edge; hero can extend\n            wider than the text column within the shared 1200px frame. */}\n        <div className=\"px-6 mb-8\">\n          <div className=\"w-full max-w-[1000px] aspect-[16/9] overflow-hidden bg-foreground/5\">\n            <img\n              src={story.image}\n              alt={story.imageAlt || story.title}\n              className=\"w-full h-full object-cover\"\n            />\n          </div>\n        </div>\n\n        <div className=\"max-w-[800px] px-6\">\n          <article className=\"prose prose-lg max-w-none font-body prose-headings:font-heading prose-a:text-foreground prose-a:underline\">\n            {headingBlocks.map((block, i) => {\n              const isHalfway = headingBlocks.length > 1 && i === Math.floor(headingBlocks.length / 2);\n              return (\n                <div key={`block-${i}`}>\n                  <div dangerouslySetInnerHTML={{ __html: block }} />\n                  {bodyImages\n                    .filter((img) => img.afterHeading === i)\n                    .map((img, j) => (\n                      <BodyImageBlock key={`bi-${i}-${j}`} image={img} creditEnabled={creditEnabled} />\n                    ))}\n                  {isHalfway && (\n                    <div className=\"not-prose my-10\">\n                      <SocialFollowCTA platforms={['instagram', 'pinterest', 'twitter', 'facebook', 'youtube']} />\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </article>\n        </div>\n\n        {story.featured && (\n          <div className=\"mt-16\">\n            <StoryFeatured person={story.featured} />\n          </div>\n        )}\n\n        {author && (\n          <div className=\"max-w-[800px] px-6 mt-16\">\n            <AuthorCard author={author} />\n          </div>\n        )}\n      </div>\n\n      <div className=\"mt-16\">\n        <StoryAbout />\n      </div>\n\n      <StoryFinalNewsletter />\n\n      <StoryReadMore currentSlug={slug} />\n    </article>\n  );\n}"

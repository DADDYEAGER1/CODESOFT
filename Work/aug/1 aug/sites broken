/* ============================================
   CSS VARIABLES
   ============================================ */

:root {
  /* Fonts */
  --font-heading: 'Erode', 'Georgia', serif;
  --font-body: 'Crimson Text', 'Georgia', serif;
  --font-ui: 'General Sans', system-ui, sans-serif;
  --font-brand: 'Erode', 'Georgia', serif;
  
  /* BRAND COLORS -- only 2 in use sitewide */
  --background: #f9fafb;
  --foreground: #252220;
}

/* ============================================
   GLOBAL RESETS & BASE STYLES
   ============================================ */

* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html,
body {
  max-width: 100vw;
  overflow-x: hidden;
  font-family: var(--font-body);
  font-weight: normal;
  /* Prevents AdSense and mobile browsers from auto-adjusting
     text size, which causes the "zoomed in" layout distortion */
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  color: var(--foreground);
  background: var(--background);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ============================================
   REMOVE ALL LINK UNDERLINES
   ============================================ */

a {
  color: inherit;
  text-decoration: none;
  font-weight: normal;
}

/* ============================================
   REMOVE BOLD FROM ALL HEADINGS & ELEMENTS
   ============================================ */

/* h1, h2, h3, h4, h5, h6,
strong, b,
.font-bold {
  font-weight: normal !important;
} */

/* Exception: Logo in header can be bold */
.logo-text,
[data-logo="true"] {
  font-weight: bold !important;
}

/* ============================================
   UTILITY CLASSES
   ============================================ */

.font-heading {
  font-family: var(--font-heading);
}

.font-body {
  font-family: var(--font-body);
}

.font-ui {
  font-family: var(--font-ui);
}

.font-brand {
  font-family: var(--font-brand);
}

/* ============================================
   ANIMATIONS
   ============================================ */

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-20px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.animate-fadeIn {
  animation: fadeIn 0.6s ease-out;
}

.animate-slideIn {
  animation: slideIn 0.6s ease-out;
}

.animate-pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

/* ============================================
   SCROLLBAR STYLING
   ============================================ */

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: var(--background);
}

::-webkit-scrollbar-thumb {
  background: #888;
  border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
  background: #555;
}

/* ============================================
   SELECTION STYLING
   ============================================ */

::selection {
  background-color: var(--foreground);
  color: var(--background);
}

::-moz-selection {
  background-color: var(--foreground);
  color: var(--background);
}



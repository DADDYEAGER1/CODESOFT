      "content": "// src/app/layout.tsx\n\nimport type { Metadata, Viewport } from 'next';\nimport './globals.css';\nimport Header from '@/components/Header';\nimport Footer from '@/components/Footer';\nimport Script from 'next/script';\nimport {\n  generateOrganizationSchema,\n  generateWebsiteSchema,\n  generateJyotiSchema,\n  generateRiSchema,\n} from '@/lib/generateSchemas';\n\nimport ExitIntentPopup from '@/components/ExitIntentPopup';\nimport StickySlideIn from '@/components/StickySlideIn';\n\n// ── Viewport (separate export  required in Next.js 14+) ──────────────────────\n\nexport const viewport: Viewport = {\n  themeColor: '#252220',\n  width: 'device-width',\n  initialScale: 1,\n  minimumScale: 1,\n  maximumScale: 5,\n};\n \nexport const metadata: Metadata = {\n  metadataBase: new URL('https://mirelleinspo.com'),\n  title: {\n    default: \"Nail Designs, Trends & Tutorials  Mirellé Inspo\",\n    template: '%s | Mirellé Inspo',\n  },\n  description:\n    'Browse 5,000+ nail designs across every shape, finish, and season. Research-backed trend reports, editorial guides, and weekly inspiration for people who take their nails seriously.',\n  keywords: [\n    'nail designs 2026',\n    'nail art inspiration',\n    'nail trends 2026',\n    'chrome nails',\n    'cat claw nails',\n    'milky nail trends',\n    'gel nail ideas',\n    'seasonal nail designs',\n    'nail art tutorials',\n    'trending nail ideas',\n  ],\n  authors: [\n    { name: 'Jyotika Verma', url: 'https://mirelleinspo.com/authors/jyoti-mirelle' },\n    { name: 'Gaurav Verma', url: 'https://mirelleinspo.com/authors/ri-mirelle' },\n  ],\n  creator: 'Mirellé Inspo',\n  publisher: 'Mirellé Inspo',\n  formatDetection: { telephone: false, email: false, address: false },\n  other: {\n    'distribution': 'global',\n    'rating': 'general',\n    'language': 'en-US',\n    'classification': 'Beauty, Nail Art, Fashion, Lifestyle, DIY Tutorials',\n    'referrer': 'always',\n    'revisit-after': '7 days',\n    'mobile-web-app-capable': 'yes',\n    'apple-mobile-web-app-capable': 'yes',\n    'apple-mobile-web-app-status-bar-style': 'black-translucent',\n    'apple-mobile-web-app-title': 'Mirellé',\n    'application-name': 'Mirellé',\n  },\n  openGraph: {\n    type: 'website',\n    locale: 'en_US',\n    url: 'https://mirelleinspo.com',\n    siteName: 'Mirellé Inspo',\n    title: \"Nail Designs, Trends & Tutorials  Mirellé Inspo\",\n    description:\n      'Browse 5,000+ nail designs across every shape, finish, and season. Research-backed trends and editorial guides updated weekly.',\n    images: [{ url: '/og-image.jpg', width: 1200, height: 630, alt: 'Mirellé Inspo  Nail Designs, Trends & Tutorials' }],\n  },\n  twitter: {\n    card: 'summary_large_image',\n    title: \"Nail Designs, Trends & Tutorials  Mirellé Inspo\",\n    description: 'Browse 5,000+ nail designs. Research-backed trends and editorial guides updated weekly.',\n    images: ['/og-image.jpg'],\n    creator: '@mirelleinspo',\n    site: '@mirelleinspo',\n  },\n  robots: {\n    index: true,\n    follow: true,\n    nocache: false,\n    googleBot: { index: true, follow: true, 'max-video-preview': -1, 'max-image-preview': 'large', 'max-snippet': -1 },\n  },\n  icons: {\n    icon: [\n      { url: '/favicon.ico', sizes: '48x48' },\n      { url: '/favicon.svg', type: 'image/svg+xml' },\n      { url: '/favicon-16x16.png', sizes: '16x16', type: 'image/png' },\n      { url: '/favicon-32x32.png', sizes: '32x32', type: 'image/png' },\n    ],\n    apple: [{ url: '/apple-touch-icon.png', sizes: '180x180', type: 'image/png' }],\n  },\n  manifest: '/site.webmanifest',\n  alternates: {\n    languages: {\n      'en-US': 'https://mirelleinspo.com',\n      'en-GB': 'https://mirelleinspo.com',\n      'en-CA': 'https://mirelleinspo.com',\n      'en-AU': 'https://mirelleinspo.com',\n      'en': 'https://mirelleinspo.com',\n    },\n  },\n};\n\n// ── Root Layout ───────────────────────────────────────────────────────────────\n\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n  // Build schema graph  all entities in one JSON-LD block\n  const schemaGraph = {\n    '@context': 'https://schema.org',\n    '@graph': [\n      generateOrganizationSchema(),\n      generateWebsiteSchema(),\n      generateJyotiSchema(),\n      generateRiSchema(),\n    ],\n  };\n\n  return (\n    <html lang=\"en-US\">\n      <head>\n        {/* Performance: preconnect for critical third-party origins */}\n        <link rel=\"preconnect\" href=\"https://scripts.scriptwrapper.com\" />\n        <link rel=\"preconnect\" href=\"https://res.cloudinary.com\" crossOrigin=\"anonymous\" />\n        <link rel=\"dns-prefetch\" href=\"https://www.googletagmanager.com\" />\n        <link rel=\"dns-prefetch\" href=\"https://res.cloudinary.com\" />\n\n      </head>\n\n      <body className=\"antialiased\" suppressHydrationWarning>\n        {/* Google Tag Manager (noscript fallback) */}\n        <noscript>\n          <iframe\n            src=\"https://www.googletagmanager.com/ns.html?id=GTM-WPW9XBW8\"\n            height=\"0\"\n            width=\"0\"\n            style={{ display: 'none', visibility: 'hidden' }}\n            title=\"Google Tag Manager\"\n          />\n        </noscript>\n\n        {/* Google Tag Manager */}\n        <Script id=\"gtm-init\" strategy=\"afterInteractive\">\n          {`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\n          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\n          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n          })(window,document,'script','dataLayer','GTM-WPW9XBW8');`}\n        </Script>\n\n        {/* GA4 */}\n        <Script\n          src=\"https://www.googletagmanager.com/gtag/js?id=G-4BZ9QKQZ73\"\n          strategy=\"afterInteractive\"\n        />\n        <Script id=\"ga4-init\" strategy=\"afterInteractive\">\n          {`window.dataLayer = window.dataLayer || [];\n          function gtag(){dataLayer.push(arguments);}\n          gtag('js', new Date());\n          gtag('config', 'G-4BZ9QKQZ73', { page_path: window.location.pathname, send_page_view: true });`}\n        </Script>\n\n        {/* Core Web Vitals tracking */}\n        <Script id=\"web-vitals\" strategy=\"afterInteractive\">\n          {`(function(){\n            function send(m){if(window.gtag)window.gtag('event',m.name,{value:Math.round(m.name==='CLS'?m.value*1000:m.value),event_category:'Web Vitals',event_label:m.id,non_interaction:true});}\n            if('PerformanceObserver' in window){\n              try{const o=new PerformanceObserver(l=>{const e=l.getEntries(),last=e[e.length-1];send({name:'LCP',value:last.renderTime||last.loadTime,id:'v1-'+Date.now()});});o.observe({entryTypes:['largest-contentful-paint']});}catch(e){}\n              try{const o=new PerformanceObserver(l=>{l.getEntries().forEach(e=>{send({name:'INP',value:e.duration,id:'v1-'+Date.now()});});});o.observe({type:'event',buffered:true,durationThreshold:40});}catch(e){}\n              try{let v=0;const o=new PerformanceObserver(l=>{l.getEntries().forEach(e=>{if(!e.hadRecentInput)v+=e.value;});});o.observe({entryTypes:['layout-shift']});addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden')send({name:'CLS',value:v,id:'v1-'+Date.now()});});}catch(e){}\n            }\n          })();`}\n        </Script>\n\n        {/* Structured Data  full entity graph */}\n        <script\n          type=\"application/ld+json\"\n          dangerouslySetInnerHTML={{ __html: JSON.stringify(schemaGraph) }}\n        />\n\n        <Header />\n\n        <div className=\"w-full max-w-[1600px] mx-auto\">\n          <main className=\"min-h-screen\" id=\"main-content\" role=\"main\">\n            {children}\n          </main>\n        </div>\n\n        <Footer />\n        <ExitIntentPopup />\n        <StickySlideIn />\n\n        {/* Google AdSense -enabled mediavine faliure*/}\n        <Script\n          id=\"google-adsense\"\n          async\n          src=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1145734682794444\"\n          crossOrigin=\"anonymous\"\n          strategy=\"afterInteractive\"\n        />\n      \n\n        {/* Mediavine Journey ads script*/}\n        {/* <Script\n          id=\"mediavine-journey\"\n          src=\"https://scripts.scriptwrapper.com/tags/d965deec-2fc5-4c1b-86c5-8c7c99848f4a.js\"\n          strategy=\"beforeInteractive\"\n          data-noptimize=\"1\"\n          data-cfasync=\"false\"\n        />\n          */}\n        {/* Grow by Mediavine \n        <Script\n          id=\"grow-mediavine\"\n          strategy=\"afterInteractive\"\n          data-grow-initializer=\"\"\n          dangerouslySetInnerHTML={{\n            __html: `!(function(){window.growMe||((window.growMe=function(e){window.growMe._.push(e);}),(window.growMe._=[]));var e=document.createElement(\"script\");(e.type=\"text/javascript\"),(e.src=\"https://faves.grow.me/main.js\"),(e.defer=!0),e.setAttribute(\"data-grow-faves-site-id\",\"U2l0ZTpkOTY1ZGVlYy0yZmM1LTRjMWItODZjNS04YzdjOTk4NDhmNGE=\");var t=document.getElementsByTagName(\"script\")[0];t.parentNode.insertBefore(e,t);})();`,\n          }}\n        />*/}\n        \n      </body>\n    </html>\n  );\n}"

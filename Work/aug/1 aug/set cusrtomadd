      "path": "src/components/Header.tsx",
      "content": "// src/components/Header.tsx\n// Server component — fetches the latest 5 posts per dynamic dropdown at\n// build time, zero runtime cost. Mirrors the Footer.tsx / FooterClient.tsx\n// server/client split so nav data stays auto-generated the same way.\n\nimport { getAllBlogPosts } from '@/lib/blog';\nimport { getAllShopPosts } from '@/lib/shop';\nimport { getAllTopics } from '@/lib/topic';\nimport { getAllFaqs } from '@/lib/faqs';\nimport HeaderClient, { NavLink } from './HeaderClient';\n\nconst MIRELLE_DOMAIN = 'https://mirelleinspo.com';\n\n// Strips the absolute domain some lib functions bake into `url`/`canonical`,\n// since internal <Link> hrefs need to be relative paths, not full URLs.\nfunction toRelativePath(url: string): string {\n  return url.replace(MIRELLE_DOMAIN, '');\n}\n\n// Wraps a single getAllX() call so one failing category can't take down\n// the rest of the header via Promise.all's all-or-nothing rejection.\n// Same defensive pattern as Footer.tsx's safeFetch().\nasync function safeFetch<T>(label: string, fn: () => Promise<T[]>): Promise<T[]> {\n  try {\n    return await fn();\n  } catch (error) {\n    console.error(`[Header] Failed to load \"${label}\" — showing empty dropdown instead.`, error);\n    return [];\n  }\n}\n\nasync function getHeaderData() {\n  const [allBlogs, allShop, allTopics, allFaqs] = await Promise.all([\n    safeFetch('blog', getAllBlogPosts),\n    safeFetch('shop', getAllShopPosts),\n    safeFetch('topics', getAllTopics),\n    safeFetch('faqs', getAllFaqs),\n  ]);\n\n  // Every getAllX() already sorts newest-first — just take the top 5 and\n  // shape each into { label, href }. No date-window filtering here (unlike\n  // the footer's \"last 15 days\"): the header always wants exactly 5 links,\n  // regardless of how recently they were published.\n\n  const edits: NavLink[] = allBlogs.slice(0, 5).map((p) => ({\n    label: p.title,\n    href: toRelativePath(p.url),\n  }));\n\n  const shop: NavLink[] = allShop.slice(0, 5).map((p) => ({\n    label: p.title,\n    href: `/shop/${p.productType}/${p.slug}`,\n  }));\n\n  const longReads: NavLink[] = allTopics.slice(0, 5).map((t) => ({\n    label: t.title,\n    href: toRelativePath(t.url),\n  }));\n\n  const nailFaqs: NavLink[] = allFaqs.slice(0, 5).map((f) => ({\n    label: f.title,\n    href: `/nail-faqs/${f.slug}`,\n  }));\n\n  return { edits, shop, longReads, nailFaqs };\n}\n\nexport default async function Header() {\n  const { edits, shop, longReads, nailFaqs } = await getHeaderData();\n\n  return (\n    <HeaderClient\n      editsLinks={edits}\n      shopLinks={shop}\n      longReadsLinks={longReads}\n      nailFaqsLinks={nailFaqs}\n    />\n  );\n}"

\n  const cached = blogCache.get<BlogPost>(cacheKey);\n  if (cached) return cached;\n\n  try {\n    const resolved = resolveFilePath(slug);\n    if (!resolved) {\n      console.error(`Blog post not found: ${slug}`);\n      return null;\n    }\n\n    const { filePath, isMDX } = resolved;\n    const fileContent = fs.readFileSync(filePath, 'utf8');\n    const { data, content: rawContent } = matter(fileContent);\n\n    const showInspoGalleryLink = data.showInspoGalleryLink !== false;\n\n    let htmlContent: string;\n\n    if (isMDX) {\n      htmlContent = rawContent;\n    } else {\n      let compiled = await marked(rawContent);\n\n      compiled = compiled.replace(\n        /<h2>(.*?)<\\/h2>/g,\n        (_match, text) => {\n          const cleanText = text.replace(/<[^>]*>/g, '');\n          const id = cleanText\n            .toLowerCase()\n            .replace(/[^a-z0-9]+/g, '-')\n            .replace(/^-+|-+$/g, '');\n          return `<h2 id=\"${id}\">${text}</h2>`;\n        }\n      );\n\n      htmlContent = injectInspoGalleryLinks(compiled, data.topic, showInspoGalleryLink);\n    }\n\n    // Bare slug = filename without extension (consistent with getAllBlogPosts)\n    const bareSlug = path.basename(slug.replace(/\\.mdx?$/, ''));\n\n    const post: BlogPost = {\n      slug:              bareSlug,\n      title:             data.title      || 'Untitled',\n      excerpt:           data.excerpt    || '',\n      content:           htmlContent,\n      isMDX,\n      date:              data.date       || new Date().toISOString(),\n      author:            data.author     || 'Mirellé Team',\n      category:          data.category,\n      image:             data.image      || null,\n      imageAlt:          data.imageAlt,\n      imageWidth:        data.imageWidth  || 1200,\n      imageHeight:       data.imageHeight || 630,\n      readTime:          data.readTime   || '5 min',\n      topic:             data.topic,\n      canonical: data.canonical || (data.topic ? `https://mire
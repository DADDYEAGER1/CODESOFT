      "content": "'use client';\n\nimport { useState } from 'react';\nimport Image from 'next/image';\nimport Link from 'next/link';\n\nconst TYPE_LABELS: Record<string, string> = {\n  blog:        'Blog',\n  faq:         'FAQ',\n  'work-nail': 'Work Nails',\n  spotlight:   'Spotlight',\n  topic:       'Topic',\n  report:      'Trend Report',\n  business:    'Business',\n};\n\ninterface Post {\n  slug: string;\n  title: string;\n  excerpt: string;\n  date: string;\n  image?: string;\n  type: string;\n  url: string;\n}\n\ninterface AuthorPostsListProps {\n  posts: Post[];\n  authorName: string;\n}\n\nconst PAGE_SIZE = 10;\n\nexport default function AuthorPostsList({ posts }: AuthorPostsListProps) {\n  const [page, setPage] = useState(1);\n\n  const totalPages = Math.ceil(posts.length / PAGE_SIZE);\n  const start = (page - 1) * PAGE_SIZE;\n  const shown = posts.slice(start, start + PAGE_SIZE);\n\n  function scrollToTop() {\n    window.scrollTo({ top: 0, behavior: 'smooth' });\n  }\n\n  function goTo(p: number) {\n    setPage(p);\n    scrollToTop();\n  }\n\n  return (\n    <>\n      <div className=\"divide-y divide-foreground/10\">\n        {shown.map((post) => (\n          <Link\n            key={`${post.type}-${post.slug}`}\n            href={post.url}\n            className=\"group flex items-start gap-6 py-8 transition-opacity hover:opacity-70\"\n          >\n            {post.image && (\n              <div className=\"relative w-20 h-20 flex-shrink-0 overflow-hidden\">\n                <Image\n                  src={post.image}\n                  alt={post.title}\n                  fill\n                  className=\"object-cover\"\n                  sizes=\"80px\"\n                />\n              </div>\n            )}\n            <div className=\"flex-1 space-y-1\">\n              <p className=\"font-ui text-xs uppercase tracking-widest text-foreground/40\">\n                {TYPE_LABELS[post.type] || post.type}\n              </p>\n              <h3\n                className=\"text-xl md:text-2xl text-foreground leading-snug\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                {post.title}\n              </h3>\n              {post.excerpt && (\n                <p\n                  className=\"text-base text-foreground/60 line-clamp-2\"\n                  style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n                >\n                  {post.excerpt}\n                </p>\n              )}\n              <p className=\"font-ui text-xs text-foreground/40 pt-1\">\n                {new Date(post.date).toLocaleDateString('en-US', {\n                  year: 'numeric',\n                  month: 'long',\n                  day: 'numeric',\n                })}\n              </p>\n            </div>\n          </Link>\n        ))}\n      </div>\n\n      {/* Pagination */}\n      {totalPages > 1 && (\n        <div className=\"mt-16 flex flex-col items-center gap-6\">\n\n          {/* Page numbers */}\n          <div className=\"flex items-center gap-1\">\n            {/* Prev */}\n            <button\n              onClick={() => goTo(page - 1)}\n              disabled={page === 1}\n              className=\"w-9 h-9 flex items-center justify-center border border-foreground/20 font-ui text-xs text-foreground/60 hover:text-foreground hover:border-foreground transition-colors duration-200 disabled:opacity-20 disabled:cursor-not-allowed\"\n              aria-label=\"Previous page\"\n            >\n              ←\n            </button>\n\n            {/* Page buttons  show max 5 around current */}\n            {Array.from({ length: totalPages }, (_, i) => i + 1)\n              .filter(p => p === 1 || p === totalPages || Math.abs(p - page) <= 2)\n              .reduce<(number | 'ellipsis')[]>((acc, p, idx, arr) => {\n                if (idx > 0 && p - (arr[idx - 1] as number) > 1) acc.push('ellipsis');\n                acc.push(p);\n                return acc;\n              }, [])\n              .map((item, idx) =>\n                item === 'ellipsis' ? (\n                  <span\n                    key={`ellipsis-${idx}`}\n                    className=\"w-9 h-9 flex items-center justify-center font-ui text-xs text-foreground/30\"\n                  >\n                    ...\n                  </span>\n                ) : (\n                  <button\n                    key={item}\n                    onClick={() => goTo(item as number)}\n                    className={`w-9 h-9 flex items-center justify-center border font-ui text-xs transition-colors duration-200 ${\n                      page === item\n                        ? 'border-foreground bg-foreground text-background'\n                        : 'border-foreground/20 text-foreground/60 hover:text-foreground hover:border-foreground'\n                    }`}\n                    aria-label={`Page ${item}`}\n                    aria-current={page === item ? 'page' : undefined}\n                  >\n                    {item}\n                  </button>\n                )\n              )}\n\n            {/* Next */}\n            <button\n              onClick={() => goTo(page + 1)}\n              disabled={page === totalPages}\n              className=\"w-9 h-9 flex items-center justify-center border border-foreground/20 font-ui text-xs text-foreground/60 hover:text-foreground hover:border-foreground transition-colors duration-200 disabled:opacity-20 disabled:cursor-not-allowed\"\n              aria-label=\"Next page\"\n            >\n              →\n            </button>\n          </div>\n\n          {/* Count */}\n          <p className=\"font-ui text-xs text-foreground/40\">\n            {start + 1} to {Math.min(start + PAGE_SIZE, posts.length)} of {posts.length} articles\n          </p>\n\n        </div>\n      )}\n    </>\n  );\n}"

      "content": "// src/app/authors/page.tsx\n\nimport { Metadata } from 'next';\nimport Image from 'next/image';\nimport Link from 'next/link';\nimport { getAllAuthorsWithStats } from '@/lib/authors';\n\n\nexport const metadata: Metadata = {\n  title: 'Meet Jyotika & Gaurav  The People Behind Mirellé Inspo',\n  description:\n    'Jyotika Verma writes the editorial. Gaurav Verma runs the research and strategy. Together they built Mirellé Inspo  a nail publication driven by data, not guesswork.',\n  authors: [\n    { name: 'Jyotika Verma', url: 'https://mirelleinspo.com/authors/jyoti-mirelle' },\n    { name: 'Gaurav Verma', url: 'https://mirelleinspo.com/authors/ri-mirelle' },\n  ],\n  alternates: { canonical: 'https://mirelleinspo.com/authors' },\n  openGraph: {\n    title: 'Meet Jyotika & Gaurav  The People Behind Mirellé Inspo',\n    description: 'Jyotika Verma writes the editorial. Gaurav Verma runs research and strategy. Two people, one research-driven nail publication.',\n    url: 'https://mirelleinspo.com/authors',\n    siteName: 'Mirellé Inspo',\n    type: 'website',\n    locale: 'en_US',\n    images: [{ url: '/logo.png', width: 250, height: 60, alt: 'Mirellé Inspo  Meet the Team' }],\n  },\n  twitter: {\n    card: 'summary_large_image',\n    title: 'Meet Jyotika & Gaurav  The People Behind Mirellé Inspo',\n    description: 'Two people, one research-driven nail publication.',\n    creator: '@mirelleinspo',\n    site: '@mirelleinspo',\n    images: ['/logo.png'],\n  },\n  robots: {\n    index: true,\n    follow: true,\n    googleBot: { index: true, follow: true, 'max-video-preview': -1, 'max-image-preview': 'large', 'max-snippet': -1 },\n  },\n};\n\nexport default async function AuthorsPage() {\n  const authors = await getAllAuthorsWithStats();\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n\n      {/* Hero */}\n      <section className=\"py-24 border-b border-foreground/10\">\n        <div className=\"max-w-2xl mx-auto px-6 text-center\">\n          <p className=\"font-ui text-xs uppercase tracking-widest text-foreground/50 mb-4\">\n            The Team\n          </p>\n          <h1\n            className=\"text-5xl md:text-6xl mb-6 text-foreground\"\n            style={{ fontFamily: 'Larken, Georgia, serif' }}\n          >\n            Behind Mirellé\n          </h1>\n          <p\n            className=\"text-xl text-foreground/70 leading-relaxed\"\n            style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n          >\n            We are the co-founders of Mirellé Inspo. We built this publication because\n            a truly nail-focused editorial  one that covers everything, for everyone in\n            the nail industry  did not exist. Enthusiasts, nail techs, salons, brands,\n            home doers. We are building for all of them, driven by real demand data, not guesswork.\n          </p>\n        </div>\n      </section>\n\n      {/* Authors */}\n      <section className=\"py-20\">\n        <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-16\">\n            {authors.map((author) => (\n              <Link\n                key={author.slug}\n                href={`/authors/${author.slug}`}\n                className=\"group block\"\n              >\n                {/* Headshot */}\n                <div className=\"relative w-full pb-[100%] overflow-hidden mb-6\">\n                  <Image\n                    src={author.image}\n                    alt={author.displayName}\n                    fill\n                    className=\"object-cover transition-transform duration-700 group-hover:scale-105\"\n                    sizes=\"(max-width: 768px) 100vw, 50vw\"\n                  />\n                </div>\n\n                {/* Info */}\n                <div className=\"space-y-3\">\n                  <p className=\"text-xs uppercase tracking-widest text-foreground/50 font-ui\">\n                    {author.role}\n                  </p>\n                  <h2\n                    className=\"text-3xl md:text-4xl text-foreground\"\n                    style={{ fontFamily: 'Larken, Georgia, serif' }}\n                  >\n                    {author.displayName}\n                  </h2>\n                  <p\n                    className=\"text-lg text-foreground/70 leading-relaxed\"\n                    style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n                  >\n                    {author.bio}\n                  </p>\n                  <div className=\"flex items-center gap-4 pt-2\">\n                    <span className=\"text-xs uppercase tracking-wide font-ui text-foreground/50\">\n                      {author.postCount} {author.postCount === 1 ? 'article' : 'articles'}\n                    </span>\n                    <span className=\"text-xs uppercase tracking-wide font-ui underline hover:no-underline text-foreground transition-opacity hover:opacity-70\">\n                      View all work →\n                    </span>\n                  </div>\n                </div>\n              </Link>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* Editorial line */}\n      <section className=\"py-20 border-t border-foreground/10\">\n        <div className=\"max-w-2xl mx-auto px-6 text-center\">\n          <p\n            className=\"text-xl md:text-2xl text-foreground/70 leading-relaxed italic\"\n            style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n          >\n            &ldquo;Curating so you don&apos;t have to.&rdquo;\n          </p>\n          <div className=\"mt-10\">\n            <Link\n              href=\"/about\"\n              className=\"inline-block bg-foreground text-background px-8 py-4 font-ui text-sm uppercase tracking-wider transition-opacity hover:opacity-70\"\n            >\n              About Mirellé\n            </Link>\n          </div>\n        </div>\n      </section>\n\n    </div>\n  );\n}"

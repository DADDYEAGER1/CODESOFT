      "path": "src/lib/blog.ts",
      "content": "import 'server-only';\nimport fs from 'fs';\nimport path from 'path';\nimport matter from 'gray-matter';\nimport { BlogPost, BlogMetadata } from '@/types/blog';\nimport { marked } from 'marked';\n\n// Configure marked to handle HTML properly\nmarked.setOptions({\n  breaks: true,\n  gfm: true,\n});\n\n// Custom renderer to preserve HTML and fix image paths\nconst renderer = new marked.Renderer();\n\nrenderer.html = (html: string) => {\n  return html.replace(/src=\"images\\//g, 'src=\"/images/');\n};\n\nrenderer.image = (href: string, title: string | null, text: string) => {\n  const fixedHref = href.startsWith('images/') ? `/${href}` : href;\n  const titleAttr = title ? ` title=\"${title}\"` : '';\n  return `<img src=\"${fixedHref}\" alt=\"${text}\"${titleAttr} loading=\"lazy\" />`;\n};\n\nmarked.use({ renderer });\n\nconst BLOG_DIRECTORY = path.join(process.cwd(), 'src/content/blogs');\n\n// ─── Helpers ─────────────────────────────────────────────────────────────────\n\n/**\n * Recursively returns all .md and .mdx files under a directory.\n * Returns paths relative to BLOG_DIRECTORY (e.g. \"skin-tone/best-nude-nail-color-for-skin-tone.md\").\n */\nfunction getAllBlogFilesRecursive(dir: string, base: string = ''): string[] {\n  let results: string[] = [];\n  let entries: fs.Dirent[];\n\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true });\n  } catch {\n    return [];\n  }\n\n  for (const entry of entries) {\n    const relativePath = base ? `${base}/${entry.name}` : entry.name;\n\n    if (entry.isDirectory()) {\n      results = results.concat(getAllBlogFilesRecursive(path.join(dir, entry.name), relativePath));\n    } else if (entry.isFile() && (entry.name.endsWith('.md') || entry.name.endsWith('.mdx'))) {\n      results.push(relativePath);\n    }\n  }\n\n  return results;\n}\n\n/**\n * Strips the extension (.md or .mdx) from a relative file path to get the slug.\n * e.g. \"skin-tone/best-nude-nail-color-for-skin-tone.md\" → \"skin-tone/best-nude-nail-color-for-skin-tone\"\n */\nfunction fileToSlug(relativePath: string): string {\n  return relativePath.replace(/\\.mdx?$/, '');\n}\n\n/**\n * Given a bare slug (e.g. \"best-nude-nail-color-for-skin-tone\"), finds the file\n * anywhere in the blog directory tree. Checks flat first, then subdirectories.\n * Prefers .mdx over .md.\n */\nfunction resolveFilePath(slug: string): { filePath: string; isMDX: boolean } | null {\n  // 1. Try flat (original behaviour)\n  const flatMdx = path.join(BLOG_DIRECTORY, `${slug}.mdx`);\n  const flatMd  = path.join(BLOG_DIRECTORY, `${slug}.md`);\n  if (fs.existsSync(flatMdx)) return { filePath: flatMdx, isMDX: true };\n  if (fs.existsSync(flatMd))  return { filePath: flatMd,  isMDX: false };\n\n  // 2. Search recursively  slug may live inside a subfolder\n  const allFiles = getAllBlogFilesRecursive(BLOG_DIRECTORY);\n  const basename = slug.includes('/') ? slug : null; // if slug already has a path component\n\n  for (const relativePath of allFiles) {\n    const relativeSlug = fileToSlug(relativePath);\n\n    // Match by full relative slug (e.g. \"skin-tone/best-nude-nail-color-for-skin-tone\")\n    if (relativeSlug === slug) {\n      const filePath = path.join(BLOG_DIRECTORY, relativePath);\n      return { filePath, isMDX: relativePath.endsWith('.mdx') };\n    }\n\n    // Match by filename only (e.g. \"best-nude-nail-color-for-skin-tone\")\n    const fileBasename = path.basename(relativeSlug);\n    if (!basename && fileBasename === slug) {\n      const filePath = path.join(BLOG_DIRECTORY, relativePath);\n      return { filePath, isMDX: relativePath.endsWith('.mdx') };\n    }\n  }\n\n  return null;\n}\n\n/**\n * Humanizes a topic slug for display: replaces dashes with spaces.\n * e.g. \"almond-nails\" -> \"almond nails\"\n */\nfunction humanizeTopic(topic: string): string {\n  return topic.replace(/-/g, ' ');\n}\n\n/**\n * Injects an inspo gallery link after every <img> tag in compiled HTML,\n * when a topic is present. Runs automatically on every MD post at build\n * time  no manual work needed per post, and works for all future posts\n * that include a `topic` field in frontmatter.\n *\n * Links to /inspo/{topic}-inspiration-gallery (raw topic slug in the URL),\n * with humanized display text (dashes -> spaces).\n *\n * Set `showInspoGalleryLink: false` in a post's frontmatter to opt that\n * post out of this link even when `topic` is present. Defaults to true.\n */\nexport function injectInspoGalleryLinks(\n  html: string,\n  topic?: string,\n  showInspoGalleryLink: boolean = true\n): string {\n  if (!topic || !showInspoGalleryLink) return html;\n\n  const galleryHref = `/inspo/${topic}-inspiration-gallery`;\n  const displayTopic = humanizeTopic(topic);\n  const linkMarkup = `<p class=\"inspo-gallery-link\"><a href=\"${galleryHref}\">Explore ${displayTopic} inspiration gallery</a></p>`;\n\n  return html.replace(/(<img\\b[^>]*>)/g, `$1${linkMarkup}`);\n}\n\n// ─── Cache ───────────────────────────────────────────────────────────────────\n\ninterface CacheEntry<T> {\n  data: T;\n  timestamp: number;\n}\n\nclass BlogCache {\n  private cache = new Map<string, CacheEntry<any>>();\n  private readonly TTL = 3600000;\n\n  get<T>(key: string): T | null {\n    const entry = this.cache.get(key);\n    if (!entry) return null;\n    if (Date.now() - entry.timestamp > this.TTL) {\n      this.cache.delete(key);\n      return null;\n    }\n    return entry.data as T;\n  }\n\n  set<T>(key: string, data: T): void {\n    this.cache.set(key, { data, timestamp: Date.now() });\n  }\n\n  clear(): void {\n    this.cache.clear();\n  }\n}\n\nconst blogCache = new BlogCache();\n\n// ─── Public API ──────────────────────────────────────────────────────────────\n\nexport async function getAllBlogPosts(): Promise<BlogMetadata[]> {\n  const cacheKey = 'all-blog-posts';\n\n  const cached = blogCache.get<BlogMetadata[]>(cacheKey);\n  if (cached) return cached;\n\n  try {\n    const files = getAllBlogFilesRecurs
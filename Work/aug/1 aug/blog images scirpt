def load_json(path: Path) -> dict:
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def get_ratio(width, height) -> str:
    try:
        w, h = int(width), int(height)
        g = gcd(w, h)
        return f"{w // g}:{h // g}"
    except Exception:
        return "unknown"



      "path": "src/app/api/blog/[slug]/pdf/route.tsx",
      "content": "// src/app/api/blog/[slug]/pdf/route.ts\n\nimport { NextRequest, NextResponse } from 'next/server';\nimport { getBlogPost } from '@/lib/blog';\nimport { Document, Page, Text, View, Image, StyleSheet, renderToBuffer } from '@react-pdf/renderer';\nimport sharp from 'sharp';\n\nconst SITE_URL = 'https://mirelleinspo.com';\n\nfunction toAbsoluteUrl(src: string): string {\n  if (src.startsWith('http://') || src.startsWith('https://')) return src;\n  return `${SITE_URL}${src.startsWith('/') ? '' : '/'}${src}`;\n}\n\n// react-pdf's <Image> only supports PNG/JPEG. All site images are WebP,\n// so fetch + convert to PNG in-memory as a data URI before rendering.\nasync function toRenderablePng(src: string): Promise<string | null> {\n  try {\n    const absoluteUrl = toAbsoluteUrl(src);\n    const res = await fetch(absoluteUrl);\n    if (!res.ok) return null;\n    const arrayBuffer = await res.arrayBuffer();\n    const pngBuffer = await sharp(Buffer.from(arrayBuffer)).png().toBuffer();\n    return `data:image/png;base64,${pngBuffer.toString('base64')}`;\n  } catch {\n    return null; // skip image if conversion fails, don't break the whole PDF\n  }\n}\n\n// Strips HTML tags down to plain text + keeps <h2> as section breaks.\n// Body <img> src values are extracted separately and embedded as PDF images.\nfunction parsePostHtml(html: string): { type: 'heading' | 'paragraph' | 'image'; content: string }[] {\n  const blocks: { type: 'heading' | 'paragraph' | 'image'; content: string }[] = [];\n\n  // Split on h2 and img tags while keeping them\n  const parts = html.split(/(<h2[^>]*>.*?<\\/h2>|<img[^>]*>)/gi);\n\n  for (const part of parts) {\n    if (!part || !part.trim()) continue;\n\n    const h2Match = part.match(/<h2[^>]*>(.*?)<\\/h2>/i);\n    if (h2Match) {\n      blocks.push({ type: 'heading', content: h2Match[1].replace(/<[^>]+>/g, '').trim() });\n      continue;\n    }\n\n    const imgMatch = part.match(/<img[^>]*src=[\"']([^\"']+)[\"']/i);\n    if (imgMatch) {\n      blocks.push({ type: 'image', content: imgMatch[1] });\n      continue;\n    }\n\n    const text = part.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n    if (text) blocks.push({ type: 'paragraph', content: text });\n  }\n\n  return blocks;\n}\n\nconst styles = StyleSheet.create({\n  page: { padding: 48, fontSize: 11, fontFamily: 'Helvetica', color: '#252220' },\n  title: { fontSize: 22, marginBottom: 6, fontFamily: 'Helvetica-Bold' },\n  meta: { fontSize: 9, color: '#6b6864', marginBottom: 20 },\n  heading: { fontSize: 15, fontFamily: 'Helvetica-Bold', marginTop: 18, marginBottom: 8 },\n  paragraph: { fontSize: 11, lineHeight: 1.5, marginBottom: 10, textAlign: 'left' },\n  image: { width: '100%', maxHeight: 500, marginVertical: 12, objectFit: 'contain' },\n});\n\nexport async function GET(\n  req: NextRequest,\n  { params }: { params: Promise<{ slug: string }> }\n) {\n  const { slug } = await params;\n\n  const post = await getBlogPost(slug);\n  if (!post) {\n    return NextResponse.json({ error: 'Post not found' }, { status: 404 });\n  }\n\n  const blocks = parsePostHtml(post.content || '');\n  const dateStr = new Date(post.date).toLocaleDateString('en-US', {\n    year: 'numeric',\n    month: 'long',\n    day: 'numeric',\n  });\n\n  // Convert all images (hero + body) to PNG data URIs up front,\n  // since react-pdf's <Image> only accepts PNG/JPEG, not WebP.\n  const heroImageData = post.image ? await toRenderablePng(post.image) : null;\n\n  const blocksWithConvertedImages = await Promise.all(\n    blocks.map(async (block) => {\n      if (block.type === 'image') {\n        const converted = await toRenderablePng(block.content);\n        return { ...block, content: converted || '' };\n      }\n      return block;\n    })\n  );\n\n  const doc = (\n    <Document title={post.title} author={post.author}>\n      <Page size=\"A4\" style={styles.page}>\n        <Text style={styles.title}>{post.title}</Text>\n        <Text style={styles.meta}>\n          By {post.author} · {dateStr}\n        </Text>\n\n        {heroImageData && (\n          // eslint-disable-next-line jsx-a11y/alt-text\n          <Image src={heroImageData} style={styles.image} />\n        )}\n\n        {blocksWithConvertedImages.map((block, i) => {\n          if (block.type === 'heading') {\n            return (\n              <Text key={i} style={styles.heading}>\n                {block.content}\n              </Text>\n            );\n          }\n          if (block.type === 'image') {\n            if (!block.content) return null; // skip images that failed to convert\n            return (\n              // eslint-disable-next-line jsx-a11y/alt-text\n              <Image key={i} src={block.content} style={styles.image} />\n            );\n          }\n          return (\n            <Text key={i} style={styles.paragraph}>\n              {block.content}\n            </Text>\n          );\n        })}\n      </Page>\n    </Document>\n  );\n\n  const pdfBuffer = await renderToBuffer(doc);\n\n  return new NextResponse(new Uint8Array(pdfBuffer), {\n    status: 200,\n    headers: {\n      'Content-Type': 'application/pdf',\n      'Content-Disposition': `attachment; filename=\"${slug}.pdf\"`,\n      'Cache-Control': 'no-store',\n    },\n  });\n}"
    },

      "path": "scripts/generate-all-sitemaps.js",
      "content": "const fs = require('fs');\nconst path = require('path');\nconst matter = require('gray-matter');\n\nconst SITE_URL = 'https://mirelleinspo.com';\nconst PUBLIC_DIR = path.join(process.cwd(), 'public');\n\n// ─── HELPERS ─────────────────────────────────────────────────────────────────\n\nfunction getCurrentSeason() {\n  const month = new Date().getMonth();\n  if (month >= 2 && month <= 4) return 'spring';\n  if (month >= 5 && month <= 7) return 'summer';\n  if (month >= 8 && month <= 10) return 'fall';\n  return 'winter';\n}\n\nfunction formatLastmod(dateStr) {\n  if (!dateStr) return new Date().toISOString().split('T')[0];\n  const d = new Date(dateStr);\n  if (isNaN(d.getTime())) return new Date().toISOString().split('T')[0];\n  return d.toISOString().split('T')[0];\n}\n\nfunction createSitemap(urls) {\n  return `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n${urls.map(url => `  <url>\n    <loc>${url.loc}</loc>\n    <lastmod>${url.lastmod || new Date().toISOString()}</lastmod>\n    <changefreq>${url.changefreq || 'weekly'}</changefreq>\n    <priority>${url.priority || 0.7}</priority>\n  </url>`).join('\\n')}\n</urlset>`;\n}\n\nfunction createSitemapIndex(sitemaps) {\n  return `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<sitemapindex xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n${sitemaps.map(sitemap => `  <sitemap>\n    <loc>${SITE_URL}/${sitemap}</loc>\n    <lastmod>${new Date().toISOString()}</lastmod>\n  </sitemap>`).join('\\n')}\n</sitemapindex>`;\n}\n\nfunction createImageSitemap(images) {\n  return `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"\n        xmlns:image=\"http://www.google.com/schemas/sitemap-image/1.1\">\n${images.map(img => `  <url>\n    <loc>${img.pageUrl}</loc>\n    <image:image>\n      <image:loc>${img.imageUrl}</image:loc>\n      <image:title>${escapeXml(img.title)}</image:title>\n      ${img.caption ? `<image:caption>${escapeXml(img.caption)}</image:caption>` : ''}\n    </image:image>\n  </url>`).join('\\n')}\n</urlset>`;\n}\n\nfunction escapeXml(str) {\n  if (!str) return '';\n  return str\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&apos;');\n}\n\nfunction readContentFiles(dir) {\n  if (!fs.existsSync(dir)) return [];\n  return fs.readdirSync(dir).filter(f => f.endsWith('.md') || f.endsWith('.mdx'));\n}\n\nfunction resolveImageUrl(imageUrl, baseImagePath) {\n  if (!imageUrl) return null;\n  if (imageUrl.startsWith('http')) return imageUrl;\n  if (imageUrl.startsWith('/')) return `${SITE_URL}${imageUrl}`;\n  return `${SITE_URL}${baseImagePath}/${imageUrl}`;\n}\n\nfunction extractImagesFromContent(content, slug, frontmatter, baseImagePath) {\n  const images = [];\n  const seen = new Set();\n\n  const addImage = (imageUrl, alt, type) => {\n    const url = resolveImageUrl(imageUrl, baseImagePath);\n    if (url && !seen.has(url)) {\n      images.push({ url, alt, type });\n      seen.add(url);\n    }\n  };\n\n  if (frontmatter.image) {\n    addImage(frontmatter.image, frontmatter.imageAlt || `${slug.replace(/-/g, ' ')} featured image`, 'hero');\n  }\n\n  (frontmatter.galleryImages || []).forEach(img => {\n    addImage(img.url || img.src || img, img.alt || `${slug.replace(/-/g, ' ')} gallery image`, 'gallery');\n  });\n\n  (frontmatter.carouselImages || []).forEach(img => {\n    addImage(img.src || img.url || img, img.alt || `${slug.replace(/-/g, ' ')} carousel image`, 'carousel');\n  });\n\n  const mdImageRegex = /!\\[([^\\]]*)\\]\\(([^)]+)\\)/g;\n  let match;\n  while ((match = mdImageRegex.exec(content)) !== null) {\n    addImage(match[2], match[1] || `${slug.replace(/-/g, ' ')} image`, 'markdown');\n  }\n\n  const htmlMatches = content.match(/<img[^>]+>/gi) || [];\n  htmlMatches.forEach(imgTag => {\n    const srcMatch = imgTag.match(/src=[\"']([^\"']+)[\"']/i);\n    const altMatch = imgTag.match(/alt=[\"']([^\"']*)[\"']/i);\n    if (srcMatch) {\n      addImage(srcMatch[1], altMatch ? altMatch[1] : `${slug.replace(/-/g, ' ')} image`, 'html');\n    }\n  });\n\n  return images.filter(img => img.url.startsWith(`${SITE_URL}/images/`));\n}\n\n// ─── PAGE SITEMAP (flat) ──────────────────────────────────────────────────────\n\nfunction generatePageSitemap(label, dir, urlPrefix, listPagePriority, itemPriority) {\n  console.log(`📄 Generating ${label} sitemap...`);\n  try {\n    const files = readContentFiles(dir);\n    if (files.length === 0) {\n      console.warn(`⚠️  No files found in ${dir}  generating listing page only`);\n    }\n\n    const urls = [\n      {\n        loc: `${SITE_URL}/${urlPrefix}`,\n        changefreq: 'daily',\n        priority: listPagePriority,\n        lastmod: new Date().toISOString(),\n      },\n      ...files.map(file => {\n        const slug = file.replace(/\\.mdx?$/, '');\n        const filePath = path.join(dir, file);\n        const fileContent = fs.readFileSync(filePath, 'utf8');\n        const { data } = matter(fileContent);\n        return {\n          loc: `${SITE_URL}/${urlPrefix}/${slug}`,\n          changefreq: 'weekly',\n          priority: itemPriority,\n          lastmod: formatLastmod(data.dateModified || data.date),\n        };\n      }),\n    ];\n\n    const xml = createSitemap(urls);\n    fs.writeFileSync(path.join(PUBLIC_DIR, `sitemap-${urlPrefix}.xml`), xml);\n    console.log(`✅ sitemap-${urlPrefix}.xml created (${files.length} items)`);\n  } catch (error) {\n    console.error(`❌ Error generating ${label} sitemap:`, error.message);\n  }\n}\n\n// ─── PINTEREST SITEMAP (frontmatter-slug-aware) ──────────────────────────────\n//\n// Pinterest is NOT a flat filename=slug directory like nail-feed/stories/salons.\n// Per src/lib/pinterest.ts, the URL slug lives in each file's frontmatter\n// (`data.slug`), while the filename on disk can be anything (e.g. date-based\n// for sorting). Using generatePageSitemap() here would silently build wrong\n// URLs from filenames instead of the real frontmatter slug - so this reads\n// frontmatter explicitly instead, mirroring getAllPinterestSlugs()'s logic.\n\nfunction generatePinterestSitemap() {\n  console.log('📄 Generating pinterest sitemap (frontmatter-slug-aware)...');\n  try {\n    const pinterestDir = path.join(process.cwd(), 'src/content/pinterest');\n\n    const urls = [\n      {\n        loc: `${SITE_URL}/pinterest`,\n        changefreq: 'daily',\n        priority: 0.8,\n        lastmod: new Date().toISOString(),\n      },\n    ];\n\n    if (!fs.existsSync(pinterestDir)) {\n      console.warn('⚠️  src/content/pinterest not found  generating listing page only');\n      fs.writeFileSync(path.join(PUBLIC_DIR, 'sitemap-pinterest.xml'), createSitemap(urls));\n      console.log('✅ sitemap-pinterest.xml created (0 items)');\n      return;\n    }\n\n    // Pinterest content is .mdx only (per pinterest.ts), but readContentFiles\n    // also matches .md defensively in case that ever changes.\n    const files = readContentFiles(pinterestDir);\n    let itemCount = 0;\n    let skippedCount = 0;\n\n    files.forEach(file => {\n      const filePath = path.join(pinterestDir, file);\n      const fileContent = fs.readFileSync(filePath, 'utf8');\n      const { data } = matter(fileContent);\n\n      // Slug comes from frontmatter, NOT the filename - filenames may be\n      // date-based for on-disk sorting and are not reliable URL slugs here.\n      const slug = data.slug;\n\n      if (!slug) {\n        console.warn(`   ⚠️  Skipping ${file}  no slug in frontmatter`);\n        skippedCount++;\n        return;\n      }\n\n      urls.push({\n        loc: `${SITE_URL}/pinterest/${slug}`,\n        changefreq: 'weekly',\n        priority: 0.7,\n        lastmod: formatLastmod(data.dateModified || data.date),\n      });\n      itemCount++;\n    });\n\n    fs.writeFileSync(path.join(PUBLIC_DIR, 'sitemap-pinterest.xml'), createSitemap(urls));\n    console.log(`✅ sitemap-pinterest.xml created (${itemCount} items${skippedCount ? `, ${skippedCount} skipped` : ''})`);\n  } catch (error) {\n    console.error('❌ Error generating pinterest sitemap:', error.message);\n  }\n}\n\n// ─── IMAGE SITEMAP (flat) ─────────────────────────────────────────────────────\n\nfunction generateImageSitemapForCategory(label, dir, urlPrefix, baseImagePath) {\n  console.log(`📸 Generating ${label} image sitemap...`);\n  try {\n    const files = readContentFiles(dir);\n    if (files.length === 0) {\n      console.warn(`⚠️  No files found in ${dir}`);\n      return null;\n    }\n\n    const allImages = [];\n    const currentYear = new Date().getFullYear();\n    const season = getCurrentSeason();\n\n    files.forEach(file => {\n      const slug = file.replace(/\\.mdx?$/, '');\n      const filePath = path.join(dir, file);\n      const fileContent = fs.readFileSync(filePath, 'utf8');\n      const { data, content } = matter(fileContent);\n      const images = extractImagesFromContent(content, slug, data, `${baseImagePath}/${slug}`);\n\n      if (images.length > 0) {\n        const cleanTitle = data.title || slug.replace(/-/g, ' ');\n        images.forEach(img => {\n          allImages.push({\n            pageUrl: `${SITE_URL}/${urlPrefix}/${slug}`,\n            imageUrl: img.url,\n            title: `${cleanTitle} - ${img.type} image`,\n            caption: img.alt || `${cleanTitle} - nail art inspiration for ${season} ${currentYear}`,\n          });\n        });\n        console.log(`   ✔ ${slug}: ${images.length} image(s)`);\n      }\n    });\n\n    if (allImages.length === 0) {\n      console.warn(`⚠️  No images found for ${label}`);\n      return null;\n    }\n\n    const sitemapFileName = `sitemap-images-${urlPrefix}.xml`;\n    fs.writeFileSync(path.join(PUBLIC_DIR, sitemapFileName), createImageSitemap(allImages));\n    console.log(`✅ ${sitemapFileName} created (${allImages.length} images)`);\n    return sitemapFileName;\n  } catch (error) {\n    console.error(`❌ Error generating ${label} image sitemap:`, error.message);\n    return null;\n  }\n}\n\n// ─── AUTHORS SITEMAP ──────────────────────────────────────────────────────────\n\nfunction generateAuthorsSitemap() {\n  console.log('📄 Generating authors sitemap...');\n  try {\n    const authorSlugs = ['ri-mirelle', 'jyoti-mirelle'];\n\n    const urls = [\n      {\n        loc: `${SITE_URL}/authors`,\n        changefreq: 'monthly',\n        priority: 0.7,\n        lastmod: new Date().toISOString(),\n      },\n      ...authorSlugs.map(slug => ({\n        loc: `${SITE_URL}/authors/${slug}`,\n        changefreq: 'monthly',\n        priority: 0.6,\n        lastmod: new Date().toISOString(),\n      })),\n    ];\n\n    fs.writeFileSync(path.join(PUBLIC_DIR, 'sitemap-authors.xml'), createSitemap(urls));\n    console.log(`✅ sitemap-authors.xml created (${authorSlugs.length} author profiles)`);\n  } catch (error) {\n    console.error('❌ Error generating authors sitemap:', error.message);\n  }\n}\n\n// ─── BLOG SITEMAP (frontmatter-aware, recursive) ─────────────────────────────\n//\n// NOTE (Aug 2026 update): /blog/[topic] hub pages are navigational only -\n// they are set to noindex in the page component and must NOT be listed in\n// the sitemap. Only individual posts (/blog/[topic]/[slug]) are included.\n// The `registeredHubs` bookkeeping is kept (for the console summary / dedup\n// logic) but hub URLs are no longer pushed into `urls`.\n\nfunction generateBlogSitemap() {\n  console.log('📄 Generating blog sitemap (frontmatter-aware)...');\n  try {\n    const blogsDir = path.join(process.cwd(), 'src/content/blogs');\n    if (!fs.existsSync(blogsDir)) {\n      console.warn('⚠️  src/content/blogs not found');\n      return;\n    }\n\n    const urls = [\n      {\n        loc: `${SITE_URL}/blog`,\n        changefreq: 'daily',\n        priority: 0.9,\n        lastmod: new Date().toISOString(),\n      },\n    ];\n\n    const registeredHubs = new Set();\n    let pillarCount = 0;\n    let clusterCount = 0;\n    let flatCount = 0;\n\n    const processFile = (filePath) => {\n      try {\n        const fileContent = fs.readFileSync(filePath, 'utf8');\n        const { data } = matter(fileContent);\n        const slug = data.slug || path.basename(filePath).replace(/\\.mdx?$/, '');\n        const topic = data.topic || null;\n        const isPillar = data.topicalMap?.position === 'pillar';\n        const lastmod = formatLastmod(data.dateModified || data.date);\n\n        if (topic) {\n          // /blog/[topic] hub pages are navigational-only and noindexed -\n          // do NOT add them to the sitemap. We still track them in\n          // registeredHubs purely for the summary log below.\n          if (isPillar && !registeredHubs.has(topic)) {\n            registeredHubs.add(topic);\n            pillarCount++;\n          }\n\n          urls.push({\n            loc: `${SITE_URL}/blog/${topic}/${slug}`,\n            changefreq: 'weekly',\n            priority: isPillar ? 0.8 : 0.7,\n            lastmod,\n          });\n\n          if (!isPillar) clusterCount++;\n        } else {\n          urls.push({\n            loc: `${SITE_URL}/blog/${slug}`,\n            changefreq: 'weekly',\n            priority: 0.7,\n            lastmod,\n          });\n          flatCount++;\n        }\n      } catch (err) {\n        // Skip this one bad file instead of killing the entire blog sitemap.\n        console.error(`   ❌ Skipping ${filePath}: ${err.message}`);\n      }\n    };\n\n    const entries = fs.readdirSync(blogsDir);\n\n    entries.forEach(entry => {\n      const entryPath = path.join(blogsDir, entry);\n      const stat = fs.statSync(entryPath);\n\n      if (stat.isDirectory()) {\n        readContentFiles(entryPath).forEach(file =>\n          processFile(path.join(entryPath, file))\n        );\n      } else if (entry.endsWith('.md') || entry.endsWith('.mdx')) {\n        processFile(entryPath);\n      }\n    });\n\n    fs.writeFileSync(path.join(PUBLIC_DIR, 'sitemap-blog.xml'), createSitemap(urls));\n    console.log(`✅ sitemap-blog.xml created (${registeredHubs.size} hub pages excluded [noindex], ${pillarCount} pillars, ${clusterCount} clusters, ${flatCount} flat posts)`);\n  } catch (error) {\n    console.error('❌ Error generating blog sitemap:', error.message);\n  }\n}\n\n// ─── BLOG IMAGE SITEMAP (frontmatter-aware, recursive) ───────────────────────\n\nfunction generateBlogImageSitemap() {\n  console.log('📸 Generating blog image sitemap (frontmatter-aware)...');\n  try {\n    const blogsDir = path.join(process.cwd(), 'src/content/blogs');\n    if (!fs.existsSync(blogsDir)) return null;\n\n    const allImages = [];\n    const currentYear = new Date().getFullYear();\n    const season = getCurrentSeason();\n\n    const processFile = (filePath) => {\n      const fileContent = fs.readFileSync(filePath, 'utf8');\n      const { data, content } = matter(fileContent);\n      const slug = data.slug || path.basename(filePath).replace(/\\.mdx?$/, '');\n      const topic = data.topic || null;\n\n      const pageUrl = topic\n        ? `${SITE_URL}/blog/${topic}/${slug}`\n        : `${SITE_URL}/blog/${slug}`;\n\n      const imageBasePath = topic\n        ? `/images/blog/${topic}/${slug}`\n        : `/images/blog/${slug}`;\n\n      const images = extractImagesFromContent(content, slug, data, imageBasePath);\n      const cleanTitle = data.title || slug.replace(/-/g, ' ');\n\n      images.forEach(img => {\n        allImages.push({\n          pageUrl,\n          imageUrl: img.url,\n          title: `${cleanTitle} - ${img.type} image`,\n          caption: img.alt || `${cleanTitle} - nail art inspiration for ${season} ${currentYear}`,\n        });\n      });\n\n      if (images.length > 0) {\n        console.log(`   ✔ ${pageUrl.replace(SITE_URL, '')}: ${images.length} image(s)`);\n      }\n    };\n\n    const entries = fs.readdirSync(blogsDir);\n\n    entries.forEach(entry => {\n      const entryPath = path.join(blogsDir, entry);\n      const stat = fs.statSync(entryPath);\n\n      if (stat.isDirectory()) {\n        readContentFiles(entryPath).forEach(file =>\n          processFile(path.join(entryPath, file))\n        );\n      } else if (entry.endsWith('.md') || entry.endsWith('.mdx')) {\n        processFile(entryPath);\n      }\n    });\n\n    if (allImages.length === 0) {\n      console.warn('⚠️  No images found for blog');\n      return null;\n    }\n\n    fs.writeFileSync(path.join(PUBLIC_DIR, 'sitemap-images-blog.xml'), createImageSitemap(allImages));\n    console.log(`✅ sitemap-images-blog.xml created (${allImages.length} images)`);\n    return 'sitemap-images-blog.xml';\n  } catch (error) {\n    console.error('❌ Error generating blog image sitemap:', error.message);\n    return null;\n  }\n}\n\n// ─── SHOP SITEMAP (frontmatter-aware: productType + slug from frontmatter) ──\n\nfunction generateShopSitemap() {\n  console.log('📄 Generating shop sitemap (frontmatter-aware)...');\n  try {\n    const shopDir = path.join(process.cwd(), 'src/content/shop');\n    if (!fs.existsSync(shopDir)) {\n      console.warn('⚠️  src/content/shop not found');\n      return;\n    }\n\n    const urls = [\n      {\n        loc: `${SITE_URL}/shop`,\n        changefreq: 'daily',\n        priority: 0.9,\n        lastmod: formatLastmod(),\n      },\n    ];\n\n    const registeredProductTypes = new Set();\n    let itemCount = 0;\n    let skippedCount = 0;\n\n    const processFile = (filePath, folderName) => {\n      const fileContent = fs.readFileSync(filePath, 'utf8');\n      const { data } = matter(fileContent);\n\n      const productType = data.productType || folderName;\n      const slug = data.slug || path.basename(filePath).replace(/\\.mdx?$/, '');\n      const lastmod = formatLastmod(data.dateModified || data.date);\n\n      if (!productType || !slug) {\n        console.warn(`   ⚠️  Skipping ${filePath}  missing productType or slug in frontmatter`);\n        skippedCount++;\n        return;\n      }\n\n      if (!registeredProductTypes.has(productType)) {\n        urls.push({\n          loc: `${SITE_URL}/shop/${productType}`,\n          changefreq: 'weekly',\n          priority: 0.8,\n          lastmod,\n        });\n        registeredProductTypes.add(productType);\n      }\n\n      urls.push({\n        loc: `${SITE_URL}/shop/${productType}/${slug}`,\n        changefreq: 'weekly',\n        priority: 0.7,\n        lastmod,\n      });\n      itemCount++;\n    };\n\n    const entries = fs.readdirSync(shopDir);\n\n    entries.forEach(entry => {\n      const entryPath = path.join(shopDir, entry);\n      const stat = fs.statSync(entryPath);\n\n      if (stat.isDirectory()) {\n        readContentFiles(entryPath).forEach(file =>\n          processFile(path.join(entryPath, file), entry)\n        );\n      } else if (entry.endsWith('.md') || entry.endsWith('.mdx')) {\n        processFile(entryPath, null);\n      }\n    });\n\n    fs.writeFileSync(path.join(PUBLIC_DIR, 'sitemap-shop.xml'), createSitemap(urls));\n    console.log(`✅ sitemap-shop.xml created (${registeredProductTypes.size} product types, ${itemCount} products${skippedCount ? `, ${skippedCount} skipped` : ''})`);\n  } catch (error) {\n    console.error('❌ Error generating shop sitemap:', error.message);\n  }\n}\n\n// ─── INSPO SITEMAPS (JSON based) ──────────────────────────────────────────────\n\nfunction generateInspoSitemap() {\n  console.log('📄 Generating inspo sitemap...');\n  try {\n    const inspoDir = path.join(process.cwd(), 'src/content/inspo-images');\n    const files = fs.readdirSync(inspoDir).filter(f => f.endsWith('.json'));\n\n    const urls = [\n      { loc: `${SITE_URL}/inspo`, changefreq: 'daily', priority: 0.9, lastmod: new Date().toISOString() },\n      ...files.map(file => ({\n        loc: `${SITE_URL}/inspo/${file.replace('.json', '')}`,\n        changefreq: 'weekly',\n        priority: 0.8,\n        lastmod: new Date().toISOString(),\n      })),\n    ];\n\n    fs.writeFileSync(path.join(PUBLIC_DIR, 'sitemap-inspo.xml'), createSitemap(urls));\n    console.log(`✅ sitemap-inspo.xml created (${files.length} categories)`);\n  } catch (error) {\n    console.error('❌ Error generating inspo sitemap:', error.message);\n  }\n}\n\nfunction generateInspoImageSitemap() {\n  console.log('📸 Generating inspo image sitemap...');\n  try {\n    const inspoJsonDir = path.join(process.cwd(), 'src/content/inspo-images');\n    if (!fs.existsSync(inspoJsonDir)) return null;\n\n    const jsonFiles = fs.readdirSync(inspoJsonDir).filter(f => f.endsWith('.json'));\n    const inspoImages = [];\n    const currentYear = new Date().getFullYear();\n    const season = getCurrentSeason();\n\n    jsonFiles.forEach(jsonFile => {\n      const category = jsonFile.replace('.json', '');\n      const jsonPath = path.join(inspoJsonDir, jsonFile);\n      try {\n        const data = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));\n        const images = Array.isArray(data) ? data : data.images ? data.images : Object.values(data);\n\n        images.forEach((image, index) => {\n          let imageUrl = typeof image === 'string' ? image : image.url || image.src || image.image;\n          if (!imageUrl) return;\n          if (imageUrl.startsWith('/')) imageUrl = `${SITE_URL}${imageUrl}`;\n          else if (!imageUrl.startsWith('http')) imageUrl = `${SITE_URL}/inspo/${category}/${imageUrl}`;\n\n          const altText = typeof image === 'object' ? (image.alt || image.altText || image.description) : null;\n          inspoImages.push({\n            pageUrl: `${SITE_URL}/inspo/${category}`,\n            imageUrl,\n            title: `${category.replace(/-/g, ' ')} nail inspiration ${index + 1}`,\n            caption: altText || `${category.replace(/-/g, ' ')} nail art design - trending style for ${season} ${currentYear}`,\n          });\n        });\n      } catch (error) {\n        console.error(`   ❌ ${category}:`, error.message);\n      }\n    });\n\n    if (inspoImages.length === 0) return null;\n\n    fs.writeFileSync(path.join(PUBLIC_DIR, 'sitemap-images-inspo.xml'), createImageSitemap(inspoImages));\n    console.log(`✅ sitemap-images-inspo.xml created (${inspoImages.length} images)`);\n    return 'sitemap-images-inspo.xml';\n  } catch (error) {\n    console.error('❌ Error generating inspo image sitemap:', error.message);\n    return null;\n  }\n}\n\n// ─── BUSINESS SITEMAP ─────────────────────────────────────────────────────────\n//\n// NOTE (Aug 2026 update): business structure flattened to /business/[slug] -\n// the old /business/[country]/[state]/[clientType]/[slug] nesting no longer\n// exists, so this is now a single flat sitemap (same pattern as shop/blog)\n// instead of a country/state index-of-indexes.\n\nfunction generateBusinessSitemap() {\n  console.log('📄 Generating business sitemap...');\n  try {\n    const businessDir = path.join(process.cwd(), 'src/content/business');\n\n    const urls = [\n      { loc: `${SITE_URL}/business`, changefreq: 'daily', priority: 0.9, lastmod: new Date().toISOString() },\n    ];\n\n    if (!fs.existsSync(businessDir)) {\n      console.warn('⚠️  src/content/business not found  generating listing page only');\n      fs.writeFileSync(path.join(PUBLIC_DIR, 'sitemap-business.xml'), createSitemap(urls));\n      console.log('✅ sitemap-business.xml created (0 items)');\n      return;\n    }\n\n    const files = readContentFiles(businessDir);\n\n    files.forEach(file => {\n      const slug = file.replace(/\\.mdx?$/, '');\n      const filePath = path.join(businessDir, file);\n      const fileContent = fs.readFileSync(filePath, 'utf8');\n      const { data } = matter(fileContent);\n      urls.push({\n        loc: `${SITE_URL}/business/${slug}`,\n        changefreq: 'weekly',\n        priority: 0.7,\n        lastmod: formatLastmod(data.dateModified || data.date),\n      });\n    });\n\n    fs.writeFileSync(path.join(PUBLIC_DIR, 'sitemap-business.xml'), createSitemap(urls));\n    console.log(`✅ site
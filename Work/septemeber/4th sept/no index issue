      "path": "src/lib/blog.ts",
      "content": "import 'server-only';\nimport fs from 'fs';\nimport path from 'path';\nimport matter from 'gray-matter';\nimport { BlogPost, BlogMetadata } from '@/types/blog';\nimport { marked } from 'marked';\n\n// Configure marked to handle HTML properly\nmarked.setOptions({\n  breaks: true,\n  gfm: true,\n});\n\n// Custom renderer to preserve HTML and fix image paths\nconst renderer = new marked.Renderer();\n\nrenderer.html = (html: string) => {\n  return html.replace(/src=\"images\\//g, 'src=\"/images/');\n};\n\nrenderer.image = (href: string, title: string | null, text: string) => {\n  const fixedHref = href.startsWith('images/') ? `/${href}` : href;\n  const titleAttr = title ? ` title=\"${title}\"` : '';\n  return `<img src=\"${fixedHref}\" alt=\"${text}\"${titleAttr} loading=\"lazy\" />`;\n};\n\nmarked.use({ renderer });\n\nconst BLOG_DIRECTORY = path.join(process.cwd(), 'src/content/blogs');\n\n// ─── Helpers ─────────────────────────────────────────────────────────────────\n\n/**\n * Recursively returns all .md and .mdx files under a directory.\n * Returns paths relative to BLOG_DIRECTORY (e.g. \"skin-tone/best-nude-nail-color-for-skin-tone.md\").\n */\nfunction getAllBlogFilesRecursive(dir: string, base: string = ''): string[] {\n  let results: string[] = [];\n  let entries: fs.Dirent[];\n\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true });\n  } catch {\n    return [];\n  }\n\n  for (const entry of entries) {\n    const relativePath = base ? `${base}/${entry.name}` : entry.name;\n\n    if (entry.isDirectory()) {\n      results = results.concat(getAllBlogFilesRecursive(path.join(dir, entry.name), relativePath));\n    } else if (entry.isFile() && (entry.name.endsWith('.md') || entry.name.endsWith('.mdx'))) {\n      results.push(relativePath);\n    }\n  }\n\n  return results;\n}\n\n/**\n * Strips the extension (.md or .mdx) from a relative file path to get the slug.\n * e.g. \"skin-tone/best-nude-nail-color-for-skin-tone.md\" → \"skin-tone/best-nude-nail-color-for-skin-tone\"\n */\nfunction fileToSlug(relativePath: string): string {\n  return relativePath.replace(/\\.mdx?$/, '');\n}\n\n/**\n * Given a bare slug (e.g. \"best-nude-nail-color-for-skin-tone\"), finds the file\n * anywhere in the blog directory tree. Checks flat first, then subdirectories.\n * Prefers .mdx over .md.\n */\nfunction resolveFilePath(slug: string): { filePath: string; isMDX: boolean } | null {\n  // 1. Try flat (original behaviour)\n  const flatMdx = path.join(BLOG_DIRECTORY, `${slug}.mdx`);\n  const flatMd  = path.join(BLOG_DIRECTORY, `${slug}.md`);\n  if (fs.existsSync(flatMdx)) return { filePath: flatMdx, isMDX: true };\n  if (fs.existsSync(flatMd))  return { filePath: flatMd,  isMDX: false };\n\n  // 2. Search recursively  slug may live inside a subfolder\n  const allFiles = getAllBlogFilesRecursive(BLOG_DIRECTORY);\n  const basename = slug.includes('/') ? slug : null; // if slug already has a path component\n\n  for (const relativePath of allFiles) {\n    const relativeSlug = fileToSlug(relativePath);\n\n    // Match by full relative slug (e.g. \"skin-tone/best-nude-nail-color-for-skin-tone\")\n    if (relativeSlug === slug) {\n      const filePath = path.join(BLOG_DIRECTORY, relativePath);\n      return { filePath, isMDX: relativePath.endsWith('.mdx') };\n    }\n\n    // Match by filename only (e.g. \"best-nude-nail-color-for-skin-tone\")\n    const fileBasename = path.basename(relativeSlug);\n    if (!basename && fileBasename === slug) {\n      const filePath = path.join(BLOG_DIRECTORY, relativePath);\n      return { filePath, isMDX: relativePath.endsWith('.mdx') };\n    }\n  }\n\n  return null;\n}\n\n/**\n * Humanizes a topic slug for display: replaces dashes with spaces.\n * e.g. \"almond-nails\" -> \"almond nails\"\n */\nfunction humanizeTopic(topic: string): string {\n  return topic.replace(/-/g, ' ');\n}\n\n/**\n * Injects an inspo gallery link after every <img> tag in compiled HTML,\n * when a topic is present. Runs automatically on every MD post at build\n * time  no manual work needed per post, and works for all future posts\n * that include a `topic` field in frontmatter.\n *\n * Links to /inspo/{topic}-inspiration-gallery (raw topic slug in the URL),\n * with humanized display text (dashes -> spaces).\n *\n * Set `showInspoGalleryLink: false` in a post's frontmatter to opt that\n * post out of this link even when `topic` is present. Defaults to true.\n */\nexport function injectInspoGalleryLinks(\n  html: string,\n  topic?: string,\n  showInspoGalleryLink: boolean = true\n): string {\n  if (!topic || !showInspoGalleryLink) return html;\n\n  const galleryHref = `/inspo/${topic}-inspiration-gallery`;\n  const displayTopic = humanizeTopic(topic);\n  const linkMarkup = `<p class=\"inspo-gallery-link\"><a href=\"${galleryHref}\">Explore ${displayTopic} inspiration gallery</a></p>`;\n\n  return html.replace(/(<img\\b[^>]*>)/g, `$1${linkMarkup}`);\n}\n\n// ─── Cache ───────────────────────────────────────────────────────────────────\n\ninterface CacheEntry<T> {\n  data: T;\n  timestamp: number;\n}\n\nclass BlogCache {\n  private cache = new Map<string, CacheEntry<any>>();\n  private readonly TTL = 3600000;\n\n  get<T>(key: string): T | null {\n    const entry = this.cache.get(key);\n    if (!entry) return null;\n    if (Date.now() - entry.timestamp > this.TTL) {\n      this.cache.delete(key);\n      return null;\n    }\n    return entry.data as T;\n  }\n\n  set<T>(key: string, data: T): void {\n    this.cache.set(key, { data, timestamp: Date.now() });\n  }\n\n  clear(): void {\n    this.cache.clear();\n  }\n}\n\nconst blogCache = new BlogCache();\n\n// ─── Public API ──────────────────────────────────────────────────────────────\n\nexport async function getAllBlogPosts(): Promise<BlogMetadata[]> {\n  const cacheKey = 'all-blog-posts';\n\n  const cached = blogCache.get<BlogMetadata[]>(cacheKey);\n  if (cached) return cached;\n\n  try {\n    const files = getAllBlogFilesRecursive(BLOG_DIRECTORY);\n\n    const posts = files\n      .map(relativePath => {\n        const relativeSlug = fileToSlug(relativePath);\n        // The bare slug is the filename without extension (for getBlogPost lookups)\n        const slug     = path.basename(relativeSlug);\n        const filePath = path.join(BLOG_DIRECTORY, relativePath);\n        const content  = fs.readFileSync(filePath, 'utf8');\n        const { data } = matter(content);\n\n        return {\n          slug,\n          title:             data.title      || 'Untitled',\n          excerpt:           data.excerpt    || '',\n          date:              data.date       || new Date().toISOString(),\n          author:            data.author     || 'Mirellé Team',\n          category:          data.category,\n          image:             data.image      || null,\n          imageAlt:          data.imageAlt,\n          imageWidth:        data.imageWidth  || 1200,\n          imageHeight:       data.imageHeight || 630,\n          readTime:          data.readTime   || '5 min',\n          topic:             data.topic,\n          canonical: data.canonical || (data.topic ? `https://mirelleinspo.com/blog/${data.topic}/${slug}` : `https://mirelleinspo.com/blog/${slug}`),\n          template:          data.template   || 'center',\n          topicalMap:        data.topicalMap,\n          navigationContext: data.navigationContext,\n          showInspoGalleryLink: data.showInspoGalleryLink !== false,\n          url: data.topic ? `https://mirelleinspo.com/blog/${data.topic}/${slug}` : `https://mirelleinspo.com/blog/${slug}`,\n        } as BlogMetadata;\n      })\n      .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());\n\n    blogCache.set(cacheKey, posts);\n    return posts;\n  } catch (error) {\n    console.error('Error reading blog posts:', error);\n    return [];\n  }\n}\n\nexport async function getBlogPost(slug: string): Promise<BlogPost | null> {\n  const cacheKey = `blog-post:${slug}`;\n\n  const cached = blogCache.get<BlogPost>(cacheKey);\n  if (cached) return cached;\n\n  try {\n    const resolved = resolveFilePath(slug);\n    if (!resolved) {\n      console.error(`Blog post not found: ${slug}`);\n      return null;\n    }\n\n    const { filePath, isMDX } = resolved;\n    const fileContent = fs.readFileSync(filePath, 'utf8');\n    const { data, content: rawContent } = matter(fileContent);\n\n    const showInspoGalleryLink = data.showInspoGalleryLink !== false;\n\n    let htmlContent: string;\n\n    if (isMDX) {\n      htmlContent = rawContent;\n    } else {\n      let compiled = await marked(rawContent);\n\n\n      // Add IDs to <h2> tags for anchor links (optional, can be enabled if needed)\n      // compiled = compiled.replace(\n      //   /<h2>(.*?)<\\/h2>/g,\n      //   (_match, text) => {\n      //     const cleanText = text.replace(/<[^>]*>/g, '');\n      //     const id = cleanText\n      //       .toLowerCase()\n      //       .replace(/[^a-z0-9]+/g, '-')\n      //       .replace(/^-+|-+$/g, '');\n      //     return `<h2 id=\"${id}\">${text}</h2>`;\n      //   }\n      // );\n\n      htmlContent = injectInspoGalleryLinks(compiled, data.topic, showInspoGalleryLink);\n    }\n\n    // Bare slug = filename without extension (consistent with getAllBlogPosts)\n    const bareSlug = path.basename(slug.replace(/\\.mdx?$/, ''));\n\n    const post: BlogPost = {\n      slug:              bareSlug,\n      title:             data.title      || 'Untitled',\n      excerpt:           data.excerpt    || '',\n      content:           htmlContent,\n      isMDX,\n      date:              data.date       || new Date().toISOString(),\n      author:            data.author     || 'Mirellé Team',\n      category:          data.category,\n      image:             data.image      || null,\n      imageAlt:          data.imageAlt,\n      imageWidth:        data.imageWidth  || 1200,\n      imageHeight:       data.imageHeight || 630,\n      readTime:          data.readTime   || '5 min',\n      topic:             data.topic,\n      canonical: data.canonical || (data.topic ? `https://mirelleinspo.com/blog/${data.topic}/${bareSlug}` : `https://mirelleinspo.com/blog/${bareSlug}`),\n      template:          data.template   || 'center',\n      topicalMap:        data.topicalMap,\n      navigationContext: data.navigationContext,\n      carouselImages:    data.carouselImages,\n      products:          data.products,\n      coverImage:        data.image      || '/images/default-blog.jpg',\n      tldr:              data.tldr,\n      faqItems:          data.faqItems,\n      showInspoGalleryLink,\n    };\n\n    blogCache.set(cacheKey, post);\n    return post;\n  } catch (error) {\n    console.error(`Error reading blog post ${slug}:`, error);\n    return null;\n  }\n}\n\nexport async function getAllBlogSlugs(): Promise<string[]> {\n  try {\n    return getAllBlogFilesRecursive(BLOG_DIRECTORY).map(f => path.basename(fileToSlug(f)));\n  } catch (error) {\n    console.error('Error reading blog slugs:', error);\n    return [];\n  }\n}\n\nexport async function getPostsByCategory(categorySlug: string): Promise<BlogMetadata[]> {\n  const allPosts = await getAllBlogPosts();\n  return allPosts.filter(post => post.category === categorySlug);\n}\n\nexport async function getAllCategories() {\n  return [\n    { name: 'Seasonal',        slug: 'seasonal' },\n    { name: 'Trends',          slug: 'trends' },\n    { name: 'Tutorial',        slug: 'tutorial' },\n    { name: 'Nail Care',       slug: 'nail care' },\n    { name: 'Nail Art',        slug: 'nail art' },\n    { name: \"Editor's Choice\", slug: \"editor's choice\" },\n  ];\n}\n\n/**\n * UPDATED getRelatedPosts  priority order:\n *   1. Cluster siblings   other posts sharing the same pillar\n *      (if current post IS the pillar, its own cluster children;\n *       if current post is a cluster post, its sibling cluster posts)\n *   2. Same topic          posts with the same `topic` field, not already included\n *   3. Fallback            most recent posts, not already included\n *\n * Capped at `limit` (default 12), no duplicates.\n */\nexport async function getRelatedPosts(\n  currentSlug: string,\n  limit: number = 12\n): Promise<BlogMetadata[]> {\n  const currentPost = await getBlogPost(currentSlug);\n  if (!currentPost) return [];\n\n  const allPosts = await getAllBlogPosts();\n  const seen = new Set<string>([currentSlug]);\n  const result: BlogMetadata[] = [];\n\n  let pillarKey: string | null = null;\n  if (currentPost.topicalMap?.position === 'pillar') {\n    pillarKey = currentPost.slug;\n  } else if (currentPost.topicalMap?.position === 'cluster' && currentPost.topicalMap?.parentPillar) {\n    pillarKey = currentPost.topicalMap.parentPillar;\n  }\n\n  function matchesPillar(post: BlogMetadata, key: string): boolean {\n    return (\n      post.topicalMap?.parentPillar === key ||\n      post.topicalMap?.parentPillar === `/blog/${key}` ||\n      post.slug === key\n    );\n  }\n\n  // ── 1. Cluster siblings ──────────────────────────────────────────────\n  if (pillarKey) {\n    const siblings = allPosts.filter(\n      post => !seen.has(post.slug) && matchesPillar(post, pillarKey!)\n    );\n    for (const post of siblings) {\n      if (result.length >= limit) break;\n      result.push(post);\n      seen.add(post.slug);\n    }\n  }\n\n  // ── 2. Same topic ─────────────────────────────────────────────────────\n  if (result.length < limit && currentPost.topic) {\n    const sameTopic = allPosts.filter(\n      post => !seen.has(post.slug) && post.topic === currentPost.topic\n    );\n    for (const post of sameTopic) {\n      if (result.length >= limit) break;\n      result.push(post);\n      seen.add(post.slug);\n    }\n  }\n\n  // ── 3. Fallback: most recent posts ──────────────────────────────────\n  if (result.length < limit) {\n    const remaining = allPosts.filter(post => !seen.has(post.slug));\n    for (const post of remaining) {\n      if (result.length >= limit) break;\n      result.push(post);\n      seen.add(post.slug);\n    }\n  }\n\n  return result;\n}\n\nexport async function getPaginatedPosts(\n  page: number = 1,\n  perPage: number = 12\n): Promise<{\n  posts: BlogMetadata[];\n  totalPages: number;\n  currentPage: number;\n  totalPosts: number;\n}> {\n  const allPosts   = await getAllBlogPosts();\n  const totalPosts = allPosts.length;\n  const totalPages = Math.ceil(totalPosts / perPage);\n  const startIndex = (page - 1) * perPage;\n  const posts      = allPosts.slice(startIndex, startIndex + perPage);\n\n  return { posts, totalPages, currentPage: page, totalPosts };\n}\n\nexport interface ClusterGroup {\n  pillar:   BlogMetadata;\n  clusters: BlogMetadata[];\n}\n\nexport async function getAllClusters(): Promise<ClusterGroup[]> {\n  const cacheKey = 'all-clusters';\n\n  const cached = blogCache.get<ClusterGroup[]>(cacheKey);\n  if (cached) return cached;\n\n  const allPosts    = await getAllBlogPosts();\n  const pillarPosts = allPosts.filter(post => post.topicalMap?.position === 'pillar');\n\n  const clusterGroups: ClusterGroup[] = pillarPosts.map(pillar => {\n    const clusterPosts = allPosts.filter(post =>\n      post.topicalMap?.position === 'cluster' &&\n      (\n        post.topicalMap?.parentPillar === `/blog/${pillar.slug}` ||\n        post.topicalMap?.parentPillar === pillar.slug\n      )\n    );\n    return { pillar, clusters: clusterPosts };\n  });\n\n  blogCache.set(cacheKey, clusterGroups);\n  return clusterGroups;\n}\n\nexport async function getStandalonePosts(): Promise<BlogMetadata[]> {\n  const cacheKey = 'standalone-posts';\n\n  const cached = blogCache.get<BlogMetadata[]>(cacheKey);\n  if (cached) return cached;\n\n  const allPosts   = await getAllBlogPosts();\n  const standalone = allPosts.filter(post =>\n    !post.topicalMap?.position ||\n    (post.topicalMap.position !== 'pillar' && post.topicalMap.position !== 'cluster')\n  );\n\n  blogCache.set(cacheKey, standalone);\n  return standalone;\n}\n\nexport function clearBlogCache() {\n  blogCache.clear();\n}\n\nexport async function getPillarClusterPosts(\n  pillarSlug: string\n): Promise<{ pillar: BlogMetadata; clusters: BlogMetadata[] } | null> {\n  const cacheKey = `pillar-clusters:${pillarSlug}`;\n  const cached = blogCache.get<{ pillar: BlogMetadata; clusters: BlogMetadata[] }>(cacheKey);\n  if (cached) return cached;\n\n  const allPosts = await getAllBlogPosts();\n\n  const pillar = allPosts.find(post => post.slug === pillarSlug);\n  if (!pillar) return null;\n\n  const clusters = allPosts.filter(post =>\n    post.topicalMap?.position === 'cluster' &&\n    (\n      post.topicalMap?.parentPillar === `/blog/${pillarSlug}` ||\n      post.topicalMap?.parentPillar === pillarSlug\n    )\n  );\n\n  const result = { pillar, clusters };\n  blogCache.set(cacheKey, result);\n  return result;\n}\n\n/**\n * Extracts all body <img> src URLs from compiled post HTML, excluding\n * the hero/cover image (post.image). Used to power the \"Download images\"\n * button  which should only appear when the post body itself has images.\n */\nexport function extractBodyImages(html: string, heroImage?: string | null): string[] {\n  if (!html) return [];\n  const matches = [...html.matchAll(/<img[^>]*src=[\"']([^\"']+)[\"']/gi)];\n  const urls = matches.map((m) => m[1]);\n  return heroImage ? urls.filter((u) => u !== heroImage) : urls;\n}"

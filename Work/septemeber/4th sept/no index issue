rt default function RootLayout({ children }: { children: React.ReactNode }) {\n  // Build schema graph  all entities in one JSON-LD block\n  const schemaGraph = {\n    '@context': 'https://schema.org',\n    '@graph': [\n      generateOrganizationSchema(),\n      generateWebsiteSchema(),\n      generateJyotiSchema(),\n      generateRiSchema(),\n    ],\n  };\n\n  return (\n    <html lang=\"en-US\">\n      <head>\n        {/* Performance: preconnect for critical third-party origins */}\n        <link rel=\"preconnect\" href=\"https://scripts.scriptwrapper.com\" />\n        <link rel=\"preconnect\" href=\"https://res.cloudinary.com\" crossOrigin=\"anonymous\" />\n        <link rel=\"dns-prefetch\" href=\"https://www.googletagmanager.com\" />\n        <link rel=\"dns-prefetch\" href=\"https://res.cloudinary.com\" />\n\n      </head>\n\n      <body className=\"antialiased\" suppressHydrationWarning>\n        {/* Google Tag Manager (noscript fallback) */}\n        <noscript>\n          <iframe\n            src=\"https://www.googletagmanager.com/ns.html?id=GTM-WPW9XBW8\"\n            height=\"0\"\n            width=\"0\"\n            style={{ display: 'none', visibility: 'hidden' }}\n            title=\"Google Tag Manager\"\n          />\n        </noscript>\n\n        {/* Google Tag Manager */}\n        <Script id=\"gtm-init\" strategy=\"afterInteractive\">\n          {`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\n          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\n          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n          })(window,document,'script','dataLayer','GTM-WPW9XBW8');`}\n        </Script>\n\n        {/* GA4 */}\n        <Script\n          src=\"https://www.googletagmanager.com/gtag/js?id=G-4BZ9QKQZ73\"\n          strategy=\"afterInteractive\"\n        />\n        <Script id=\"ga4-init\" strategy=\"afterInteractive\">\n          {`window.dataLayer = window.dataLayer || [];\n          function gtag(){dataLayer.push(arguments);}\n          gtag('js', new Date());\n          gtag('config', 'G-4BZ9QKQZ73', { page_path: window.location.pathname, send_page_view: true });`}\n        </Script>\n\n        {/* Core Web Vitals tracking */}\n        <Script id=\"web-vitals\" strategy=\"afterInteractive\">\n          {`(function(){\n            function send(m){if(window.gtag)window.gtag('event',m.name,{value:Math.round(m.name==='CLS'?m.value*1000:m.value),event_category:'Web Vitals',event_label:m.id,non_interaction:true});}\n            if('PerformanceObserver' in window){\n              try{const o=new PerformanceObserver(l=>{const e=l.getEntries(),last=e[e.length-1];send({name:'LCP',value:last.renderTime||last.loadTime,id:'v1-'+Date.now()});});o.observe({entryTypes:['largest-contentful-paint']});}catch(e){}\n              try{const o=new PerformanceObserver(l=>{l.getEntries().forEach(e=>{send({name:'INP',value:e.duration,id:'v1-'+Date.now()});});});o.observe({type:'event',buffered:true,durationThreshold:40});}catch(e){}\n              try{let v=0;const o=new PerformanceObserver(l=>{l.getEntries().forEach(e=>{if(!e.hadRecentInput)v+=e.value;});});o.observe({entryTypes:['layout-shift']});addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden')send({name:'CLS',value:v,id:'v1-'+Date.now()});});}catch(e){}\n            }\n          })();`}\n        </Script>\n\n        {/* Structured Data  full entity graph */}\n        <script\n          type=\"application/ld+json\"\n          dangerouslySetInnerHTML={{ __html: JSON.stringify(schemaGraph) }}\n        />\n\n        <Header />\n\n        <div className=\"w-full max-w-[1600px] mx-auto\">\n          <main className=\"min-h-screen\" id=\"main-content\" role=\"main\">\n            {children}\n          </main>\n        </div>\n\n        <Footer />\n        <ExitIntentPopup />\n        <StickySlideIn
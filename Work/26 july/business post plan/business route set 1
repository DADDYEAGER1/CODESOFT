      "path": "src/types/business.ts",
      "content": "// src/types/business.ts\n\nexport interface BusinessFAQ {\n  question: string;\n  answer: string;\n}\n\nexport interface BusinessService {\n  title: string;\n  description: string;\n}\n\nexport interface BusinessContact {\n  email: string;\n  whatsapp?: string;\n  instagram?: string;\n}\n\nexport interface BusinessGalleryImage {\n  url: string;\n  alt: string;\n  width?: number;\n  height?: number;\n}\n\nexport interface BusinessMetadata {\n  /** Required in frontmatter — source of truth for the URL, not the filename.\n   *  No region/country/state/city/clientType fields — this route is flat,\n   *  a single business page per slug with no geography or audience segmentation. */\n  slug: string;\n  title: string;\n  excerpt: string;\n  date: string;\n  dateModified?: string;\n  author: string;\n\n  // SEO\n  canonical: string;\n  targetKeyword: string;\n  secondaryKeywords?: string[];\n  searchIntent?: 'informational' | 'transactional' | 'navigational' | 'commercial';\n  noIndex?: boolean;\n\n  // GEO/AEO\n  tldr: string;\n  entityType?: string;\n  speakable?: boolean;\n\n  // Contact\n  contact: BusinessContact;\n\n  // Services\n  services: BusinessService[];\n\n  // Schema\n  schemaType?: 'ProfessionalService' | 'LocalBusiness' | 'Organization';\n\n  // Display\n  template?: 'business';\n\n  postType?: 'client-acquisition' | 'deliverable';\n  painPoint?: string;\n  statBlock?: { stat: string; context: string }[];\n\n  url: string;\n}\n\nexport interface BusinessPost extends BusinessMetadata {\n  content: string;\n  isMDX?: boolean;\n  faqSchema: BusinessFAQ[];\n  galleryImages?: BusinessGalleryImage[];\n}"

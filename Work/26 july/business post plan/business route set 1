      "content": "// src/app/business/[slug]/page.tsx\nimport { notFound } from 'next/navigation';\nimport { Metadata } from 'next';\nimport { serialize } from 'next-mdx-remote/serialize';\nimport { getBusinessPost, getAllBusinessSlugs } from '@/lib/business';\nimport { getAuthor } from '@/lib/authors';\nimport BusinessTemplate from '@/components/business/BusinessTemplate';\n\nexport const revalidate = false;\n\n// ─── Static Params ────────────────────────────────────────────────────────────\n\nexport async function generateStaticParams() {\n  const slugs = await getAllBusinessSlugs();\n  return slugs.map((slug) => ({ slug }));\n}\n\n// ─── Metadata ─────────────────────────────────────────────────────────────────\n\nexport async function generateMetadata({\n  params,\n}: {\n  params: Promise<{ slug: string }>;\n}): Promise<Metadata> {\n  const { slug } = await params;\n  const post = await getBusinessPost(slug);\n\n  if (!post) {\n    return {\n      title: 'Page Not Found',\n      robots: { index: false, follow: false },\n    };\n  }\n\n  const canonicalUrl = post.canonical || `https://mirelleinspo.com/business/${slug}`;\n\n  return {\n    title: post.title,\n    description: post.excerpt || `${post.title} — Mirellé Inspo.`,\n    authors: [{ name: post.author || 'Gaurav Verma', url: 'https://mirelleinspo.com/authors/ri-mirelle' }],\n    creator: post.author || 'Gaurav Verma',\n    alternates: { canonical: canonicalUrl },\n    openGraph: {\n      title: post.title,\n      description: post.excerpt || `${post.title} — Mirellé Inspo.`,\n      url: canonicalUrl,\n      siteName: 'Mirellé Inspo',\n      type: 'article',\n      locale: 'en_US',\n      images: [{ url: '/logo.png', width: 250, height: 60, alt: `${post.title} — Mirellé Inspo` }],\n    },\n    twitter: {\n      card: 'summary_large_image',\n      title: post.title,\n      description: post.excerpt || `${post.title} — Mirellé Inspo.`,\n      creator: '@mirelleinspo',\n      site: '@mirelleinspo',\n      images: ['/logo.png'],\n    },\n    robots: post.noIndex\n      ? { index: false, follow: false }\n      : {\n          index: true,\n          follow: true,\n          googleBot: { index: true, follow: true, 'max-image-preview': 'large', 'max-snippet': -1 },\n        },\n  };\n}\n\n// ─── JSON-LD ──────────────────────────────────────────────────────────────────\n\nfunction generateSchemas(post: NonNullable<Awaited<ReturnType<typeof getBusinessPost>>>) {\n  const schemas = [];\n\n  schemas.push({\n    '@context': 'https://schema.org',\n    '@type': post.schemaType || 'ProfessionalService',\n    '@id': post.canonical,\n    name: 'Mirellé',\n    description: post.excerpt,\n    url: post.canonical,\n    logo: 'https://mirelleinspo.com/images/logo.png',\n    sameAs: ['https://instagram.com/mirelleinspo', 'https://pinterest.com/mirelleinspo'],\n    hasOfferCatalog: {\n      '@type': 'OfferCatalog',\n      name: 'Nail Editorial Services',\n      itemListElement: post.services.map((s) => ({\n        '@type': 'Offer',\n        itemOffered: { '@type': 'Service', name: s.title, description: s.description },\n      })),\n    },\n    contactPoint: { '@type': 'ContactPoint', email: post.contact.email, contactType: 'customer service' },\n    author: {\n      '@type': 'Person',\n      name: post.author || 'Mirellé',\n      url: `https://mirelleinspo.com/authors/${post.author}`,\n    },\n  });\n\n  if (post.faqSchema.length > 0) {\n    schemas.push({\n      '@context': 'https://schema.org',\n      '@type': 'FAQPage',\n      mainEntity: post.faqSchema.map((faq) => ({\n        '@type': 'Question',\n        name: faq.question,\n        acceptedAnswer: { '@type': 'Answer', text: faq.answer },\n      })),\n    });\n  }\n\n  schemas.push({\n    '@context': 'https://schema.org',\n    '@type': 'BreadcrumbList',\n    itemListElement: [\n      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mirelleinspo.com' },\n      { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://mirelleinspo.com/business' },\n      { '@type': 'ListItem', position: 3, name: post.title, item: post.canonical },\n    ],\n  });\n\n  if (post.speakable) {\n    schemas.push({\n      '@context': 'https://schema.org',\n      '@type': 'WebPage',\n      name: post.title,\n      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.business-tldr', '.business-about'] },\n      url: post.canonical,\n    });\n  }\n\n  return schemas;\n}\n\n// ─── Page ─────────────────────────────────────────────────────────────────────\n\nexport default async function BusinessSlugPage({\n  params,\n}: {\n  params: Promise<{ slug: string }>;\n}) {\n  const { slug } = await params;\n\n  const post = await getBusinessPost(slug);\n  if (!post) notFound();\n\n  const schemas = generateSchemas(post);\n  const mdxSource = post.isMDX ? await serialize(post.content) : undefined;\n  const author = post.author ? getAuthor(post.author) : null;\n\n  return (\n    <>\n      {schemas.map((schema, i) => (\n        <script key={i} type=\"application/ld+json\" dangerouslySetInnerHTML={{ __html: JSON.stringify(schema) }} />\n      ))}\n      <BusinessTemplate post={post} mdxSource={mdxSource} author={author ?? undefined} />\n    </>\n  );\n}"
